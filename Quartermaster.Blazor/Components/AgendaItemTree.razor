@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Meetings
@using Quartermaster.Blazor.Components.Inputs

@if (FlatItems.Count == 0) {
    <p class="text-secondary">@I18n[I18nKey.Ui.AgendaItemEditor.EmptyMessage]</p>
}

@foreach (var entry in FlatItems) {
    var item = entry.Item;
    var isEditing = EditingItemId == item.Id;
    var isActive = ActiveItemId == item.Id;
    var rowClass = Mode == AgendaTreeMode.MinuteTaking ? GetProgressRowClass(item, isActive) : "";

    <div class="d-flex align-items-start py-2 border-bottom @rowClass" style="padding-left: @(entry.Depth * 2)rem;">
        @if (Mode == AgendaTreeMode.MinuteTaking) {
            <div class="me-2" style="min-width: 28px;">
                @if (item.CompletedAt != null) {
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                } else if (item.StartedAt != null) {
                    <i class="bi bi-play-circle-fill text-warning fs-5"></i>
                } else {
                    <i class="bi bi-circle text-secondary fs-5"></i>
                }
            </div>
        }

        <div class="me-2 text-secondary small" style="min-width: 3em;">@entry.Number</div>

        <div class="flex-grow-1">
            @if (isEditing) {
                <div class="input-group input-group-sm mb-1">
                    <input type="text" class="form-control"
                           @bind="EditingTitle" @bind:event="oninput"
                           placeholder="@I18n[I18nKey.Ui.AgendaItemEditor.TitlePlaceholder]" />
                    <select class="form-select" style="max-width: 160px;" @bind="EditingItemType">
                        <option value="0">@I18n[I18nKey.Ui.AgendaItemType.Discussion]</option>
                        <option value="1">@I18n[I18nKey.Ui.AgendaItemType.Motion]</option>
                        <option value="2">@I18n[I18nKey.Ui.AgendaItemType.Protocol]</option>
                        <option value="3">@I18n[I18nKey.Ui.AgendaItemType.Break]</option>
                        <option value="4">@I18n[I18nKey.Ui.AgendaItemType.Information]</option>
                        <option value="5">@I18n[I18nKey.Ui.AgendaItemType.Section]</option>
                        <option value="6">@I18n[I18nKey.Ui.AgendaItemType.Presence]</option>
                    </select>
                    <button class="btn btn-outline-primary" aria-label="@I18n[I18nKey.Ui.AgendaItemEditor.SaveAria]" @onclick="() => SaveEdit(item)">
                        <i class="bi bi-check-lg"></i>
                    </button>
                    <button class="btn btn-outline-secondary" aria-label="@I18n[I18nKey.Ui.AgendaItemEditor.CancelAria]" @onclick="CancelEdit">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                @if (EditingItemType == (int)AgendaItemType.Motion) {
                    <div class="mb-1">
                        <MotionPicker Value="@EditingMotionId" ValueChanged="OnEditingMotionChanged"
                                      InitialTitle="@item.MotionTitle" ChapterId="@ChapterId" />
                    </div>
                }
            } else {
                @if (Mode == AgendaTreeMode.MinuteTaking) {
                    <button class="btn btn-link text-start text-decoration-none p-0 fw-semibold @(item.CompletedAt != null ? "text-muted" : "")"
                            @onclick="() => OnSelectActive.InvokeAsync(item.Id)">
                        @item.Title
                    </button>
                } else {
                    <span class="fw-semibold">@item.Title</span>
                }
                <span class="badge border @TypeBadgeClass(item.ItemType) ms-2">@TypeLabel(item.ItemType)</span>
                @if (item.ItemType == AgendaItemType.Motion && !string.IsNullOrEmpty(item.MotionTitle)) {
                    <span class="text-secondary small ms-2">→ @item.MotionTitle</span>
                }
            }
        </div>

        @if (Mode == AgendaTreeMode.Editor && !isEditing) {
            <div class="d-flex gap-1 ms-2" style="flex-shrink: 0;">
                @if (item.ItemType == AgendaItemType.Section) {
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OnImportMotions.InvokeAsync(item.Id)"
                            title="@I18n[I18nKey.Ui.AgendaItemEditor.ImportMotionsTooltip]" aria-label="@I18n[I18nKey.Ui.AgendaItemEditor.ImportMotionsTooltip]">
                        <i class="bi bi-download"></i>
                    </button>
                }
                <div class="input-group input-group-sm" style="width: auto;">
                    <button class="btn btn-outline-secondary" @onclick="() => OnAddChild.InvokeAsync(item.Id)"
                            title="@I18n[I18nKey.Ui.AgendaItemEditor.AddChildTooltip]" aria-label="@I18n[I18nKey.Ui.AgendaItemEditor.AddChildTooltip]">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="() => OnOutdent.InvokeAsync(item.Id)"
                            title="@I18n[I18nKey.Ui.AgendaItemEditor.OutdentTooltip]" aria-label="@I18n[I18nKey.Ui.AgendaItemEditor.OutdentTooltip]">
                        <i class="bi bi-chevron-bar-left"></i>
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="() => OnIndent.InvokeAsync(item.Id)"
                            title="@I18n[I18nKey.Ui.AgendaItemEditor.IndentTooltip]" aria-label="@I18n[I18nKey.Ui.AgendaItemEditor.IndentTooltip]">
                        <i class="bi bi-chevron-bar-right"></i>
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="() => OnReorder.InvokeAsync((item.Id, -1))"
                            title="@I18n[I18nKey.Ui.AgendaItemEditor.MoveUpTooltip]" aria-label="@I18n[I18nKey.Ui.AgendaItemEditor.MoveUpTooltip]">
                        <i class="bi bi-chevron-up"></i>
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="() => OnReorder.InvokeAsync((item.Id, 1))"
                            title="@I18n[I18nKey.Ui.AgendaItemEditor.MoveDownTooltip]" aria-label="@I18n[I18nKey.Ui.AgendaItemEditor.MoveDownTooltip]">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="() => StartEdit(item)"
                            title="@I18n[I18nKey.Ui.AgendaItemEditor.EditTooltip]" aria-label="@I18n[I18nKey.Ui.AgendaItemEditor.EditTooltip]">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-outline-danger" @onclick="() => OnDelete.InvokeAsync(item.Id)"
                            title="@I18n[I18nKey.Ui.AgendaItemEditor.DeleteTooltip]" aria-label="@I18n[I18nKey.Ui.AgendaItemEditor.DeleteTooltip]">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}
