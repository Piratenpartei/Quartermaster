@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Services
@inherits ErrorBoundary
@inject ClientConfigService ConfigService
@inject I18nService I18n

@if (CurrentException != null) {
    <div class="container mt-4">
        <div class="alert alert-danger">
            <h4><i class="bi bi-exclamation-triangle"></i> @I18n[I18nKey.Ui.AppErrorBoundary.Heading]</h4>
            <p>@I18n[I18nKey.Ui.AppErrorBoundary.Description]</p>
            @if (!string.IsNullOrEmpty(ConfigService.ErrorContact)) {
                <p class="mb-2">@ConfigService.ErrorContact</p>
            }
            <button class="btn btn-outline-danger" @onclick="Recover">
                <i class="bi bi-arrow-clockwise"></i> @I18n[I18nKey.Ui.AppErrorBoundary.RecoverButton]
            </button>
        </div>
    </div>
} else {
    @ChildContent
}
