@using Quartermaster.Api.AssemblyAssistant
@using Quartermaster.Api.I18n

<div class="card">
    <div class="card-header assembly-card-header">
        <span>@I18n[I18nKey.Ui.AssemblyConsole.PollsTitle]</span>
        @if (State != "Disabled") {
            <span class="d-inline-flex align-items-center gap-2 small fw-normal">
                <span class="assembly-dot @(State == "Connected" ? "bg-success" : "bg-warning")"></span>
                OpenSlides: @I18n[StateKey()]
            </span>
        }
    </div>
    @if (State == "Disabled") {
        <div class="card-body small text-secondary">@I18n[I18nKey.Ui.AssemblyConsole.OpenSlidesDisabled]</div>
    } else {
        @if (CanControl) {
            <div class="card-body border-bottom d-flex flex-wrap align-items-center gap-3 py-2">
                <div class="input-group input-group-sm w-auto">
                    <span class="input-group-text">@I18n[I18nKey.Ui.AssemblyConsole.PollDuration]</span>
                    <input type="number" class="form-control" style="width: 5rem;" min="10" max="3600" value="@Settings.DurationSeconds"
                           @onchange="e => ChangeDuration(e.Value?.ToString())" />
                </div>
                <span class="small text-secondary">@I18n[I18nKey.Ui.AssemblyConsole.AutoLabel]</span>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="poll-auto-start" checked="@Settings.AutoStart"
                           @onchange="e => Change(autoStart: (bool)e.Value!)" />
                    <label class="form-check-label small" for="poll-auto-start">@I18n[I18nKey.Ui.AssemblyConsole.AutoStart]</label>
                </div>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="poll-auto-stop" checked="@Settings.AutoStop"
                           @onchange="e => Change(autoStop: (bool)e.Value!)" />
                    <label class="form-check-label small" for="poll-auto-stop">@I18n[I18nKey.Ui.AssemblyConsole.AutoStop]</label>
                </div>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="poll-auto-publish" checked="@Settings.AutoPublish"
                           @onchange="e => Change(autoPublish: (bool)e.Value!)" />
                    <label class="form-check-label small" for="poll-auto-publish">@I18n[I18nKey.Ui.AssemblyConsole.AutoPublish]</label>
                </div>
                @if (ProjectorConfigured) {
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="poll-project" checked="@Settings.Project"
                               @onchange="e => Change(project: (bool)e.Value!)" />
                        <label class="form-check-label small" for="poll-project">@I18n[I18nKey.Ui.AssemblyConsole.ProjectPolls]</label>
                    </div>
                }
            </div>
            <div class="card-body border-bottom py-2">
                <div class="assembly-label">@I18n[I18nKey.Ui.AssemblyConsole.TemplatesTitle]</div>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <input type="text" class="form-control form-control-sm flex-grow-1" style="min-width: 12rem; width: auto;"
                           placeholder="@I18n[I18nKey.Ui.AssemblyConsole.TemplateText]" @bind="TemplateText" />
                    <div class="input-group input-group-sm w-auto">
                        <input type="number" class="form-control" style="width: 4.5rem;" min="1" @bind="Threshold" />
                        <span class="input-group-text">@I18n[I18nKey.Ui.AssemblyConsole.SupportThreshold]</span>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var template in Templates()) {
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Create(template)">@I18n[TemplateKey(template)]</button>
                    }
                </div>
                @if (CurrentIsMotion || ItemKind == AssemblyItemKind.Other) {
                    <button type="button" class="btn btn-link btn-sm px-0 mt-1" @onclick="() => OnCreateProceduralTopics.InvokeAsync()">
                        @I18n[I18nKey.Ui.AssemblyConsole.CreateProceduralTopics]
                    </button>
                }
            </div>
        }
        @if (Polls.Count == 0) {
            <div class="card-body small text-secondary">@I18n[I18nKey.Ui.AssemblyConsole.NoPolls]</div>
        }
        <ul class="list-group list-group-flush">
            @foreach (var poll in Polls) {
                <li class="list-group-item p-3">
                    @if (poll.State == "started") {
                        var remaining = poll.EndsAt == null ? (TimeSpan?)null : poll.EndsAt.Value - ServerNow;
                        <div class="d-flex align-items-start justify-content-between gap-3">
                            <div class="assembly-shrink">
                                <div class="fw-semibold text-truncate" title="@poll.Title">@poll.Title</div>
                                <div class="small text-secondary">@I18n[I18nParams.With(I18nKey.Ui.AssemblyConsole.VotesSoFar, ("count", poll.LiveVoteCount.ToString()))]</div>
                            </div>
                            <div class="assembly-timer @AssemblyDisplay.TimerClass(remaining)">
                                @(remaining == null ? "-" : AssemblyDisplay.FormatRemaining(remaining.Value))
                            </div>
                        </div>
                        @if (CanControl) {
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OnExtend.InvokeAsync(30)">
                                    @I18n[I18nKey.Ui.AssemblyConsole.ExtendPoll]
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => OnStop.InvokeAsync(poll.Id)">
                                    <i class="bi bi-stop-fill me-1"></i>@I18n[I18nKey.Ui.AssemblyConsole.StopPoll]
                                </button>
                            </div>
                        }
                    } else if (poll.State == "created") {
                        <div class="fw-semibold text-truncate" title="@poll.Title">@poll.Title</div>
                        <div class="small text-secondary">@I18n[I18nKey.Ui.AssemblyConsole.PollNotStarted]</div>
                    } else {
                        <div class="d-flex align-items-baseline justify-content-between gap-2">
                            <span class="fw-semibold text-truncate" title="@poll.Title">@poll.Title</span>
                            <span class="assembly-flag bg-secondary-subtle text-secondary-emphasis border-secondary-subtle flex-shrink-0">
                                @I18n[poll.State == "published" ? I18nKey.Ui.AssemblyConsole.PollStatePublished : I18nKey.Ui.AssemblyConsole.PollStateFinished]
                            </span>
                        </div>
                        @if (poll.ResultKey != null) {
                            <div class="@ResultClass(poll.Passed) fw-semibold mt-1">@I18n[poll.ResultKey]</div>
                        }
                        @if (CanControl && poll.State == "finished") {
                            <button type="button" class="btn btn-primary btn-sm mt-2" @onclick="() => OnPublish.InvokeAsync(poll.Id)">
                                @I18n[I18nKey.Ui.AssemblyConsole.PublishPoll]
                            </button>
                        }
                    }
                    @if (CanControl && poll.CreatedHere) {
                        <div class="d-flex gap-2 mt-2">
                            <button type="button" class="btn btn-link btn-sm text-secondary px-0" @onclick="() => Reset(poll.Id)">@I18n[I18nKey.Ui.AssemblyConsole.ResetPoll]</button>
                            <button type="button" class="btn btn-link btn-sm text-danger px-0" @onclick="() => Delete(poll.Id)">@I18n[I18nKey.Ui.AssemblyConsole.DeletePoll]</button>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</div>

<ConfirmDialog @ref="ResetDialog" Message="@I18n[I18nKey.Ui.AssemblyConsole.ResetConfirm]" />
<ConfirmDialog @ref="DeleteDialog" Message="@I18n[I18nKey.Ui.AssemblyConsole.DeleteConfirm]" />
