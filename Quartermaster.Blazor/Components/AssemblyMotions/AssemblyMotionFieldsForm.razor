@using Quartermaster.Api.AssemblyMotions
@using Quartermaster.Api.I18n
@using Quartermaster.Rendering

<div class="mb-3">
    <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldType] <RequiredStar /></label>
    <FormSelect Value="@Values.TypeId" ValueChanged="OnTypeChanged" Disabled="@TypeLocked">
        @foreach (var type in Portal.Types) {
            <option value="@type.Id">@type.Code - @type.Name</option>
        }
    </FormSelect>
    @if (SelectedType != null) {
        <div class="form-text">
            @I18n[I18nKey.Ui.AssemblyMotion.TypeDeadline] <strong><DeadlineText Value="@(SelectedType.Deadline ?? Portal.ClosesAt)" /></strong>
            @if (SelectedType.CompetingDeadline != null) {
                <span> (@I18n[I18nKey.Ui.AssemblyMotion.TypeCompetingDeadline] <strong><DeadlineText Value="@SelectedType.CompetingDeadline" /></strong>)</span>
            }
            <br />
            @I18n[I18nKey.Ui.AssemblyMotion.TypeMinSubmitters] <strong>@SelectedType.MinSubmitters</strong>,
            @AssemblyMotionDisplay.MajorityLabel(I18n, SelectedType.RequiredMajority)
        </div>
    }
</div>
<div class="mb-3">
    <label class="form-label">@I18n[I18nKey.Ui.Common.Title] <RequiredStar /></label>
    <FormInput @bind-Value="Values.Title" />
</div>
<div class="mb-3">
    <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldSection]</label>
    <FormInput @bind-Value="Values.Section" />
    <div class="form-text">@I18n[I18nKey.Ui.AssemblyMotion.SectionHelp]</div>
</div>
<div class="mb-3">
    <label for="motion-text" class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldText] <RequiredStar /></label>
    <MarkdownEditorWithPreview Id="motion-text" @bind-Value="Values.TextMarkdown" Rows="12" Flavor="MarkdownFlavor.Motion" />
    <div class="form-text">@I18n[I18nKey.Ui.AssemblyMotion.FormattingHelp]</div>
</div>
<div class="mb-3">
    <label for="motion-reason" class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldReason] <RequiredStar /></label>
    <MarkdownEditorWithPreview Id="motion-reason" @bind-Value="Values.ReasonMarkdown" Rows="10" Flavor="MarkdownFlavor.Motion" />
    <div class="form-text">@I18n[I18nKey.Ui.AssemblyMotion.FormattingHelp]</div>
</div>
<div class="mb-3">
    <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldSummary]</label>
    <FormInput @bind-Value="Values.Summary" />
</div>
<div class="mb-3">
    <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldKeywords]</label>
    <FormInput @bind-Value="Values.Keywords" />
    <div class="form-text">@I18n[I18nKey.Ui.AssemblyMotion.KeywordsHelp]</div>
</div>
<div class="mb-3">
    <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldPriorDiscussion]</label>
    <FormInput @bind-Value="Values.PriorDiscussion" />
</div>
