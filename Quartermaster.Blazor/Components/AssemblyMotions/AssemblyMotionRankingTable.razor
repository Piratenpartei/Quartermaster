@using Quartermaster.Api.AssemblyMotions
@using Quartermaster.Api.I18n

<ResponsiveList Items="@Items">
    <Header>
        <tr>
            <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnRank]</th>
            <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnNumber]</th>
            <th>@I18n[I18nKey.Ui.Common.Title]</th>
            <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnType]</th>
            <th class="text-end">@I18n[I18nKey.Ui.AssemblyMotion.ColumnUpvotes]</th>
        </tr>
    </Header>
    <Row Context="item">
        <tr @key="item.Id">
            <td>@item.Rank</td>
            <td class="text-nowrap">@(string.IsNullOrEmpty(item.DisplayNumber) ? "-" : item.DisplayNumber)</td>
            <td><a href="/AssemblyMotions/@item.Id">@item.Title</a></td>
            <td>@item.TypeCode</td>
            <td class="text-end">@item.UpvoteCount</td>
        </tr>
    </Row>
    <Stacked Context="item">
        <div class="d-flex gap-2">
            <span class="fw-semibold">@item.Rank.</span>
            <div>
                <a class="fw-semibold" href="/AssemblyMotions/@item.Id">@item.Title</a>
                <div class="small text-secondary">@(string.IsNullOrEmpty(item.DisplayNumber) ? "-" : item.DisplayNumber) · @item.TypeCode · <i class="bi bi-star-fill"></i> @item.UpvoteCount</div>
            </div>
        </div>
    </Stacked>
</ResponsiveList>
