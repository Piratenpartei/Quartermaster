@using Quartermaster.Api.I18n

@if (Submitters.Count > 0) {
    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.AssemblyMotion.Submitters]</h5>
            <ul class="mb-0">
                @foreach (var submitter in Submitters) {
                    <li>
                        @submitter.DisplayName
                        @if (submitter.MemberNumber != null) {
                            <span class="text-secondary ms-1">(@MemberNumberLabel(submitter.MemberNumber.Value))</span>
                        }
                        @if (submitter.IsAuthor) {
                            <span class="text-secondary ms-1">@I18n[I18nKey.Ui.AssemblyMotion.AuthorMarker]</span>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}
