@using Quartermaster.Api.I18n

@if (CanSubscribe || IsSubscribed) {
    @if (IsSubscribed) {
        <button type="button" class="btn btn-outline-secondary" @onclick="Unsubscribe" disabled="@Busy" title="@I18n[I18nKey.Ui.AssemblyMotionSubscription.UnsubscribeTooltip]">
            @if (Busy) {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            } else {
                <i class="bi bi-bell-fill me-1"></i>
            }
            @I18n[I18nKey.Ui.AssemblyMotionSubscription.Subscribed]
        </button>
    } else {
        <button type="button" class="btn btn-outline-secondary" @onclick="Subscribe" disabled="@Busy" title="@I18n[I18nKey.Ui.AssemblyMotionSubscription.Hint]">
            @if (Busy) {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            } else {
                <i class="bi bi-bell me-1"></i>
            }
            @I18n[I18nKey.Ui.AssemblyMotionSubscription.Subscribe]
        </button>
    }
}
