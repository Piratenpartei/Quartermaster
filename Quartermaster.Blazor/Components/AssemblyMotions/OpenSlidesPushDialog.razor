@using Quartermaster.Api.I18n

@if (IsVisible) {
    <div class="modal show d-block bg-black bg-opacity-50" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@I18n[I18nKey.Ui.AssemblyMotion.OpenSlidesPushTitle]</h5>
                </div>
                <div class="modal-body">
                    <p>@I18n[I18nKey.Ui.AssemblyMotion.OpenSlidesPushMessage]</p>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="openSlidesIncludeSubmitted" @bind="IncludeSubmitted" />
                        <label class="form-check-label" for="openSlidesIncludeSubmitted">@I18n[I18nKey.Ui.AssemblyMotion.OpenSlidesIncludeSubmitted]</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="Cancel">@I18n[I18nKey.Ui.Common.Cancel]</button>
                    <button class="btn btn-primary" @onclick="Confirm">@I18n[I18nKey.Ui.AssemblyMotion.OpenSlidesPush]</button>
                </div>
            </div>
        </div>
    </div>
}
