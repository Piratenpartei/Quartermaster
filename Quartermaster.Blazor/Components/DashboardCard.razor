@using Quartermaster.Api.I18n
@inject I18nService I18n

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            @if (!string.IsNullOrEmpty(Icon)) {
                <i class="bi @Icon me-2"></i>
            }
            @Title
            @if (TotalCount.HasValue) {
                <StatusBadge Tone="StatusTone.Neutral" Text="@(TotalCount.Value.ToString())" Class="ms-2" />
            }
        </h5>
        <a href="@AllUrl" class="btn btn-sm btn-outline-secondary">@I18n[I18nKey.Ui.DashboardCard.ShowAll]</a>
    </div>
    @ChildContent
</div>
