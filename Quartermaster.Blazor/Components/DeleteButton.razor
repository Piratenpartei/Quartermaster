@using Quartermaster.Api.I18n
@inject I18nService I18n

<button type="button"
        class="btn @(Small ? "btn-sm " : "")btn-outline-danger @CssClass"
        aria-label="@ResolvedAriaLabel"
        disabled="@Disabled"
        @onclick="OnClick">
    <i class="bi bi-trash"></i>@(string.IsNullOrEmpty(ResolvedText) ? "" : " " + ResolvedText)
</button>
