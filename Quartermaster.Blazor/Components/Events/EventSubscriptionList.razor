@using Quartermaster.Api.I18n

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3">
            <i class="bi bi-bell me-1"></i>
            @I18n[I18nKey.Ui.EventSubscription.ListTitle]
        </h5>
        @if (Items == null) {
            <LoadingSpinner />
        } else if (Items.Count == 0) {
            <p class="text-secondary mb-0">@I18n[I18nKey.Ui.EventSubscription.ListEmpty]</p>
        } else {
            <ul class="list-group list-group-flush">
                @foreach (var item in Items) {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2 px-0">
                        <div>
                            @if (item.IsVisible) {
                                <a href="/Events/@item.EventId">@item.PublicName</a>
                            } else {
                                <span class="text-secondary">@I18n[I18nKey.Ui.EventSubscription.HiddenEvent]</span>
                            }
                            @if (item.EventDate.HasValue) {
                                <div class="text-secondary small"><EventDateText Date="item.EventDate" StartTime="item.StartTime" /></div>
                            }
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Unsubscribe(item)" disabled="@(BusyEventId == item.EventId)">
                            @I18n[I18nKey.Ui.EventSubscription.Unsubscribe]
                        </button>
                    </li>
                }
            </ul>
        }
    </div>
</div>
