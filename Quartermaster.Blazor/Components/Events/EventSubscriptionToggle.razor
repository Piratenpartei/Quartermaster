@using Quartermaster.Api.I18n

@if (State != null && (State.CanSubscribe || State.IsSubscribed)) {
    <div class="mb-3">
        @if (State.IsSubscribed) {
            <button type="button" class="btn btn-primary btn-sm btn-hover-scale1" @onclick="Unsubscribe" disabled="@Busy" title="@I18n[I18nKey.Ui.EventSubscription.UnsubscribeTooltip]">
                @if (Busy) {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                } else {
                    <i class="bi bi-bell-fill me-1"></i>
                }
                @I18n[I18nKey.Ui.EventSubscription.Subscribed]
            </button>
        } else {
            <button type="button" class="btn btn-outline-primary btn-sm btn-hover-scale1" @onclick="Subscribe" disabled="@Busy">
                @if (Busy) {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                } else {
                    <i class="bi bi-bell me-1"></i>
                }
                @I18n[I18nKey.Ui.EventSubscription.Subscribe]
            </button>
        }
        @if (State.CanSubscribe) {
            <div class="text-secondary small mt-1">@I18n[I18nKey.Ui.EventSubscription.Hint]</div>
        }
    </div>
}
