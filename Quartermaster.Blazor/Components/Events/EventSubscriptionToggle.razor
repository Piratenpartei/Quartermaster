@using Quartermaster.Api.I18n

@if (State != null && (State.CanSubscribe || State.IsSubscribed)) {
    @if (State.IsSubscribed) {
        <button type="button" class="btn btn-outline-secondary" @onclick="Unsubscribe" disabled="@Busy" title="@I18n[I18nKey.Ui.EventSubscription.UnsubscribeTooltip]">
            @if (Busy) {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            } else {
                <i class="bi bi-bell-fill me-1"></i>
            }
            @I18n[I18nKey.Ui.EventSubscription.Subscribed]
        </button>
    } else {
        <button type="button" class="btn btn-outline-secondary" @onclick="Subscribe" disabled="@Busy" title="@I18n[I18nKey.Ui.EventSubscription.Hint]">
            @if (Busy) {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            } else {
                <i class="bi bi-bell me-1"></i>
            }
            @I18n[I18nKey.Ui.EventSubscription.Subscribe]
        </button>
    }
}
