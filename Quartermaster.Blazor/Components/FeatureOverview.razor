@using Quartermaster.Api.I18n

<div class="card mb-3">
    <div class="card-body">
        <p>@I18n[I18nKey.Ui.Home.FeaturesIntro]</p>
        <ul>
            @if (ShowMembershipForms()) {
                <li>@I18n[I18nKey.Ui.Home.FeatureMembership]</li>
            }
            <li>@I18n[I18nKey.Ui.Home.FeatureMotions]</li>
            <li>@I18n[I18nKey.Ui.Home.FeatureMeetings]</li>
            <li>@I18n[I18nKey.Ui.Home.FeatureEvents]</li>
            <li>@I18n[I18nKey.Ui.Home.FeatureExpenses]</li>
            <li>@I18n[I18nKey.Ui.Home.FeatureMailings]</li>
            <li>@I18n[I18nKey.Ui.Home.FeatureSupportSignatures]</li>
            <li>@I18n[I18nKey.Ui.Home.FeatureDivisions]</li>
        </ul>
        <p class="mb-0">
            @I18n[I18nKey.Ui.Home.FeaturesForChapters]
            <a href="mailto:@SupportEmail">@SupportEmail</a>
        </p>
    </div>
</div>
