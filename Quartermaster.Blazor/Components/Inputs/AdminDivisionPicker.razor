@using Quartermaster.Api.I18n
@using Quartermaster.Api.AdministrativeDivisions
@inject I18nService I18n

<SearchDropdown TItem="AdministrativeDivisionDTO" Items="@(SearchResults ?? [])" OnSelect="SelectDivision"
                SearchText="@SearchText" SearchTextChanged="OnSearchInput" Placeholder="@I18n[I18nKey.Ui.AdminDivisionPicker.Placeholder]"
                InputClass="@SizeClass" InInputGroup="InInputGroup">
    <ItemTemplate Context="div">
        <span>@div.Name</span>
        @if (!string.IsNullOrEmpty(div.MatchedName)) {
            <span class="small text-secondary ms-1">(@I18n[I18nParams.With(I18nKey.Ui.AdminDivisionSearch.AlsoKnownAs, ("name", div.MatchedName))])</span>
        }
        @if (!string.IsNullOrEmpty(div.AdminCode)) {
            <code class="small text-secondary ms-1">@div.AdminCode</code>
        }
    </ItemTemplate>
</SearchDropdown>
