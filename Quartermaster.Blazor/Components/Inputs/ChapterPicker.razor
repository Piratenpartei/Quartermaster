@using Quartermaster.Api.I18n
@using Quartermaster.Api.Chapters

@if (Chapters == null) {
    <div class="spinner-border spinner-border-sm" role="status"></div>
} else if (VisibleChapters.Count <= 5) {
    <select class="form-select @SizeClass" value="@Value" @onchange="OnDropdownChanged">
        @if (AllowEmpty) {
            <option value="">@ResolvedEmptyLabel</option>
        }
        @foreach (var chapter in VisibleChapters) {
            <option value="@chapter.Id">@chapter.Name</option>
        }
    </select>
} else {
    <SearchDropdown TItem="ChapterDTO" Items="@ShownChapters" OnSelect="SelectChapter"
                    SearchText="@SearchText" SearchTextChanged="OnSearchInput"
                    Placeholder="@(Inline ? I18n[I18nKey.Ui.ChapterPicker.InlinePlaceholder] : I18n[I18nKey.Ui.ChapterPicker.SearchPlaceholder])"
                    InputClass="@SizeClass" InInputGroup="InInputGroup">
        <Prefix>
            @if (!Inline) {
                <span class="input-group-text"><i class="bi bi-search"></i></span>
            }
        </Prefix>
        <Suffix>
            @if (!Inline && !string.IsNullOrEmpty(Value)) {
                <button class="btn btn-outline-secondary" type="button" aria-label="@I18n[I18nKey.Ui.ChapterPicker.ClearAriaLabel]" @onclick="Clear">
                    <i class="bi bi-x"></i>
                </button>
            }
        </Suffix>
        <ItemTemplate Context="chapter">
            @chapter.Name
            @if (!string.IsNullOrEmpty(chapter.ShortCode)) {
                <span class="badge bg-secondary ms-1">@chapter.ShortCode</span>
            }
        </ItemTemplate>
        <ListFooter>
            @if (!Inline && FilteredChapters.Count > MaxShown) {
                <div class="list-group-item py-1 small text-secondary">
                    @I18n[$"{I18nKey.Ui.ChapterPicker.MoreResults}?count={FilteredChapters.Count - MaxShown}"]
                </div>
            }
        </ListFooter>
    </SearchDropdown>
}
