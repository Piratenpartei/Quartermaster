<label class="card choice-card cursor-pointer mb-0 @CardClass()">
    <div class="card-body d-flex align-items-start gap-3">
        <input class="form-check-input flex-shrink-0 mt-1" type="radio" name="@Name" checked="@Selected" @onchange="OnChange" />
        <div class="flex-grow-1">@ChildContent</div>
    </div>
</label>
