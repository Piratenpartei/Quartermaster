@using Quartermaster.Api.I18n

<div class="row g-2 align-items-end mb-3">
    <div class="col-sm-4 col-lg-3">
        <label class="form-label" for="@($"{IdPrefix}-member-number")">@I18n[I18nKey.Ui.KeycloakAccountSearch.MemberNumber]</label>
        <input id="@($"{IdPrefix}-member-number")" class="form-control" inputmode="numeric" @bind="MemberNumber" @bind:event="oninput"
               @onkeydown="OnKeyDown" />
    </div>
    <div class="col-sm-8 col-lg-6">
        <label class="form-label" for="@($"{IdPrefix}-query")">@I18n[I18nKey.Ui.KeycloakAccountSearch.Query]</label>
        <input id="@($"{IdPrefix}-query")" class="form-control" placeholder="@I18n[I18nKey.Ui.KeycloakAccountSearch.QueryPlaceholder]"
               @bind="Query" @bind:event="oninput" @onkeydown="OnKeyDown" />
    </div>
    <div class="col-auto">
        <button type="button" class="btn btn-primary" disabled="@(Busy || IsEmpty)" @onclick="SearchAsync">
            @if (Busy) {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            } else {
                <i class="bi bi-search me-1"></i>
            }
            @I18n[I18nKey.Ui.KeycloakAccountSearch.Search]
        </button>
    </div>
</div>
