@using Quartermaster.Api.I18n
@using Quartermaster.Api.Motions

<SearchDropdown TItem="MotionDTO" Items="@ShownMotions" OnSelect="SelectMotion" OnFocus="EnsureLoaded"
                SearchText="@SearchText" SearchTextChanged="OnSearchInput" Placeholder="@I18n[I18nKey.Ui.MotionPicker.Placeholder]"
                GroupClass="input-group-sm" Disabled="Disabled" ShowWithoutItems="true">
    <Prefix>
        <span class="input-group-text"><i class="bi bi-search"></i></span>
    </Prefix>
    <Suffix>
        @if (!string.IsNullOrEmpty(Value)) {
            <button class="btn btn-outline-secondary" type="button" aria-label="@I18n[I18nKey.Ui.MotionPicker.ClearAriaLabel]" @onclick="Clear">
                <i class="bi bi-x"></i>
            </button>
        }
    </Suffix>
    <ListHeader>
        @if (Loading) {
            <div class="list-group-item py-1 small text-secondary">
                <span class="spinner-border spinner-border-sm" role="status"></span> @I18n[I18nKey.Ui.MotionPicker.LoadingHint]
            </div>
        } else if (FilteredMotions.Count == 0) {
            <div class="list-group-item py-1 small text-secondary">@I18n[I18nKey.Ui.MotionPicker.NoOpenMotions]</div>
        }
    </ListHeader>
    <ItemTemplate Context="motion">
        @motion.Title
        <span class="text-secondary ms-1">@motion.AuthorName</span>
    </ItemTemplate>
    <ListFooter>
        @if (!string.IsNullOrEmpty(ChapterId)) {
            <a class="list-group-item list-group-item-action py-1 small text-primary"
               href="/Motions/Create?chapterId=@ChapterId" target="_blank">
                <i class="bi bi-plus-circle"></i> @I18n[I18nKey.Ui.MotionPicker.CreateNewMotion]
            </a>
        }
    </ListFooter>
</SearchDropdown>
