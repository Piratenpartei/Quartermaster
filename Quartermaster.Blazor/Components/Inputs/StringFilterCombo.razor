@using Quartermaster.Api.Notifications

<SearchDropdown TItem="NotificationStatsFilterOptionDTO" Items="@ShownItems" OnSelect="SelectItem"
                SearchText="@SearchText" SearchTextChanged="OnSearchInput" Placeholder="@AllOptionLabel" ShowWithoutItems="true">
    <ListHeader>
        <button type="button" class="list-group-item list-group-item-action py-1 small text-secondary" tabindex="-1"
                @onclick="ClearSelection">
            <em>@AllOptionLabel</em>
        </button>
    </ListHeader>
    <ItemTemplate Context="item">
        <span>@item.DisplayName</span>
        @if (!string.Equals(item.Value, item.DisplayName, System.StringComparison.Ordinal)) {
            <code class="small text-secondary ms-1">@item.Value</code>
        }
    </ItemTemplate>
</SearchDropdown>
