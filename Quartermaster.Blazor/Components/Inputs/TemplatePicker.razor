@using Quartermaster.Api.I18n
@using Quartermaster.Api.Templates

<SearchDropdown TItem="TemplateListItemDTO" Items="@ShownTemplates" OnSelect="SelectTemplate"
                SearchText="@SearchText" SearchTextChanged="OnSearchInput" Placeholder="@I18n[I18nKey.Ui.TemplatePicker.Placeholder]"
                InputClass="@SizeClass" Disabled="Disabled" InInputGroup="InInputGroup">
    <ItemTemplate Context="tmpl">
        <span>@tmpl.DisplayName</span>
        @if (!string.IsNullOrEmpty(tmpl.Identifier)) {
            <code class="small text-secondary ms-1">@tmpl.Identifier</code>
        }
    </ItemTemplate>
</SearchDropdown>
