@typeparam T

<div class="ms-3">
    <div class="d-flex align-items-center py-1">
        @if (Node.IsLeaf) {
            <span class="me-2 text-secondary" style="width: 28px; text-align: center; display: inline-block;">
                <i class="bi bi-dash"></i>
            </span>
        } else {
            <button class="btn btn-sm btn-outline-secondary me-2 border-0"
                    @onclick="Toggle" style="width: 28px; height: 28px; padding: 0;">
                @if (Node.Loading) {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                } else if (Node.Expanded) {
                    <i class="bi bi-chevron-down"></i>
                } else {
                    <i class="bi bi-chevron-right"></i>
                }
            </button>
        }
        @ItemContent(Node.Value)
    </div>

    @if (Node.Expanded && Node.Children != null) {
        @foreach (var child in Node.Children) {
            <LazyTreeNode T="T" Node="child" LoadChildren="LoadChildren" ItemContent="ItemContent" />
        }
    }
</div>
