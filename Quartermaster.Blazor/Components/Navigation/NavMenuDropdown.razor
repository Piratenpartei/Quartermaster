@if (!Collapsed) {
    <div class="menu-backdrop" @onclick=Close></div>
}

<div class="dropdown @(Collapsed ? "" : "nav-dropdown-open")" @onfocusout=OnFocusOut>
    <button class="nav-link pe-auto text-nowrap" @onclick=ToggleDropdown>
        @ButtonContent

        @if (Collapsed) {
            <i class="ps-1 bi bi-caret-down-fill"></i>
        } else {
            <i class="ps-1 bi bi-caret-up-fill"></i>
        }
    </button>

    <ul class="dropdown-menu @(Collapsed ? "" : "show")" @onclick=Close>
        @DropdownContent
    </ul>
</div>
