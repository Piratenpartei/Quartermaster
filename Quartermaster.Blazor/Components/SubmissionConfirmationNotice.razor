@using Quartermaster.Api.I18n
@inject I18nService I18n

<div class="alert alert-info">
    <h5 class="alert-heading"><i class="bi bi-envelope-check me-2"></i>@I18n[I18nKey.Ui.SubmissionConfirmationNotice.Heading]</h5>
    <p class="mb-1">
        @((MarkupString)I18n[$"{I18nKey.Ui.SubmissionConfirmationNotice.Line1}?email={Email}"])
    </p>
    <p class="mb-0">
        @I18n[I18nKey.Ui.SubmissionConfirmationNotice.Line2]
    </p>
</div>
