@using Quartermaster.Api.I18n

<div class="border rounded bg-body p-2 my-2 text-body">
    @if (Suggestion == null) {
        <LoadingSpinner />
    } else if (ExistingOffice != null) {
        <p class="mb-2">@I18n[I18nParams.With(I18nKey.Ui.SupportSignatures.AddToExistingOffice, ("office", ExistingOffice.Name))]</p>
        <button class="btn btn-sm btn-primary" @onclick="AddToExisting" disabled="@Busy">@I18n[I18nKey.Ui.SupportSignatures.AddToOffice]</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Cancelled">@I18n[I18nKey.Ui.Common.Cancel]</button>
    } else {
        <p class="small text-secondary mb-2">@I18n[I18nKey.Ui.SupportSignatures.NewOfficeIntro]</p>
        <OfficeFields Request="@Request" />
        <div class="small mt-2">@I18n[I18nKey.Ui.SupportSignatures.OfficeMunicipalities]</div>
        @foreach (var municipality in Suggestion.Municipalities) {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="assign-@municipality.Id" checked="@Request.MunicipalityIds.Contains(municipality.Id)"
                       @onchange="() => Toggle(municipality.Id)" />
                <label class="form-check-label" for="assign-@municipality.Id">@municipality.Name</label>
            </div>
        }
        <div class="mt-2">
            <button class="btn btn-sm btn-primary" @onclick="CreateOffice" disabled="@Busy">@I18n[I18nKey.Ui.SupportSignatures.CreateOffice]</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="Cancelled">@I18n[I18nKey.Ui.Common.Cancel]</button>
        </div>
    }
</div>
