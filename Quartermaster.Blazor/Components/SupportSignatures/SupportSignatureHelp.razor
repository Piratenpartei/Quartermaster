@using Quartermaster.Api.I18n

<div class="card mb-3">
    <div class="card-body">
        <h5><i class="bi bi-info-circle me-2"></i>@I18n[I18nKey.Ui.SupportSignatures.HelpTitle]</h5>
        <p>@I18n[I18nKey.Ui.SupportSignatures.HelpWhat]</p>
        <p>@I18n[I18nKey.Ui.SupportSignatures.HelpWho]</p>
        <p class="mb-1">@I18n[I18nKey.Ui.SupportSignatures.HelpSteps]</p>
        <ol class="mb-2">
            <li>@I18n[I18nKey.Ui.SupportSignatures.HelpPrint]</li>
            <li>@I18n[I18nKey.Ui.SupportSignatures.HelpFill]</li>
            <li>@I18n[I18nKey.Ui.SupportSignatures.HelpSend]</li>
        </ol>
        <p class="mb-0 small text-secondary">@I18n[I18nKey.Ui.SupportSignatures.HelpCertify]</p>
    </div>
</div>
