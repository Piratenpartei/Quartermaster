@using Quartermaster.Api.Options

@if (Schemas.Count > 0) {
    <div class="card position-sticky" style="top: 1rem;">
        <div class="card-body">
            <h5>Verfügbare Felder</h5>
            @foreach (var schema in Schemas) {
                <h6 class="mt-3 mb-1 pb-1 border-bottom">
                    <code>@schema.VariablePrefix</code>
                    @if (!string.IsNullOrEmpty(schema.ModelName) && schema.ModelName != schema.VariablePrefix) {
                        <span class="text-secondary small ms-1">(@schema.ModelName)</span>
                    }
                </h6>
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        @foreach (var field in schema.Fields) {
                            <tr>
                                <td class="py-0">
                                    <code class="small">@field.Name</code>
                                    <span class="text-secondary small">@field.Type</span>
                                </td>
                                <td class="py-0 text-end" style="width: 32px;">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm icon-btn-round"
                                            title="In Template einfügen" aria-label="In Template einfügen"
                                            @onclick="() => OnInsertField.InvokeAsync(field.FluidExpression)">
                                        <i class="bi bi-plus" style="font-size: 0.85rem; line-height: 1;"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}
