@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Services
@inject LanguageService Language
@inject I18nService I18n

<div class="dropdown @(Open ? "show" : "")">
    <button class="btn btn-hover-color-body-bg btn-hover-scale1" type="button" @onclick="Toggle" title="@I18n[I18nKey.Ui.LanguageSwitcher.Tooltip]">
        <i class="bi bi-translate"></i>
        <span class="text-uppercase ms-1 small">@Language.CurrentLanguage</span>
        @if (Open) {
            <i class="ps-1 bi bi-caret-up-fill"></i>
        } else {
            <i class="ps-1 bi bi-caret-down-fill"></i>
        }
    </button>
    @if (Open) {
        <ul class="dropdown-menu dropdown-menu-end show" style="display: block; position: absolute; right: 0; z-index: 1050;">
            @foreach (var lang in LanguageService.AvailableLanguages) {
                <li>
                    <button class="dropdown-item @(lang == Language.CurrentLanguage ? "active" : "")"
                            type="button" @onclick="() => SwitchTo(lang)">
                        @Label(lang)
                    </button>
                </li>
            }
        </ul>
    }
</div>

@if (Open) {
    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="Close"></div>
}
