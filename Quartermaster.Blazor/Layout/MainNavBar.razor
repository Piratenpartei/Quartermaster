@using Quartermaster.Blazor.Components
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@implements IDisposable

<nav class="navbar navbar-expand-lg bg-body-tertiary mb-3">
    <div class="container">
        <a class="navbar-brand" href="/">
            Quartermaster
        </a>
        <button class="navbar-toggler btn-hover-scale1" type="button" @onclick=ToggleMenu>
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse @(Collapsed ? "" : "show")">
            <ul class="navbar-nav me-auto mb-lg-0">
                <li class="nav-item">
                    <NavMenuButton HRef="/">@I18n[I18nKey.Ui.MainNavBar.Home]</NavMenuButton>
                </li>
                <li class="nav-item">
                    <NavMenuDropdown>
                        <ButtonContent>@I18n[I18nKey.Ui.MainNavBar.MemberPortal]</ButtonContent>
                        <DropdownContent>
                            <li><a class="dropdown-item" href="/DueSelector/UserDataInput">@I18n[I18nKey.Ui.MainNavBar.MemberPortalDueSelector]</a></li>
                            <li><a class="dropdown-item" href="/MembershipApplication/PersonalData">@I18n[I18nKey.Ui.MainNavBar.MemberPortalApplication]</a></li>
                            <li><a class="dropdown-item" href="/Motions/Create">@I18n[I18nKey.Ui.MainNavBar.MemberPortalSubmitMotion]</a></li>
                        </DropdownContent>
                    </NavMenuDropdown>
                </li>
                <RequirePermission AnyOfChapterPermissions="@PermissionIdentifier.BoardWorkPermissions">
                    <li class="nav-item">
                        <NavMenuDropdown>
                            <ButtonContent>@I18n[I18nKey.Ui.MainNavBar.BoardWork]</ButtonContent>
                            <DropdownContent>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewMotions">
                                    <li><a class="dropdown-item" href="/Administration/Motions">@I18n[I18nKey.Ui.MainNavBar.BoardWorkMotions]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewMeetings">
                                    <li><a class="dropdown-item" href="/Administration/Meetings">@I18n[I18nKey.Ui.MainNavBar.BoardWorkMeetings]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewApplications">
                                    <li><a class="dropdown-item" href="/Administration/MembershipApplications">@I18n[I18nKey.Ui.MainNavBar.BoardWorkApplications]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewDueSelections">
                                    <li><a class="dropdown-item" href="/Administration/DueSelections">@I18n[I18nKey.Ui.MainNavBar.BoardWorkDueSelections]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewMembers">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/Members">@I18n[I18nKey.Ui.MainNavBar.BoardWorkMembers]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewEvents">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/Events">@I18n[I18nKey.Ui.MainNavBar.BoardWorkEvents]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewTemplates">
                                    <li><a class="dropdown-item" href="/Administration/EventTemplates">@I18n[I18nKey.Ui.MainNavBar.BoardWorkEventTemplates]</a></li>
                                </RequirePermission>
                            </DropdownContent>
                        </NavMenuDropdown>
                    </li>
                </RequirePermission>
                <RequirePermission RequireAuth="true">
                    <li class="nav-item">
                        <NavMenuDropdown>
                            <ButtonContent>@I18n[I18nKey.Ui.MainNavBar.Administration]</ButtonContent>
                            <DropdownContent>
                                <li><a class="dropdown-item" href="/Administration/AdministrativeDivisions">@I18n[I18nKey.Ui.MainNavBar.AdministrationDivisionsSearch]</a></li>
                                <li><a class="dropdown-item" href="/Administration/AdministrativeDivisionTree">@I18n[I18nKey.Ui.MainNavBar.AdministrationDivisionsTree]</a></li>
                            </DropdownContent>
                        </NavMenuDropdown>
                    </li>
                </RequirePermission>
                <RequirePermission AnyOfPermissions="@PermissionIdentifier.SystemPermissions">
                    <li class="nav-item">
                        <NavMenuDropdown>
                            <ButtonContent>@I18n[I18nKey.Ui.MainNavBar.System]</ButtonContent>
                            <DropdownContent>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.ViewOptions">
                                    <li><a class="dropdown-item" href="/Administration/Settings">@I18n[I18nKey.Ui.MainNavBar.SystemSettings]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewTemplates">
                                    <li><a class="dropdown-item" href="/Administration/Templates">@I18n[I18nKey.Ui.MainNavBar.SystemTemplates]</a></li>
                                </RequirePermission>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.ViewUsers">
                                    <li><a class="dropdown-item" href="/Administration/Users">@I18n[I18nKey.Ui.MainNavBar.SystemUsers]</a></li>
                                    <li><a class="dropdown-item" href="/Administration/LoginLockouts">@I18n[I18nKey.Ui.MainNavBar.SystemLoginLockouts]</a></li>
                                </RequirePermission>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.ManageRoles">
                                    <li><a class="dropdown-item" href="/Administration/Roles">@I18n[I18nKey.Ui.MainNavBar.SystemRoles]</a></li>
                                </RequirePermission>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/Administration/Chapters">@I18n[I18nKey.Ui.MainNavBar.SystemChaptersList]</a></li>
                                <li><a class="dropdown-item" href="/Administration/ChapterTree">@I18n[I18nKey.Ui.MainNavBar.SystemChaptersTree]</a></li>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewOfficers">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/ChapterOfficers">@I18n[I18nKey.Ui.MainNavBar.SystemChapterOfficers]</a></li>
                                </RequirePermission>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.ViewAllMembers">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/Members">@I18n[I18nKey.Ui.MainNavBar.SystemMembers]</a></li>
                                    <li><a class="dropdown-item" href="/Administration/Members/Import">@I18n[I18nKey.Ui.MainNavBar.SystemMemberImport]</a></li>
                                    <li><a class="dropdown-item" href="/Administration/ImportStatus">@I18n[I18nKey.Ui.MainNavBar.SystemImportStatus]</a></li>
                                </RequirePermission>
                            </DropdownContent>
                        </NavMenuDropdown>
                    </li>
                </RequirePermission>
            </ul>
            <div class="d-flex align-items-center gap-2">
                @if (AuthService.IsAuthenticated) {
                    <a href="/Settings" class="btn btn-outline-secondary btn-sm btn-hover-scale1">
                        <i class="bi bi-person-fill"></i> @AuthService.CurrentUser?.DisplayName
                    </a>
                    <a href="/Sessions" class="btn btn-outline-secondary btn-sm btn-hover-scale1" title="@I18n[I18nKey.Ui.MainNavBar.MySessionsTitle]">
                        <i class="bi bi-shield-lock"></i>
                    </a>
                    <a href="/Account/Benachrichtigungen" class="btn btn-outline-secondary btn-sm btn-hover-scale1" title="@I18n[I18nKey.Ui.MainNavBar.NotificationsTitle]">
                        <i class="bi bi-bell"></i>
                    </a>
                    <button class="btn btn-outline-secondary btn-sm btn-hover-scale1" @onclick=HandleLogout>
                        @I18n[I18nKey.Ui.MainNavBar.Logout]
                    </button>
                } else {
                    <a href="/Login" class="btn btn-outline-primary btn-sm btn-hover-scale1">
                        @I18n[I18nKey.Ui.MainNavBar.Login]
                    </a>
                }
                <LanguageSwitcher />
                <button class="btn btn-hover-color-body-bg btn-hover-scale1" @onclick=ToggleDarkMode>
                    @if (AppState.SelectedTheme == Theme.Dark) {
                        <i class="bi bi-brightness-high-fill"></i>
                    } else {
                        <i class="bi bi-moon-fill"></i>
                    }
                </button>
            </div>
        </div>
    </div>
</nav>
