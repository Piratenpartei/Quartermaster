@using Quartermaster.Blazor.Components
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@implements IDisposable

<nav class="navbar navbar-expand-lg bg-body-tertiary mb-3">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="/">
            <img src="img/PPDE_Signet.png" alt="" width="32" height="32" class="me-2" />
            Quartermaster
        </a>
        <button class="navbar-toggler" type="button" @onclick=ToggleMenu>
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse @(Collapsed ? "" : "show")">
            <ul class="navbar-nav me-auto mb-lg-0">
                <li class="nav-item">
                    <NavMenuButton HRef="/">@I18n[I18nKey.Ui.MainNavBar.Home]</NavMenuButton>
                </li>
                @if (ShowMemberPortal()) {
                    <li class="nav-item">
                        <NavMenuDropdown>
                            <ButtonContent>@I18n[I18nKey.Ui.MainNavBar.MemberPortal]</ButtonContent>
                            <DropdownContent>
                                @if (IsFormOpen(PublicFormKind.DueSelection)) {
                                    <li><a class="dropdown-item" href="/DueSelector">@I18n[I18nKey.Ui.MainNavBar.MemberPortalDueSelector]</a></li>
                                }
                                @if (IsFormOpen(PublicFormKind.MembershipApplication)) {
                                    <li><a class="dropdown-item" href="/MembershipApplication">@I18n[I18nKey.Ui.MainNavBar.MemberPortalApplication]</a></li>
                                }
                                @if (IsFormOpen(PublicFormKind.Motion)) {
                                    <li><a class="dropdown-item" href="/Motions/Create">@I18n[I18nKey.Ui.MainNavBar.MemberPortalSubmitMotion]</a></li>
                                }
                            </DropdownContent>
                        </NavMenuDropdown>
                    </li>
                }
                <li class="nav-item">
                    <NavMenuDropdown>
                        <ButtonContent>@I18n[I18nKey.Ui.MainNavBar.Forms]</ButtonContent>
                        <DropdownContent>
                            <li><a class="dropdown-item" href="/Forms">@I18n[I18nKey.Ui.MainNavBar.FormsCatalog]</a></li>
                            <li><a class="dropdown-item" href="/Forms/Mine">@I18n[I18nKey.Ui.MainNavBar.FormsMine]</a></li>
                            @if (AuthService.IsAuthenticated) {
                                <li><a class="dropdown-item" href="/Forms/Receipts">@I18n[I18nKey.Ui.MainNavBar.FormsReceipts]</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Forms/ExpenseReimbursement">@I18n[I18nKey.Ui.MainNavBar.FormsExpenseReimbursement]</a></li>
                            <li><a class="dropdown-item" href="/Forms/TravelExpense">@I18n[I18nKey.Ui.MainNavBar.FormsTravelExpense]</a></li>
                        </DropdownContent>
                    </NavMenuDropdown>
                </li>
                <RequirePermission AnyOfPermissions="@(new List<string>(PermissionIdentifier.BoardWorkPermissions) { PermissionIdentifier.ReviewNewsPosts, PermissionIdentifier.ManageAccreditation, PermissionIdentifier.EditTravelExpenseRules, PermissionIdentifier.ManageSupportSignatures })">
                    <li class="nav-item">
                        <NavMenuDropdown>
                            <ButtonContent>@I18n[I18nKey.Ui.MainNavBar.BoardWork]</ButtonContent>
                            <DropdownContent>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewMotions">
                                    <li><a class="dropdown-item" href="/Administration/Motions">@I18n[I18nKey.Ui.MainNavBar.BoardWorkMotions]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewMeetings">
                                    <li><a class="dropdown-item" href="/Administration/Meetings">@I18n[I18nKey.Ui.MainNavBar.BoardWorkMeetings]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewApplications">
                                    <li><a class="dropdown-item" href="/Administration/MembershipApplications">@I18n[I18nKey.Ui.MainNavBar.BoardWorkApplications]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewDueSelections">
                                    <li><a class="dropdown-item" href="/Administration/DueSelections">@I18n[I18nKey.Ui.MainNavBar.BoardWorkDueSelections]</a></li>
                                </RequirePermission>
                                @if (CanSeeForwardingCases) {
                                    <li><a class="dropdown-item" href="/Administration/Forwarding">@I18n[I18nKey.Ui.MainNavBar.BoardWorkForwarding]</a></li>
                                }
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewMembers">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/Members">@I18n[I18nKey.Ui.MainNavBar.BoardWorkMembers]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewEvents">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/Events">@I18n[I18nKey.Ui.MainNavBar.BoardWorkEvents]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewTemplates">
                                    <li><a class="dropdown-item" href="/Administration/EventTemplates">@I18n[I18nKey.Ui.MainNavBar.BoardWorkEventTemplates]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ManageAssemblyMotions">
                                    <li><a class="dropdown-item" href="/Administration/AssemblyMotionPortals">@I18n[I18nKey.Ui.MainNavBar.BoardWorkAssemblyMotions]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ManageChapterMail">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/Mailings">@I18n[I18nKey.Ui.MainNavBar.BoardWorkMailings]</a></li>
                                </RequirePermission>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.ReviewNewsPosts">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/NewsPosts">@I18n[I18nKey.Ui.MainNavBar.BoardWorkNewsPosts]</a></li>
                                </RequirePermission>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.ManageAccreditation">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/Accreditation">@I18n[I18nKey.Ui.MainNavBar.BoardWorkAccreditation]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ManageSupportSignatures">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/SupportSignatures">@I18n[I18nKey.Ui.SupportSignatures.PageTitle]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.EditTravelExpenseRules">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/TravelExpenseRules">@I18n[I18nKey.Ui.MainNavBar.BoardWorkTravelExpenseRules]</a></li>
                                </RequirePermission>
                            </DropdownContent>
                        </NavMenuDropdown>
                    </li>
                </RequirePermission>
                <li class="nav-item">
                    <NavMenuDropdown>
                        <ButtonContent>@I18n[I18nKey.Ui.MainNavBar.Administration]</ButtonContent>
                        <DropdownContent>
                            <RequirePermission RequireAuth="true">
                                <li><a class="dropdown-item" href="/Administration/AdministrativeDivisions">@I18n[I18nKey.Ui.MainNavBar.AdministrationDivisionsSearch]</a></li>
                                <li><a class="dropdown-item" href="/Administration/AdministrativeDivisionTree">@I18n[I18nKey.Ui.MainNavBar.AdministrationDivisionsTree]</a></li>
                                <li><hr class="dropdown-divider"></li>
                            </RequirePermission>
                            <li><a class="dropdown-item" href="/Administration/Chapters">@I18n[I18nKey.Ui.MainNavBar.AdministrationChaptersList]</a></li>
                            <li><a class="dropdown-item" href="/Administration/ChapterTree">@I18n[I18nKey.Ui.MainNavBar.AdministrationChaptersTree]</a></li>
                            <RequirePermission GlobalPermission="@PermissionIdentifier.ManageApplicantRegister">
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/Administration/ApplicantRegister">@I18n[I18nKey.Ui.MainNavBar.AdministrationApplicantRegister]</a></li>
                            </RequirePermission>
                        </DropdownContent>
                    </NavMenuDropdown>
                </li>
                <RequirePermission AnyOfPermissions="@PermissionIdentifier.SystemPermissions">
                    <li class="nav-item">
                        <NavMenuDropdown>
                            <ButtonContent>@I18n[I18nKey.Ui.MainNavBar.System]</ButtonContent>
                            <DropdownContent>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.ViewOptions">
                                    <li><a class="dropdown-item" href="/Administration/Settings">@I18n[I18nKey.Ui.MainNavBar.SystemSettings]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewTemplates">
                                    <li><a class="dropdown-item" href="/Administration/Templates">@I18n[I18nKey.Ui.MainNavBar.SystemTemplates]</a></li>
                                </RequirePermission>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.ViewUsers">
                                    <li><a class="dropdown-item" href="/Administration/Users">@I18n[I18nKey.Ui.MainNavBar.SystemUsers]</a></li>
                                    <li><a class="dropdown-item" href="/Administration/LoginLockouts">@I18n[I18nKey.Ui.MainNavBar.SystemLoginLockouts]</a></li>
                                </RequirePermission>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.ManageRoles">
                                    <li><a class="dropdown-item" href="/Administration/Roles">@I18n[I18nKey.Ui.MainNavBar.SystemRoles]</a></li>
                                </RequirePermission>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.ViewOfficers">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/ChapterOfficers">@I18n[I18nKey.Ui.MainNavBar.SystemChapterOfficers]</a></li>
                                </RequirePermission>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.ViewAllMembers">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/Members">@I18n[I18nKey.Ui.MainNavBar.SystemMembers]</a></li>
                                    <li><a class="dropdown-item" href="/Administration/Members/Import">@I18n[I18nKey.Ui.MainNavBar.SystemMemberImport]</a></li>
                                    <li><a class="dropdown-item" href="/Administration/ImportStatus">@I18n[I18nKey.Ui.MainNavBar.SystemImportStatus]</a></li>
                                </RequirePermission>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.ViewNotificationLogs">
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Administration/Notifications/Stats">@I18n[I18nKey.Ui.MainNavBar.SystemNotificationStats]</a></li>
                                </RequirePermission>
                                <RequirePermission GlobalPermission="@PermissionIdentifier.EditPdfTemplates">
                                    <li><a class="dropdown-item" href="/Administration/PdfTemplates">@I18n[I18nKey.Ui.MainNavBar.SystemPdfTemplates]</a></li>
                                </RequirePermission>
                            </DropdownContent>
                        </NavMenuDropdown>
                    </li>
                </RequirePermission>
            </ul>
            <div class="d-flex align-items-center gap-2">
                @if (AuthService.IsAuthenticated) {
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <NavMenuDropdown AlignEnd="true">
                                <ButtonContent>
                                    <i class="bi bi-person-circle"></i> @AuthService.CurrentUser?.DisplayName
                                    @if (AuthService.CurrentUser?.HasVotingRights == true) {
                                        <i class="bi bi-check-circle-fill text-success ms-1" title="@I18n[I18nKey.Ui.MainNavBar.VotingRights]" aria-label="@I18n[I18nKey.Ui.MainNavBar.VotingRights]"></i>
                                    }
                                </ButtonContent>
                                <DropdownContent>
                                    @if (AuthService.CurrentUser?.HasVotingRights != null) {
                                        <li><span class="dropdown-item-text small text-secondary">@VotingRightsText</span></li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li><a class="dropdown-item" href="/Settings"><i class="bi bi-gear"></i> @I18n[I18nKey.Ui.MainNavBar.Settings]</a></li>
                                    <li><a class="dropdown-item" href="/Sessions"><i class="bi bi-shield-lock"></i> @I18n[I18nKey.Ui.MainNavBar.MySessionsTitle]</a></li>
                                    <li><a class="dropdown-item" href="/Account/Notifications"><i class="bi bi-bell"></i> @I18n[I18nKey.Ui.MainNavBar.NotificationsTitle]</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    @foreach (var language in Quartermaster.Blazor.Services.LanguageService.AvailableLanguages) {
                                        <li>
                                            <button type="button" class="dropdown-item @(language == LanguageService.CurrentLanguage ? "active" : "")" @onclick="() => SwitchLanguage(language)">
                                                <i class="bi bi-translate"></i> @LanguageSwitcher.Label(language)
                                            </button>
                                        </li>
                                    }
                                    <li>
                                        <button type="button" class="dropdown-item" @onclick=ToggleDarkMode>
                                            @if (AppState.SelectedTheme == Theme.Dark) {
                                                <i class="bi bi-brightness-high-fill"></i> @I18n[I18nKey.Ui.MainNavBar.LightMode]
                                            } else {
                                                <i class="bi bi-moon-fill"></i> @I18n[I18nKey.Ui.MainNavBar.DarkMode]
                                            }
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><button type="button" class="dropdown-item" @onclick=HandleLogout><i class="bi bi-box-arrow-right"></i> @I18n[I18nKey.Ui.MainNavBar.Logout]</button></li>
                                </DropdownContent>
                            </NavMenuDropdown>
                        </li>
                    </ul>
                } else {
                    <a href="/Login" class="btn btn-primary btn-sm">
                        <i class="bi bi-box-arrow-in-right"></i> @I18n[I18nKey.Ui.MainNavBar.Login]
                    </a>
                    <LanguageSwitcher />
                    <button type="button" class="btn btn-hover-color-body-bg" @onclick=ToggleDarkMode title="@(AppState.SelectedTheme == Theme.Dark ? I18n[I18nKey.Ui.MainNavBar.LightMode] : I18n[I18nKey.Ui.MainNavBar.DarkMode])">
                        @if (AppState.SelectedTheme == Theme.Dark) {
                            <i class="bi bi-brightness-high-fill"></i>
                        } else {
                            <i class="bi bi-moon-fill"></i>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
</nav>
