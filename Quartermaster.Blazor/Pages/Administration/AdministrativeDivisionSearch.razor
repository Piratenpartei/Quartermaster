@page "/Administration/AdministrativeDivisions"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.AdminDivisionSearch.PageTitle]</h3>
</div>

<div class="mb-3">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" placeholder="@I18n[I18nKey.Ui.AdminDivisionSearch.SearchPlaceholder]"
               @bind=SearchQuery @bind:event="oninput" @onkeyup=OnSearchKeyUp />
    </div>
</div>

@if (Loading) {
    <LoadingSpinner />
} else if (Response != null) {
    <div class="mb-2 text-secondary">
        @I18n[$"{I18nKey.Ui.AdminDivisionSearch.TotalCount}?count={Response.TotalCount}"]
    </div>

    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.Common.Name]</th>
                <th>@I18n[I18nKey.Ui.AdminDivisionSearch.LevelColumn]</th>
                <th>@I18n[I18nKey.Ui.AdminDivisionSearch.AdminCodeColumn]</th>
                <th>@I18n[I18nKey.Ui.AdminDivisionSearch.PostCodesColumn]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var division in Response.Items) {
                <tr>
                    <td>@division.Name</td>
                    <td>@DepthLabel(division.Depth)</td>
                    <td><code>@division.AdminCode</code></td>
                    <td class="text-truncate" style="max-width: 300px;" title="@division.PostCodes">
                        @(division.PostCodes ?? "—")
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="GoToPage" />
}
