@page "/Administration/AdministrativeDivisionTree"
@using Quartermaster.Api
@using Quartermaster.Api.AdministrativeDivisions
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.AdminDivisionTree.PageTitle]</h3>
</div>

@if (RootNodes == null) {
    <LoadingSpinner />
} else {
    <div class="list-group">
        @foreach (var node in RootNodes) {
            <LazyTreeNode T="AdministrativeDivisionDTO" Node="node" LoadChildren="LoadDivisionChildren">
                <ItemContent>
                    <span class="me-2">@context.Name</span>
                    <span class="badge bg-secondary">@DepthLabel(context.Depth)</span>
                    @if (!string.IsNullOrEmpty(context.PostCodes)) {
                        <span class="ms-2 text-secondary small text-truncate" style="max-width: 200px;"
                              title="@context.PostCodes">
                            @I18n[$"{I18nKey.Ui.AdminDivisionTree.PostCodesPrefix}?codes={context.PostCodes}"]
                        </span>
                    }
                </ItemContent>
            </LazyTreeNode>
        }
    </div>
}
