@page "/Administration/Events/{EventId:guid}/Motions/Results"
@using Quartermaster.Api.AssemblyMotions
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.AssemblyMotions

<PageTitle>@I18n[I18nKey.Ui.AssemblyMotion.ResultsPageTitle]</PageTitle>

<PageBackLink Href="@($"/Administration/Events/{EventId}/Motions")" Text="@I18n[I18nKey.Ui.AssemblyMotion.BackToDashboard]" />

@if (Loading) {
    <LoadingSpinner />
} else if (Portal == null) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.AssemblyMotion.DashboardPortalNotFound]</div>
} else if (Forbidden) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.AssemblyMotion.CommissionOnly]</div>
} else {
    <div class="mb-3">
        <div class="text-secondary">@I18n[I18nKey.Ui.AssemblyMotion.ResultsPageTitle]</div>
        <h3 class="mb-0">@Portal.EventName</h3>
    </div>

    @if (!EventReached) {
        <div class="alert alert-info">@LockedText</div>
    }

    @if (Items.Count == 0) {
        <EmptyState Message="@I18n[I18nKey.Ui.AssemblyMotion.ResultsNoMotions]" />
    } else {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnNumber]</th>
                        <th>@I18n[I18nKey.Ui.Common.Title]</th>
                        <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnType]</th>
                        <th>@I18n[I18nKey.Ui.Common.Status]</th>
                        <th style="min-width: 14rem;">@I18n[I18nKey.Ui.AssemblyMotion.ColumnResult]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Items) {
                        var motionId = item.Id;
                        <tr @key="item.Id">
                            <td class="text-nowrap">@(string.IsNullOrEmpty(item.DisplayNumber) ? "-" : item.DisplayNumber)</td>
                            <td><a href="/Administration/AssemblyMotions/@item.Id">@item.Title</a></td>
                            <td>@item.TypeCode</td>
                            <td><AssemblyMotionStatusBadge Status="@item.Status" IsInRevision="@item.IsInRevision" /></td>
                            <td>
                                <FormSelect Value="@GetSelection(motionId)" ValueChanged="@((string value) => SetSelection(motionId, value))" Disabled="@(Busy || !EventReached)">
                                    @foreach (var result in AssemblyMotionDisplay.AllResults) {
                                        <option value="@((int)result)">@ResultOptionLabel(result)</option>
                                    }
                                </FormSelect>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-primary" disabled="@(Busy || !EventReached)" @onclick="Save">
                <i class="bi bi-save"></i> @I18n[I18nKey.Ui.AssemblyMotion.ResultsSave]
            </button>
            @if (ChangedCount > 0) {
                <span class="text-secondary">@I18n[I18nParams.With(I18nKey.Ui.AssemblyMotion.ResultsChangedCount, ("count", ChangedCount.ToString()))]</span>
            }
        </div>
    }
}
