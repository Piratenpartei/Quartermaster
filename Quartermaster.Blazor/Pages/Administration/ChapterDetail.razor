@page "/Administration/Chapters/{Id:guid}"
@using System.Collections.Generic
@using Quartermaster.Api
@using Quartermaster.Api.Chapters
@using Quartermaster.Api.ChapterAssociates
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.Inputs

<PageBackLink Href="/Administration/Chapters" />

@if (Loading) {
    <LoadingSpinner />
} else if (Detail == null) {
    <div class="alert alert-danger">@I18n[I18nKey.Ui.ChapterDetail.NotFound]</div>
} else {
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">@Detail.Chapter.Name</h3>
        <div class="d-flex gap-2">
            @if (!Editing) {
                <RequirePermission GlobalPermission="@PermissionIdentifier.EditChapter">
                    <button class="btn btn-sm btn-outline-primary btn-hover-scale1" @onclick="BeginEdit">
                        <i class="bi bi-pencil me-1"></i> @I18n[I18nKey.Ui.Common.Edit]
                    </button>
                </RequirePermission>
                <RequirePermission GlobalPermission="@PermissionIdentifier.DeleteChapter">
                    <button class="btn btn-sm btn-outline-danger btn-hover-scale1" @onclick="ConfirmDelete" disabled="@Detail.Children.Any()"
                            title="@(Detail.Children.Any() ? I18n[I18nKey.Ui.ChapterDetail.DeleteDisabledHasChildren] : I18n[I18nKey.Ui.ChapterDetail.DeleteTooltip])">
                        <i class="bi bi-trash me-1"></i> @I18n[I18nKey.Ui.Common.Delete]
                    </button>
                </RequirePermission>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.Common.Details]</h5>
            @if (Editing) {
                <div class="mb-3">
                    <label class="form-label">@I18n[I18nKey.Ui.Common.Name] <RequiredStar /></label>
                    <input type="text" class="form-control" @bind="EditName" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@I18n[I18nKey.Ui.ChapterDetail.ShortCodeLabel]</label>
                    <input type="text" class="form-control" @bind="EditShortCode" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@I18n[I18nKey.Ui.ChapterDetail.ExternalCodeLabel]</label>
                    <input type="text" class="form-control" @bind="EditExternalCode" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@I18n[I18nKey.Ui.ChapterDetail.ParentChapterLabel]</label>
                    <ChapterPicker Value="@EditParentChapterId" ValueChanged="OnParentChanged"
                                   AllowEmpty="true" EmptyLabel="@I18n[I18nKey.Ui.ChapterDetail.ParentEmptyLabel]"
                                   ExcludeIds="@(new List<Guid> { Id })" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@I18n[I18nKey.Ui.ChapterDetail.AdminDivisionLabel]</label>
                    <div class="d-flex">
                        <AdminDivisionPicker Value="@EditAdministrativeDivisionId" ValueChanged="OnDivisionChanged"
                                             InitialDisplayText="@(Detail.AdministrativeDivisionName ?? "")" AllowClear="true" />
                    </div>
                    <div class="form-text">@I18n[I18nKey.Ui.ChapterDetail.AdminDivisionHint]</div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-outline-secondary" @onclick="CancelEdit">@I18n[I18nKey.Ui.Common.Cancel]</button>
                    <button class="btn btn-primary btn-hover-scale1" @onclick="SaveEdit" disabled="@(Saving || string.IsNullOrWhiteSpace(EditName))">
                        @if (Saving) {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        } else {
                            <i class="bi bi-check-circle me-1"></i>
                        }
                        @I18n[I18nKey.Ui.Common.Save]
                    </button>
                </div>
            } else {
                <div class="table-responsive">
                <table class="table table-borderless mb-0">
                    <tbody>
                        <tr><th style="width:200px">@I18n[I18nKey.Ui.Common.Name]</th><td>@Detail.Chapter.Name</td></tr>
                        <tr><th>@I18n[I18nKey.Ui.ChapterDetail.ShortCodeLabel]</th><td>@(Detail.Chapter.ShortCode ?? "—")</td></tr>
                        <tr><th>@I18n[I18nKey.Ui.ChapterDetail.ExternalCodeLabel]</th><td>@(Detail.Chapter.ExternalCode ?? "—")</td></tr>
                        <tr>
                            <th>@I18n[I18nKey.Ui.ChapterDetail.ParentChapterLabel]</th>
                            <td>
                                @if (Detail.ParentChapterId.HasValue) {
                                    <a href="/Administration/Chapters/@Detail.ParentChapterId">@Detail.ParentChapterName</a>
                                } else {
                                    <span>—</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>@I18n[I18nKey.Ui.ChapterDetail.AdminDivisionLabel]</th>
                            <td>@(string.IsNullOrEmpty(Detail.AdministrativeDivisionName) ? "—" : Detail.AdministrativeDivisionName)</td>
                        </tr>
                    </tbody>
                </table>
                </div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">@I18n[I18nKey.Ui.ChapterDetail.BoardSection]</h5>
                <a href="/Administration/Chapters/@Detail.Chapter.Id/AddOfficer" class="btn btn-sm btn-success">
                    <i class="bi bi-plus"></i> @I18n[I18nKey.Ui.Common.Add]
                </a>
            </div>
            @if (Detail.Officers.Count > 0) {
                <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>@I18n[I18nKey.Ui.Common.Name]</th>
                            <th>@I18n[I18nKey.Ui.Common.Role]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var officer in Detail.Officers) {
                            <tr>
                                <td>@officer.MemberFirstName @officer.MemberLastName</td>
                                <td>@RoleLabel(officer.AssociateType)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            } else {
                <p class="text-secondary mb-0">@I18n[I18nKey.Ui.ChapterDetail.NoBoardMembers]</p>
            }
        </div>
    </div>

    @if (Detail.Children.Count > 0) {
        <div class="card mb-3">
            <div class="card-body">
                <h5>@I18n[I18nKey.Ui.ChapterDetail.ChildrenSection]</h5>
                <div class="list-group list-group-flush">
                    @foreach (var child in Detail.Children) {
                        <a href="/Administration/Chapters/@child.Id" class="list-group-item list-group-item-action">
                            @child.Name
                            @if (!string.IsNullOrEmpty(child.ShortCode)) {
                                <span class="badge bg-secondary ms-1">@child.ShortCode</span>
                            }
                        </a>
                    }
                </div>
            </div>
        </div>
    }
}

<ConfirmDialog @ref="DeleteConfirm" Title="@I18n[I18nKey.Ui.ChapterDetail.DeleteDialogTitle]" ConfirmText="@I18n[I18nKey.Ui.ChapterDetail.DeleteDialogConfirm]" />
