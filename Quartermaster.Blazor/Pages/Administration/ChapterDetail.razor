@page "/Administration/Chapters/{Id:guid}"
@using System.Collections.Generic
@using Quartermaster.Api
@using Quartermaster.Api.Chapters
@using Quartermaster.Api.ChapterAssociates
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.Inputs


@if (Loading) {
    <PageBackLink Href="/Administration/Chapters" />
    <LoadingSpinner />
} else if (Detail == null) {
    <PageBackLink Href="/Administration/Chapters" />
    <div class="alert alert-danger">@I18n[I18nKey.Ui.ChapterDetail.NotFound]</div>
} else {
    <PageHeader Title="@Detail.Chapter.Name" BackHref="/Administration/Chapters">
        <Subtitle>
            @if (Detail.Chapter.IsArchived) {
                <StatusBadge Tone="StatusTone.Neutral" Text="@I18n[I18nKey.Ui.ChapterDetail.ArchivedBadge]" />
            }
            <ChapterMarkBadges NoMemberAdministration="Detail.Chapter.NoMemberAdministration" UnableToAct="Detail.Chapter.UnableToAct" />
        </Subtitle>
        <Actions>
            @if (!Editing) {
                <RequirePermission GlobalPermission="@PermissionIdentifier.EditChapter">
                    <button class="btn btn-outline-secondary" @onclick="BeginEdit">
                        <i class="bi bi-pencil me-1"></i> @I18n[I18nKey.Ui.Common.Edit]
                    </button>
                </RequirePermission>
                <RequirePermission GlobalPermission="@PermissionIdentifier.ArchiveChapter">
                    @if (Detail.Chapter.IsArchived) {
                        <button class="btn btn-outline-secondary" @onclick="ConfirmUnarchive">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> @I18n[I18nKey.Ui.ChapterDetail.UnarchiveButton]
                        </button>
                    } else {
                        <button class="btn btn-outline-secondary" @onclick="ConfirmArchive">
                            <i class="bi bi-archive me-1"></i> @I18n[I18nKey.Ui.ChapterDetail.ArchiveButton]
                        </button>
                    }
                </RequirePermission>
                <RequirePermission GlobalPermission="@PermissionIdentifier.DeleteChapter">
                    <button class="btn btn-outline-danger" @onclick="ConfirmDelete" disabled="@Detail.Children.Any()"
                            title="@(Detail.Children.Any() ? I18n[I18nKey.Ui.ChapterDetail.DeleteDisabledHasChildren] : I18n[I18nKey.Ui.ChapterDetail.DeleteTooltip])">
                        <i class="bi bi-trash me-1"></i> @I18n[I18nKey.Ui.Common.Delete]
                    </button>
                </RequirePermission>
            }
        </Actions>
    </PageHeader>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.Common.Details]</h5>
            @if (Editing) {
                <div class="mb-3">
                    <label class="form-label">@I18n[I18nKey.Ui.Common.Name] <RequiredStar /></label>
                    <input type="text" class="form-control" @bind="EditName" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@I18n[I18nKey.Ui.ChapterDetail.ShortCodeLabel]</label>
                    <input type="text" class="form-control" @bind="EditShortCode" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@I18n[I18nKey.Ui.ChapterDetail.ExternalCodeLabel]</label>
                    <StringChipsInput Value="EditExternalCodes" ValueChanged="OnExternalCodesChanged"
                                      Placeholder="@I18n[I18nKey.Ui.ChipsInput.ExternalCodePlaceholder]" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@I18n[I18nKey.Ui.ChapterDetail.KeycloakDepartmentLabel]</label>
                    <input type="text" class="form-control" maxlength="200" @bind="EditKeycloakDepartment" @bind:event="oninput" />
                    <div class="form-text">@I18n[I18nKey.Ui.ChapterDetail.KeycloakDepartmentHint]</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="chapter-contact-email">@I18n[I18nKey.Ui.ChapterDetail.ContactEmailLabel]</label>
                    <input id="chapter-contact-email" type="email" class="form-control" maxlength="254" @bind="EditContactEmail" @bind:event="oninput" />
                    <div class="form-text">@I18n[I18nKey.Ui.ChapterDetail.ContactEmailHint]</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">@I18n[I18nKey.Ui.ChapterDetail.ParentChapterLabel]</label>
                    <ChapterPicker Value="@EditParentChapterId" ValueChanged="OnParentChanged"
                                   AllowEmpty="true" EmptyLabel="@I18n[I18nKey.Ui.ChapterDetail.ParentEmptyLabel]"
                                   ExcludeIds="@(new List<Guid> { Id })" />
                </div>
                <ChapterLevelFields IdPrefix="chapter-edit" IsRoot="@(string.IsNullOrEmpty(EditParentChapterId))"
                                    Level="EditLevel" LevelChanged="OnLevelChanged"
                                    PeriodDays="EditTakeOverPeriodDays" PeriodDaysChanged="OnPeriodDaysChanged" />
                <div class="mb-3">
                    <label class="form-label">@I18n[I18nKey.Ui.ChapterDetail.AdminDivisionLabel]</label>
                    <AdminDivisionChipsInput Value="EditAdministrativeDivisionIds" ValueChanged="OnDivisionsChanged"
                                             InitialNames="EditAdministrativeDivisionNames" />
                    <div class="form-text">@I18n[I18nKey.Ui.ChapterDetail.AdminDivisionHint]</div>
                </div>
                <div class="d-flex flex-wrap justify-content-end gap-2">
                    <button class="btn btn-outline-secondary" @onclick="CancelEdit">@I18n[I18nKey.Ui.Common.Cancel]</button>
                    <button class="btn btn-primary" @onclick="SaveEdit" disabled="@(Saving || string.IsNullOrWhiteSpace(EditName))">
                        @if (Saving) {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        } else {
                            <i class="bi bi-check-circle me-1"></i>
                        }
                        @I18n[I18nKey.Ui.Common.Save]
                    </button>
                </div>
            } else {
                <dl class="row mb-0">
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.Common.Name]</dt>
                        <dd class="col-sm-8">@Detail.Chapter.Name</dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.ChapterDetail.ShortCodeLabel]</dt>
                        <dd class="col-sm-8">@(Detail.Chapter.ShortCode ?? "-")</dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.ChapterDetail.ExternalCodeLabel]</dt>
                        <dd class="col-sm-8">@(Detail.Chapter.ExternalCodes.Count == 0 ? "-" : string.Join(", ", Detail.Chapter.ExternalCodes))</dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.ChapterDetail.KeycloakDepartmentLabel]</dt>
                        <dd class="col-sm-8">@(Detail.Chapter.KeycloakDepartment ?? "---")</dd>
                        @if (AuthService.IsAuthenticated) {
                                <dt class="col-sm-4">@I18n[I18nKey.Ui.ChapterDetail.ContactEmailLabel]</dt>
                                <dd class="col-sm-8">
                                    @if (string.IsNullOrEmpty(Detail.Chapter.ContactEmail)) {
                                        <span>-</span>
                                    } else {
                                        <a href="mailto:@Detail.Chapter.ContactEmail">@Detail.Chapter.ContactEmail</a>
                                    }
                                </dd>
                        }
                            <dt class="col-sm-4">@I18n[I18nKey.Ui.ChapterDetail.ParentChapterLabel]</dt>
                            <dd class="col-sm-8">
                                @if (Detail.ParentChapterId.HasValue) {
                                    <a href="/Administration/Chapters/@Detail.ParentChapterId">@Detail.ParentChapterName</a>
                                } else {
                                    <span>-</span>
                                }
                            </dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.HandUp.LevelLabel]</dt>
                        <dd class="col-sm-8">@LevelText</dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.HandUp.PeriodLabel]</dt>
                        <dd class="col-sm-8">@PeriodText</dd>
                            <dt class="col-sm-4">@I18n[I18nKey.Ui.ChapterDetail.AdminDivisionLabel]</dt>
                            <dd class="col-sm-8">@(Detail.AdministrativeDivisionNames.Count == 0 ? "-" : string.Join(", ", Detail.AdministrativeDivisionNames))</dd>
                </dl>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                <h5 class="mb-0">@I18n[I18nKey.Ui.ChapterDetail.BoardSection]</h5>
                <RequirePermission AnyChapterPermission="@PermissionIdentifier.EditOfficers">
                    <a href="/Administration/Chapters/@Detail.Chapter.Id/AddOfficer" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus"></i> @I18n[I18nKey.Ui.Common.Add]
                    </a>
                </RequirePermission>
            </div>
            @if (Detail.Officers.Count > 0) {
                <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>@I18n[I18nKey.Ui.Common.Name]</th>
                            <th>@I18n[I18nKey.Ui.Common.Role]</th>
                            <RequirePermission AnyChapterPermission="@PermissionIdentifier.EditOfficers">
                                <th class="text-end text-nowrap">@I18n[I18nKey.Ui.ChapterDetail.OfficerActionColumn]</th>
                            </RequirePermission>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var officer in Detail.Officers) {
                            <tr>
                                <td>@officer.MemberFirstName @officer.MemberLastName</td>
                                <td>@RoleLabel(officer.AssociateType)</td>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.EditOfficers">
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger" type="button"
                                                aria-label="@I18n[I18nKey.Ui.ChapterDetail.RemoveOfficerAriaLabel]"
                                                @onclick="() => ConfirmRemoveOfficer(officer)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </RequirePermission>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            } else {
                <p class="text-secondary mb-0">@I18n[I18nKey.Ui.ChapterDetail.NoBoardMembers]</p>
            }
        </div>
    </div>

    @if (CanManageMarks()) {
        <div class="card mb-4" @key="MarksVersion">
            <div class="card-body">
                <h5>@I18n[I18nKey.Ui.ChapterMarks.CardTitle]</h5>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="mark-no-member-administration"
                           checked="@Detail.Chapter.NoMemberAdministration" disabled="@SavingMarks"
                           @onchange="args => ToggleMark(ChapterMark.NoMemberAdministration, (bool)args.Value!)" />
                    <label class="form-check-label" for="mark-no-member-administration">@I18n[I18nKey.Ui.ChapterMarks.BadgeNoMemberAdministration]</label>
                    <div class="form-text">@I18n[I18nKey.Ui.ChapterMarks.NoMemberAdministrationHint]</div>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="mark-unable-to-act"
                           checked="@Detail.Chapter.UnableToAct" disabled="@SavingMarks"
                           @onchange="args => ToggleMark(ChapterMark.UnableToAct, (bool)args.Value!)" />
                    <label class="form-check-label" for="mark-unable-to-act">@I18n[I18nKey.Ui.ChapterMarks.BadgeUnableToAct]</label>
                    <div class="form-text">@I18n[I18nKey.Ui.ChapterMarks.UnableToActHint]</div>
                </div>
            </div>
        </div>
    }

    @if (Detail.Children.Count > 0) {
        <div class="card mb-4">
            <div class="card-body">
                <h5>@I18n[I18nKey.Ui.ChapterDetail.ChildrenSection]</h5>
                <div class="list-group list-group-flush">
                    @foreach (var child in Detail.Children) {
                        <a href="/Administration/Chapters/@child.Id" class="list-group-item list-group-item-action">
                            @child.Name
                            @if (!string.IsNullOrEmpty(child.ShortCode)) {
                                <StatusBadge Tone="StatusTone.Neutral" Text="@child.ShortCode" Class="ms-1" />
                            }
                        </a>
                    }
                </div>
            </div>
        </div>
    }
}

<ConfirmDialog @ref="DeleteConfirm" Title="@I18n[I18nKey.Ui.ChapterDetail.DeleteDialogTitle]" ConfirmText="@I18n[I18nKey.Ui.ChapterDetail.DeleteDialogConfirm]" />
<ConfirmDialog @ref="ArchiveConfirm" Title="@I18n[I18nKey.Ui.ChapterDetail.ArchiveDialogTitle]" ConfirmText="@I18n[I18nKey.Ui.ChapterDetail.ArchiveDialogConfirm]" />
<ConfirmDialog @ref="UnarchiveConfirm" Title="@I18n[I18nKey.Ui.ChapterDetail.UnarchiveDialogTitle]" ConfirmText="@I18n[I18nKey.Ui.ChapterDetail.UnarchiveDialogConfirm]" />
<ConfirmDialog @ref="MarksConfirm" Title="@I18n[I18nKey.Ui.ChapterMarks.DialogTitle]" ConfirmText="@I18n[I18nKey.Ui.ChapterMarks.DialogConfirm]" />
<ConfirmDialog @ref="RemoveOfficerConfirm" Title="@I18n[I18nKey.Ui.ChapterDetail.RemoveOfficerDialogTitle]" ConfirmText="@I18n[I18nKey.Ui.ChapterDetail.RemoveOfficerDialogConfirm]" />
