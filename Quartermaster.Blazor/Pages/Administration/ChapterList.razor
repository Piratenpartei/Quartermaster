@page "/Administration/Chapters"
@using Quartermaster.Api
@using Quartermaster.Api.Chapters
@using Quartermaster.Api.I18n

<PageHeader Title="@I18n[I18nKey.Ui.ChapterList.PageTitle]">
    <Actions>
        <RequirePermission GlobalPermission="@PermissionIdentifier.CreateChapter">
            <a href="/Administration/Chapters/Create" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg"></i> @I18n[I18nKey.Ui.ChapterList.NewChapter]
            </a>
        </RequirePermission>
        <a href="/Administration/ChapterTree" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-diagram-3"></i> @I18n[I18nKey.Ui.ChapterList.TreeViewLink]
        </a>
    </Actions>
</PageHeader>

<div class="mb-3">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control" placeholder="@I18n[I18nKey.Ui.ChapterList.SearchPlaceholder]"
               @bind="SearchQuery" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
    </div>
</div>

@if (Loading) {
    <div class="d-flex justify-content-center my-4">
        <div class="spinner-border" role="status"></div>
    </div>
} else if (Response != null) {
    <div class="mb-2 text-secondary">
        @I18n[$"{I18nKey.Ui.ChapterList.TotalCount}?count={Response.TotalCount}"]
    </div>

    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.Common.Name]</th>
                <th>@I18n[I18nKey.Ui.ChapterList.ShortCodeColumn]</th>
                <th>@I18n[I18nKey.Ui.ChapterList.ExternalCodeColumn]</th>
                @if (AuthService.IsAuthenticated) {
                    <th>@I18n[I18nKey.Ui.ChapterList.ContactEmailColumn]</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var ch in Response.Items) {
                <tr>
                    <td>
                        <a href="/Administration/Chapters/@ch.Id">@ch.Name</a>
                        @if (ch.IsArchived) {
                            <StatusBadge Tone="StatusTone.Warning" Text="@I18n[I18nKey.Ui.ChapterDetail.ArchivedBadge]" Class="ms-1" />
                        }
                        <ChapterMarkBadges NoMemberAdministration="ch.NoMemberAdministration" UnableToAct="ch.UnableToAct" />
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(ch.ShortCode)) {
                            <StatusBadge Tone="StatusTone.Neutral" Text="@ch.ShortCode" />
                        } else {
                            <span class="text-secondary">-</span>
                        }
                    </td>
                    <td>
                        @if (ch.ExternalCodes.Count > 0) {
                            <code>@string.Join(", ", ch.ExternalCodes)</code>
                        } else {
                            <span class="text-secondary">-</span>
                        }
                    </td>
                    @if (AuthService.IsAuthenticated) {
                        <td>
                            @if (!string.IsNullOrEmpty(ch.ContactEmail)) {
                                <a href="mailto:@ch.ContactEmail">@ch.ContactEmail</a>
                            } else {
                                <span class="text-secondary">-</span>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    </div>

    <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="GoToPage" />
}
