@page "/Administration/Chapters/{ChapterId:guid}/AddOfficer"
@using Quartermaster.Api
@using Quartermaster.Api.ChapterAssociates
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Members

<PageBackLink Href="@($"/Administration/Chapters/{ChapterId}")" Text="@I18n[I18nKey.Ui.ChapterOfficerAdd.BackToChapter]" />

<h3 class="mb-3">@I18n[I18nKey.Ui.ChapterOfficerAdd.PageTitle]</h3>

<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.ChapterOfficerAdd.SearchSection]</h5>
        <div class="input-group mb-3">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="@I18n[I18nKey.Ui.ChapterOfficerAdd.SearchPlaceholder]"
                   @bind="SearchQuery" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        </div>

        @if (SearchLoading) {
            <LoadingSpinner Small="true" CssClass="my-3" />
        } else if (SearchResults != null) {
            @if (SearchResults.Items.Count == 0) {
                <EmptyState Message="@I18n[I18nKey.Ui.ChapterOfficerAdd.NoMembersFound]" />
            } else {
                <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>@I18n[I18nKey.Ui.ChapterOfficerAdd.MemberNumberColumn]</th>
                            <th>@I18n[I18nKey.Ui.Common.Name]</th>
                            <th>@I18n[I18nKey.Ui.ChapterOfficerAdd.CityColumn]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in SearchResults.Items) {
                            <tr class="@(SelectedMemberId == m.Id ? "table-active" : "")">
                                <td>@m.MemberNumber</td>
                                <td>@m.FirstName @m.LastName</td>
                                <td>@m.PostCode @m.City</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => SelectMember(m)">
                                        <i class="bi bi-check"></i> @I18n[I18nKey.Ui.ChapterOfficerAdd.SelectButton]
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        }
    </div>
</div>

@if (SelectedMember != null) {
    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.ChapterOfficerAdd.SelectedMemberSection]</h5>
            <p class="mb-2">
                <strong>@SelectedMember.FirstName @SelectedMember.LastName</strong>
                <span class="text-secondary">@I18n[$"{I18nKey.Ui.ChapterOfficerAdd.MemberNumberPrefix}?number={SelectedMember.MemberNumber}"]</span>
            </p>

            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="selectedRole" class="form-label">@I18n[I18nKey.Ui.ChapterOfficerAdd.RoleLabel]</label>
                    <select id="selectedRole" class="form-select" @bind="SelectedRole">
                        <option value="@ChapterOfficerType.Captain">@I18n[I18nKey.Ui.OfficerRole.Captain]</option>
                        <option value="@ChapterOfficerType.FirstOfficer">@I18n[I18nKey.Ui.OfficerRole.FirstOfficer]</option>
                        <option value="@ChapterOfficerType.Quartermaster">@I18n[I18nKey.Ui.OfficerRole.Quartermaster]</option>
                        <option value="@ChapterOfficerType.Treasurer">@I18n[I18nKey.Ui.OfficerRole.Treasurer]</option>
                        <option value="@ChapterOfficerType.ViceTreasurer">@I18n[I18nKey.Ui.OfficerRole.ViceTreasurer]</option>
                        <option value="@ChapterOfficerType.PoliticalDirector">@I18n[I18nKey.Ui.OfficerRole.PoliticalDirector]</option>
                        <option value="@ChapterOfficerType.Member">@I18n[I18nKey.Ui.OfficerRole.Member]</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <button class="btn btn-success" @onclick="AddOfficer" disabled="@Submitting">
                        @if (Submitting) {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span> @I18n[I18nKey.Ui.ChapterOfficerAdd.Adding]</span>
                        } else {
                            <i class="bi bi-plus-circle"></i>
                            <span> @I18n[I18nKey.Ui.Common.Add]</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}
