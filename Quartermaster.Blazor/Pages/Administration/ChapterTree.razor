@page "/Administration/ChapterTree"
@using Quartermaster.Api
@using Quartermaster.Api.Chapters
@using Quartermaster.Api.I18n

<PageHeader Title="@I18n[I18nKey.Ui.ChapterTree.PageTitle]">
    <Actions>
        <RequirePermission GlobalPermission="@PermissionIdentifier.CreateChapter">
            <a href="/Administration/Chapters/Create" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg"></i> @I18n[I18nKey.Ui.ChapterTree.NewChapter]
            </a>
        </RequirePermission>
        <a href="/Administration/Chapters" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-list-ul"></i> @I18n[I18nKey.Ui.ChapterTree.ListViewLink]
        </a>
    </Actions>
</PageHeader>

@if (RootNodes == null) {
    <LoadingSpinner />
} else {
    <div class="list-group">
        @foreach (var node in RootNodes) {
            <LazyTreeNode T="ChapterDTO" Node="node" LoadChildren="LoadChapterChildren">
                <ItemContent>
                    <span class="me-2">@context.Name</span>
                    @if (!string.IsNullOrEmpty(context.ShortCode)) {
                        <StatusBadge Tone="StatusTone.Neutral" Text="@context.ShortCode" Class="me-1" />
                    }
                    @if (context.ExternalCodes.Count > 0) {
                        <code class="small text-secondary">@string.Join(", ", context.ExternalCodes)</code>
                    }
                    @if (context.IsArchived) {
                        <StatusBadge Tone="StatusTone.Warning" Text="@I18n[I18nKey.Ui.ChapterDetail.ArchivedBadge]" Class="ms-1" />
                    }
                    <ChapterMarkBadges NoMemberAdministration="context.NoMemberAdministration" UnableToAct="context.UnableToAct" />
                </ItemContent>
            </LazyTreeNode>
        }
    </div>
}
