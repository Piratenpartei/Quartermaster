@page "/Administration/DueSelections"
@using Quartermaster.Api
@using Quartermaster.Api.DueSelector
@using Quartermaster.Api.I18n
@using System.Globalization

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.DueSelectionAdmin.PageTitle]</h3>
</div>

<div class="mb-3">
    <label for="status" class="form-label">@I18n[I18nKey.Ui.Common.Status]</label>
    <select id="status" class="form-select" style="width: auto;" @onchange="OnStatusChanged">
        <option value="">@I18n[I18nKey.Ui.DueSelectionAdmin.StatusAll]</option>
        <option value="0" selected>@I18n[I18nKey.Ui.DueSelectionAdmin.StatusPending]</option>
        <option value="1">@I18n[I18nKey.Ui.DueSelectionAdmin.StatusApproved]</option>
        <option value="2">@I18n[I18nKey.Ui.DueSelectionAdmin.StatusRejected]</option>
        <option value="3">@I18n[I18nKey.Ui.DueSelectionAdmin.StatusAutoApproved]</option>
    </select>
</div>

@if (Loading) {
    <LoadingSpinner />
} else if (Response != null) {
    <div class="mb-2 text-secondary">
        @I18n[$"{I18nKey.Ui.DueSelectionAdmin.TotalCount}?count={Response.TotalCount}"]
    </div>

    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.Common.Name]</th>
                <th>@I18n[I18nKey.Ui.Common.Email]</th>
                <th>@I18n[I18nKey.Ui.DueSelectionAdmin.SelectedDueColumn]</th>
                <th>@I18n[I18nKey.Ui.DueSelectionAdmin.ReducedAmountColumn]</th>
                <th>@I18n[I18nKey.Ui.DueSelectionAdmin.JustificationColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.Status]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ds in Response.Items) {
                <tr>
                    <td><a href="/Administration/DueSelections/@ds.Id">@ds.FirstName @ds.LastName</a></td>
                    <td>@ds.Email</td>
                    <td>@ds.SelectedDue.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</td>
                    <td>
                        @if (ds.SelectedValuation == SelectedValuation.Reduced) {
                            @ds.ReducedAmount.ToString("C2", CultureInfo.GetCultureInfo("de-de"))
                        } else {
                            <span class="text-secondary">—</span>
                        }
                    </td>
                    <td class="text-truncate" style="max-width: 250px;" title="@ds.ReducedJustification">
                        @(string.IsNullOrEmpty(ds.ReducedJustification) ? "—" : ds.ReducedJustification)
                    </td>
                    <td>
                        @if (ds.Status == DueSelectionStatus.Pending) {
                            <span class="badge border border-warning text-warning-emphasis">@I18n[I18nKey.Ui.DueSelectionAdmin.StatusPending]</span>
                        } else if (ds.Status == DueSelectionStatus.Approved) {
                            <span class="badge border border-success text-success-emphasis">@I18n[I18nKey.Ui.DueSelectionAdmin.StatusApproved]</span>
                        } else if (ds.Status == DueSelectionStatus.Rejected) {
                            <span class="badge border border-danger text-danger-emphasis">@I18n[I18nKey.Ui.DueSelectionAdmin.StatusRejected]</span>
                        } else {
                            <span class="badge border border-info text-info-emphasis">@I18n[I18nKey.Ui.DueSelectionAdmin.StatusAutoBadge]</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="GoToPage" />
}
