@page "/Administration/Events/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.AuditLog
@using Quartermaster.Api.Events
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.Events

<PageBackLink Href="/Administration/Events" />

@if (Loading) {
    <LoadingSpinner />
} else if (Event == null) {
    <div class="alert alert-danger">@I18n[I18nKey.Ui.EventDetail.NotFound]</div>
} else {
    var completedCount = Event.ChecklistItems.Count(i => i.IsCompleted);
    var totalCount = Event.ChecklistItems.Count;
    var allDone = totalCount > 0 && completedCount == totalCount;

    <div class="d-flex justify-content-between align-items-center mb-1">
        <div class="d-flex align-items-center gap-2">
            @if (EditingTitle) {
                <div class="input-group flex-grow-1">
                    <input type="text" class="form-control form-control-lg fw-bold"
                           @bind="Event.InternalName" @bind:event="oninput" />
                    <button class="btn btn-outline-primary" aria-label="@I18n[I18nKey.Ui.EventDetail.SaveAria]" @onclick="SaveTitleEdit">
                        <i class="bi bi-check-lg"></i>
                    </button>
                    <button class="btn btn-outline-secondary" aria-label="@I18n[I18nKey.Ui.EventDetail.CancelAria]" @onclick="() => EditingTitle = false">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            } else {
                <h3 class="mb-0">@Event.InternalName</h3>
                <button class="btn btn-sm btn-outline-secondary border-0" @onclick="() => EditingTitle = true"
                        title="@I18n[I18nKey.Ui.EventDetail.EditAria]" aria-label="@I18n[I18nKey.Ui.EventDetail.EditAria]">
                    <i class="bi bi-pencil"></i>
                </button>
            }
        </div>
        <div class="d-flex gap-2">
            @if (allDone) {
                <span class="badge border border-success text-success-emphasis fs-6">@I18n[I18nKey.Ui.EventDetail.DoneBadge]</span>
            } else if (totalCount > 0) {
                <span class="badge border border-secondary text-secondary-emphasis fs-6">@completedCount/@totalCount</span>
            }
            <EventStatusBadge Status="@Event.Status" />
            <EventVisibilityBadge Visibility="@Event.Visibility" />
        </div>
    </div>
    <div class="text-secondary mb-3">
        @Event.ChapterName
        @if (Event.EventDate != null) {
            <span> &mdash; <LocalTime DateValue="Event.EventDate" /></span>
        }
        <span> &mdash; @I18n[I18nKey.Ui.EventDetail.CreatedPrefix] <LocalTime Value="Event.CreatedAt" Format="dd.MM.yyyy" /></span>
    </div>

    <DirtyForm @ref="_detailsForm">
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col">
                        <label class="form-label small text-secondary">@I18n[I18nKey.Ui.EventDetail.PublicNameLabel]</label>
                        <FormInput @bind-Value="Event.PublicName" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label small text-secondary">@I18n[I18nKey.Ui.Common.Date]</label>
                        <FormInput Type="date" Value="@(Event.EventDate?.ToString("yyyy-MM-dd") ?? "")"
                                   ValueChanged="OnDateChanged" CssClass="w-auto" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label small text-secondary">@I18n[I18nKey.Ui.Common.Visibility]</label>
                        <FormSelect Value="@(((int)Event.Visibility).ToString())" ValueChanged="OnVisibilityChanged" CssClass="w-auto">
                            <option value="0">@I18n[I18nKey.Ui.EventVisibility.Public]</option>
                            <option value="1">@I18n[I18nKey.Ui.EventVisibility.MembersOnly]</option>
                            <option value="2">@I18n[I18nKey.Ui.EventVisibility.Private]</option>
                        </FormSelect>
                    </div>
                    <div class="col-auto d-flex align-items-end">
                        <FormSaveButton OnClick="SaveDetails" Saving="Saving"
                                        ButtonClass="btn-primary" Text="" SavingText="" />
                    </div>
                </div>
                <div class="row mb-1">
                    <div class="col-md-6">
                        <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.EventDetail.DescriptionMarkdownLabel]</label>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.EventDetail.PreviewLabel]</label>
                    </div>
                </div>
                <MarkdownEditor Value="@Event.Description" ValueChanged="OnDescriptionChanged" Rows="6" />
                <small class="text-secondary mt-1 d-block">
                    @I18n[$"{I18nKey.Ui.EventDetail.AvailableVariablesHint}?vars=%3Ccode%3E%7B%7Bdate%7D%7D%3C%2Fcode%3E+%2F+%3Ccode%3E%7B%7Bdatum%7D%7D%3C%2Fcode%3E"]
                </small>
            </div>
        </div>
    </DirtyForm>

    <EventChecklistEditor EventId="@Id" Event="@Event" OnChanged="@LoadEvent" OnBeforeAction="@SaveIfDirty" />

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.EventDetail.AuditLogTitle]</h5>
            @if (AuditLogs == null) {
                <div class="spinner-border spinner-border-sm" role="status"></div>
            } else if (AuditLogs.Count == 0) {
                <EmptyState Message="@I18n[I18nKey.Ui.Common.NoEntries]" />
            } else {
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>@I18n[I18nKey.Ui.EventDetail.AuditTimestampColumn]</th>
                                <th>@I18n[I18nKey.Ui.EventDetail.AuditActionColumn]</th>
                                <th>@I18n[I18nKey.Ui.EventDetail.AuditFieldColumn]</th>
                                <th>@I18n[I18nKey.Ui.EventDetail.AuditOldValueColumn]</th>
                                <th>@I18n[I18nKey.Ui.EventDetail.AuditNewValueColumn]</th>
                                <th>@I18n[I18nKey.Ui.EventDetail.AuditUserColumn]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in AuditLogs) {
                                <tr>
                                    <td class="text-nowrap"><LocalTime Value="log.Timestamp" /></td>
                                    <td>@log.Action</td>
                                    <td>@(log.FieldName ?? "-")</td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@log.OldValue">@(log.OldValue ?? "-")</td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@log.NewValue">@(log.NewValue ?? "-")</td>
                                    <td>@(log.UserDisplayName ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        @if (Event.Status == EventStatus.Draft) {
            <a href="/Administration/Events/@Id/SaveAsTemplate" class="btn btn-outline-secondary">
                <i class="bi bi-clipboard"></i> @I18n[I18nKey.Ui.EventDetail.SaveAsTemplate]
            </a>
        }
        @foreach (var transition in AllowedTransitions) {
            <button class="btn btn-outline-primary" @onclick="() => ChangeStatus(transition.Target)">
                <i class="bi @transition.Icon"></i> @I18n[transition.LabelKey]
            </button>
        }
    </div>

    <ConfirmDialog @ref="ConfirmDialog" />
}
