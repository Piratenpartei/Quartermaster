@page "/Administration/Events"
@using Quartermaster.Api
@using Quartermaster.Api.Events
@using Quartermaster.Api.I18n

<PageHeader Title="@I18n[I18nKey.Ui.EventList.PageTitle]">
    <Actions>
        <a href="/Administration/Events/Create" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-circle"></i> @I18n[I18nKey.Ui.EventList.NewEvent]
        </a>
        <a href="/Administration/EventTemplates" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-clipboard"></i> @I18n[I18nKey.Ui.EventList.FromTemplate]
        </a>
    </Actions>
</PageHeader>

<div class="mb-3 d-flex gap-3">
    <div>
        <ChapterPicker Value="@SelectedChapterIdString" ValueChanged="OnChapterFilterChanged" AllowEmpty="true" />
    </div>
    <div class="form-check d-flex align-items-center">
        <input class="form-check-input" type="checkbox" id="includeArchived"
               @onchange="OnIncludeArchivedChanged" />
        <label class="form-check-label ms-2" for="includeArchived">@I18n[I18nKey.Ui.EventList.IncludeArchived]</label>
    </div>
</div>

@if (Loading) {
    <LoadingSpinner />
} else if (Response != null) {
    <div class="mb-2 text-secondary">
        @I18n[$"{I18nKey.Ui.EventList.TotalCount}?count={Response.TotalCount}"]
    </div>

    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.EventList.PublicNameColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.Chapter]</th>
                <th>@I18n[I18nKey.Ui.Common.Status]</th>
                <th>@I18n[I18nKey.Ui.Common.Visibility]</th>
                <th>@I18n[I18nKey.Ui.Common.Date]</th>
                <th>@I18n[I18nKey.Ui.EventList.ProgressColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.Created]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Response.Items) {
                <tr>
                    <td><a href="/Administration/Events/@e.Id">@e.PublicName</a></td>
                    <td>@e.ChapterName</td>
                    <td><EventStatusBadge Status="@e.Status" /></td>
                    <td><EventVisibilityBadge Visibility="@e.Visibility" /></td>
                    <td><LocalTime DateValue="e.EventDate" /></td>
                    <td>
                        @if (e.ChecklistTotal > 0) {
                            <span>@e.ChecklistCompleted/@e.ChecklistTotal</span>
                        } else {
                            <span>—</span>
                        }
                    </td>
                    <td><LocalTime Value="e.CreatedAt" Format="dd.MM.yyyy" /></td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="GoToPage" />
}
