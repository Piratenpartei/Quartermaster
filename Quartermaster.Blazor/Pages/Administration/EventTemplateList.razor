@page "/Administration/EventTemplates"
@using Quartermaster.Api
@using Quartermaster.Api.Events
@using Quartermaster.Api.I18n

<PageHeader Title="@I18n[I18nKey.Ui.EventTemplateList.PageTitle]">
    <Actions>
        <a href="/Administration/Events" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> @I18n[I18nKey.Ui.EventTemplateList.BackToEvents]
        </a>
    </Actions>
</PageHeader>

@if (Loading) {
    <LoadingSpinner />
} else if (Templates != null && Templates.Count > 0) {
    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.Common.Name]</th>
                <th>@I18n[I18nKey.Ui.EventTemplateList.VariablesColumn]</th>
                <th>@I18n[I18nKey.Ui.EventTemplateList.ChecklistColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.Created]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var template in Templates) {
                <tr>
                    <td>@template.Name</td>
                    <td>@template.VariableCount</td>
                    <td>@template.ChecklistItemCount</td>
                    <td><LocalTime Value="template.CreatedAt" Format="dd.MM.yyyy" /></td>
                    <td class="text-end">
                        <a href="/Administration/Events/CreateFromTemplate/@template.Id"
                           class="btn btn-sm btn-primary me-1">
                            <i class="bi bi-plus-circle"></i> @I18n[I18nKey.Ui.EventTemplateList.CreateFromTemplate]
                        </a>
                        <DeleteButton OnClick="() => Delete(template.Id)" Disabled="@Deleting" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
} else {
    <EmptyState Message="@I18n[I18nKey.Ui.EventTemplateList.EmptyMessage]" />
}

<ConfirmDialog @ref="ConfirmDialog" />
