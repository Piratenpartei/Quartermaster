@page "/Administration/ImportStatus"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Members
@using Quartermaster.Api.AdministrativeDivisions

<PageHeader Title="@I18n[I18nKey.Ui.ImportStatus.PageTitle]" />

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@I18n[I18nKey.Ui.ImportStatus.MemberImportSection]</h5>
        <a href="/Administration/Members/Import" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-upload"></i> @I18n[I18nKey.Ui.ImportStatus.UploadCsvButton]
        </a>
    </div>
    <div class="card-body">
        @if (MemberLoading) {
            <LoadingSpinner Small="true" CssClass="my-3" />
        } else if (MemberHistory != null && MemberHistory.Items.Count > 0) {
            var latest = MemberHistory.Items[0];
            <div class="row g-3 mb-3">
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.LastImport]</span><br />
                    <LocalTime Value="latest.ImportedAt" />
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.FileLabel]</span><br />
                    @latest.FileName
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.DurationLabel]</span><br />
                    @FormatDuration(latest.DurationMs)
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.TotalLabel]</span><br />
                    @latest.TotalRecords
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.NewLabel]</span><br />
                    @latest.NewRecords
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.UpdatedLabel]</span><br />
                    @latest.UpdatedRecords
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.ErrorsLabel]</span><br />
                    @if (latest.ErrorCount > 0) {
                        <span class="badge bg-danger">@latest.ErrorCount</span>
                    } else {
                        <span class="badge bg-success">0</span>
                    }
                </div>
            </div>
            @if (latest.ErrorCount > 0 && latest.Errors != null) {
                <div class="bg-body-secondary p-2 rounded small font-monospace mb-3" style="max-height: 200px; overflow-y: auto;">
                    @foreach (var error in ParseErrors(latest.Errors)) {
                        <div>@error</div>
                    }
                </div>
            }
            <details>
                <summary class="text-secondary small" style="cursor: pointer;">@I18n[$"{I18nKey.Ui.ImportStatus.HistorySummary}?count={MemberHistory.TotalCount}"]</summary>
                <div class="table-responsive">
                <table class="table table-striped table-sm mt-2">
                    <thead>
                        <tr>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.TimestampColumn]</th>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.FileColumn]</th>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.DurationColumn]</th>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.TotalColumn]</th>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.NewColumn]</th>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.UpdatedColumn]</th>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.ErrorsColumn]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in MemberHistory.Items) {
                            <tr>
                                <td><LocalTime Value="log.ImportedAt" /></td>
                                <td>@log.FileName</td>
                                <td>@FormatDuration(log.DurationMs)</td>
                                <td>@log.TotalRecords</td>
                                <td>@log.NewRecords</td>
                                <td>@log.UpdatedRecords</td>
                                <td>
                                    @if (log.ErrorCount > 0) {
                                        <span class="badge bg-danger">@log.ErrorCount</span>
                                    } else {
                                        <span class="badge bg-success">0</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </details>
        } else {
            <p class="text-secondary mb-0">@I18n[I18nKey.Ui.ImportStatus.NoImportsYet]</p>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">@I18n[I18nKey.Ui.ImportStatus.AdminDivImportSection]</h5>
    </div>
    <div class="card-body">
        @if (AdminDivLoading) {
            <LoadingSpinner Small="true" CssClass="my-3" />
        } else if (AdminDivHistory != null && AdminDivHistory.Items.Count > 0) {
            var latest = AdminDivHistory.Items[0];
            <div class="row g-3 mb-3">
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.LastImport]</span><br />
                    <LocalTime Value="latest.ImportedAt" />
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.DurationLabel]</span><br />
                    @FormatDuration(latest.DurationMs)
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.TotalLabel]</span><br />
                    @latest.TotalRecords
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.AddedLabel]</span><br />
                    @latest.AddedRecords
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.UpdatedLabel]</span><br />
                    @latest.UpdatedRecords
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.RemovedLabel]</span><br />
                    @latest.RemovedRecords
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.RemappedLabel]</span><br />
                    @latest.RemappedRecords
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.OrphanedLabel]</span><br />
                    @if (latest.OrphanedRecords > 0) {
                        <span class="badge bg-warning text-dark">@latest.OrphanedRecords</span>
                    } else {
                        <span>0</span>
                    }
                </div>
                <div class="col-auto">
                    <span class="text-secondary small">@I18n[I18nKey.Ui.ImportStatus.ErrorsLabel]</span><br />
                    @if (latest.ErrorCount > 0) {
                        <span class="badge bg-danger">@latest.ErrorCount</span>
                    } else {
                        <span class="badge bg-success">0</span>
                    }
                </div>
            </div>
            @if (latest.Errors != null) {
                <div class="bg-body-secondary p-2 rounded small font-monospace mb-3" style="max-height: 200px; overflow-y: auto;">
                    @foreach (var line in latest.Errors.Split('\n')) {
                        <div>@line</div>
                    }
                </div>
            }
            <details>
                <summary class="text-secondary small" style="cursor: pointer;">@I18n[$"{I18nKey.Ui.ImportStatus.HistorySummary}?count={AdminDivHistory.TotalCount}"]</summary>
                <div class="table-responsive">
                <table class="table table-striped table-sm mt-2">
                    <thead>
                        <tr>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.TimestampColumn]</th>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.DurationColumn]</th>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.TotalColumn]</th>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.NewColumn]</th>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.UpdatedColumn]</th>
                            <th>@I18n[I18nKey.Ui.ImportStatus.RemovedLabel]</th>
                            <th>@I18n[I18nKey.Ui.ImportStatus.OrphanedLabel]</th>
                            <th>@I18n[I18nKey.Ui.MemberImportHistory.ErrorsColumn]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in AdminDivHistory.Items) {
                            <tr>
                                <td><LocalTime Value="log.ImportedAt" /></td>
                                <td>@FormatDuration(log.DurationMs)</td>
                                <td>@log.TotalRecords</td>
                                <td>@log.AddedRecords</td>
                                <td>@log.UpdatedRecords</td>
                                <td>@log.RemovedRecords</td>
                                <td>
                                    @if (log.OrphanedRecords > 0) {
                                        <span class="badge bg-warning text-dark">@log.OrphanedRecords</span>
                                    } else {
                                        <span>0</span>
                                    }
                                </td>
                                <td>
                                    @if (log.ErrorCount > 0) {
                                        <span class="badge bg-danger">@log.ErrorCount</span>
                                    } else {
                                        <span class="badge bg-success">0</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </details>
        } else {
            <p class="text-secondary mb-0">@I18n[I18nKey.Ui.ImportStatus.NoImportsYet]</p>
        }
    </div>
</div>
