@page "/Administration/LoginLockouts"
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Users

<PageHeader Title="@I18n[I18nKey.Ui.LoginLockouts.PageTitle]">
    <Actions>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Load" disabled="@Loading">
            <i class="bi bi-arrow-clockwise"></i> @I18n[I18nKey.Ui.LoginLockouts.RefreshButton]
        </button>
    </Actions>
</PageHeader>

@if (Loading) {
    <div class="d-flex justify-content-center my-4">
        <div class="spinner-border" role="status"></div>
    </div>
} else if (Response != null) {
    @if (Response.Items.Count == 0) {
        <p class="text-secondary">@I18n[I18nKey.Ui.LoginLockouts.NoneLocked]</p>
    } else {
        <div class="mb-2 text-secondary">
            @I18n[$"{I18nKey.Ui.LoginLockouts.TotalCount}?count={Response.Items.Count}"]
        </div>
        <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@I18n[I18nKey.Ui.LoginLockouts.IpAddressColumn]</th>
                    <th>@I18n[I18nKey.Ui.LoginLockouts.UserColumn]</th>
                    <th>@I18n[I18nKey.Ui.LoginLockouts.FailedAttemptsColumn]</th>
                    <th>@I18n[I18nKey.Ui.LoginLockouts.LastAttemptColumn]</th>
                    <th>@I18n[I18nKey.Ui.LoginLockouts.LockedUntilColumn]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lockout in Response.Items) {
                    <tr>
                        <td class="font-monospace">@lockout.IpAddress</td>
                        <td>@lockout.UsernameOrEmail</td>
                        <td><span class="badge bg-danger">@lockout.FailedAttempts</span></td>
                        <td><LocalTime Value="lockout.LastAttemptAt" Format="dd.MM.yyyy HH:mm:ss" /></td>
                        <td><LocalTime Value="lockout.LockedUntil" Format="dd.MM.yyyy HH:mm:ss" /></td>
                        <td>
                            <button class="btn btn-sm btn-outline-success"
                                    @onclick="() => Unlock(lockout)"
                                    disabled="@(UnlockingKey == $"{lockout.IpAddress}|{lockout.UsernameOrEmail}")">
                                @if (UnlockingKey == $"{lockout.IpAddress}|{lockout.UsernameOrEmail}") {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                } else {
                                    <i class="bi bi-unlock"></i>
                                    <span> @I18n[I18nKey.Ui.LoginLockouts.UnlockButton]</span>
                                }
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}
