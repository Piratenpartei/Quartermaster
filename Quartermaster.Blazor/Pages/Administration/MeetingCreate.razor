@page "/Administration/Meetings/Create"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Meetings
@inject I18nService I18n

<PageBackLink Href="/Administration/Meetings" />

<h3 class="mb-3">@I18n[I18nKey.Ui.MeetingCreate.PageTitle]</h3>

<div class="card">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">@I18n[I18nKey.Ui.Common.Chapter]</label>
            <ChapterPicker @bind-Value="ChapterId" />
        </div>
        <div class="mb-3">
            <label for="title" class="form-label">@I18n[I18nKey.Ui.Common.Title]</label>
            <input type="text" class="form-control" id="title" @bind="Title" maxlength="200" placeholder="@I18n[I18nKey.Ui.MeetingCreate.TitlePlaceholder]" />
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label for="meetingDate" class="form-label">@I18n[I18nKey.Ui.MeetingCreate.DateTimeLabel]</label>
                <input type="datetime-local" class="form-control" id="meetingDate" @bind="MeetingDate" />
            </div>
            <div class="col-md-6">
                <label for="location" class="form-label">@I18n[I18nKey.Ui.MeetingCreate.LocationLabel]</label>
                <input type="text" class="form-control" id="location" @bind="Location" maxlength="500" placeholder="@I18n[I18nKey.Ui.MeetingCreate.LocationPlaceholder]" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label d-block">@I18n[I18nKey.Ui.Common.Visibility]</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" id="visPublic" name="visibility"
                       checked="@(Visibility == MeetingVisibility.Public)"
                       @onchange="() => Visibility = MeetingVisibility.Public" />
                <label class="form-check-label" for="visPublic">@I18n[I18nKey.Ui.MeetingVisibility.Public]</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" id="visPrivate" name="visibility"
                       checked="@(Visibility == MeetingVisibility.Private)"
                       @onchange="() => Visibility = MeetingVisibility.Private" />
                <label class="form-check-label" for="visPrivate">@I18n[I18nKey.Ui.MeetingVisibility.Private]</label>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">@I18n[I18nKey.Ui.MeetingCreate.DescriptionMarkdownLabel]</label>
            <MarkdownEditorWithPreview @bind-Value="Description" Rows="6" />
        </div>
        <button class="btn btn-primary" @onclick="Submit" disabled="@Submitting">
            @if (Submitting) {
                <span class="spinner-border spinner-border-sm" role="status"></span>
                <span> @I18n[I18nKey.Ui.MeetingCreate.Submitting]</span>
            } else {
                <i class="bi bi-plus-circle"></i>
                <span> @I18n[I18nKey.Ui.MeetingCreate.SubmitButton]</span>
            }
        </button>
    </div>
</div>
