@page "/Administration/Meetings/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.AuditLog
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Meetings
@using Quartermaster.Blazor.Components.Meetings

<PageBackLink Href="/Administration/Meetings" />

@if (Loading) {
    <LoadingSpinner />
} else if (Meeting == null) {
    <div class="alert alert-danger">@I18n[I18nKey.Ui.MeetingDetail.NotFound]</div>
} else {
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h3 class="mb-0">@Meeting.Title</h3>
        <div class="d-flex gap-2">
            <MeetingStatusBadge Status="@Meeting.Status" />
            <MeetingVisibilityBadge Visibility="@Meeting.Visibility" />
        </div>
    </div>
    <div class="text-secondary mb-3">
        @Meeting.ChapterName
        @if (Meeting.MeetingDate != null) {
            <span> &mdash; <LocalTime DateValue="Meeting.MeetingDate" /></span>
        }
        @if (!string.IsNullOrEmpty(Meeting.Location)) {
            <span> &mdash; @Meeting.Location</span>
        }
    </div>

    @if (IsEditableMode) {
        <DirtyForm @ref="_detailsForm">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3 mb-2">
                        <div class="col-md-4">
                            <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.Common.Title]</label>
                            <FormInput Value="@Meeting.Title" ValueChanged="OnTitleChanged" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.MeetingDetail.DateTimeLabel]</label>
                            <FormInput Type="datetime-local"
                                       Value="@(Meeting.MeetingDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")"
                                       ValueChanged="OnDateChanged" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.MeetingDetail.LocationLabel]</label>
                            <FormInput Value="@(Meeting.Location ?? "")" ValueChanged="OnLocationChanged" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.Common.Visibility]</label>
                            <FormSelect Value="@(((int)Meeting.Visibility).ToString())" ValueChanged="OnVisibilityChanged">
                                <option value="0">@I18n[I18nKey.Ui.MeetingVisibility.Public]</option>
                                <option value="1">@I18n[I18nKey.Ui.MeetingVisibility.Private]</option>
                            </FormSelect>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <FormSaveButton OnClick="SaveMeta" Saving="SavingMeta" />
                        </div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.MeetingDetail.DescriptionMarkdownLabel]</label>
                    </div>
                    <MarkdownEditorWithPreview Value="@(Meeting.Description ?? "")" ValueChanged="OnDescriptionChanged" Rows="4" />
                </div>
            </div>
        </DirtyForm>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "agenda" ? "active" : "")" @onclick="@(() => ActiveTab = "agenda")">
                @I18n[I18nKey.Ui.MeetingDetail.TabAgenda]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "protocol" ? "active" : "")" @onclick="@(() => OnTabChanged("protocol"))">
                @I18n[I18nKey.Ui.MeetingDetail.TabProtocol]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "audit" ? "active" : "")" @onclick="@(() => OnTabChanged("audit"))">
                @I18n[I18nKey.Ui.MeetingDetail.TabAudit]
            </button>
        </li>
    </ul>

    @if (ActiveTab == "agenda") {
        @if (IsEditableMode) {
            <AgendaItemListEditor MeetingId="@Id" Meeting="@Meeting" OnChanged="@LoadMeeting" />
        } else {
            <div class="card">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.MeetingDetail.AgendaCardTitle]</h5>
                    <AgendaItemTree Items="@Meeting.AgendaItems" Mode="AgendaTreeMode.ReadOnly" />
                </div>
            </div>
        }
    } else if (ActiveTab == "protocol") {
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">@I18n[I18nKey.Ui.MeetingDetail.ProtocolCardTitle]</h5>
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-secondary" href="@($"/api/meetings/{Id}/protocol?format=md{(RequiresDraft ? "&draft=true" : "")}")" target="_blank">
                            <i class="bi bi-download"></i> @I18n[I18nKey.Ui.MeetingDetail.ProtocolDownloadMarkdown]
                        </a>
                        <a class="btn btn-sm btn-outline-secondary" href="@($"/api/meetings/{Id}/protocol?format=pdf{(RequiresDraft ? "&draft=true" : "")}")" target="_blank">
                            <i class="bi bi-file-earmark-pdf"></i> @I18n[I18nKey.Ui.MeetingDetail.ProtocolDownloadPdf]
                        </a>
                    </div>
                </div>
                @if (ProtocolLoading) {
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                } else if (!string.IsNullOrEmpty(ProtocolHtml)) {
                    @((MarkupString)ProtocolHtml)
                } else {
                    <p class="text-secondary">@I18n[I18nKey.Ui.MeetingDetail.ProtocolUnavailable]</p>
                }
            </div>
        </div>
    } else if (ActiveTab == "audit") {
        <div class="card">
            <div class="card-body">
                <h5>@I18n[I18nKey.Ui.MeetingDetail.AuditCardTitle]</h5>
                @if (AuditLogs == null) {
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                } else if (AuditLogs.Count == 0) {
                    <EmptyState Message="@I18n[I18nKey.Ui.Common.NoEntries]" />
                } else {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>@I18n[I18nKey.Ui.MeetingDetail.AuditTimestampColumn]</th>
                                    <th>@I18n[I18nKey.Ui.MeetingDetail.AuditActionColumn]</th>
                                    <th>@I18n[I18nKey.Ui.MeetingDetail.AuditFieldColumn]</th>
                                    <th>@I18n[I18nKey.Ui.MeetingDetail.AuditOldValueColumn]</th>
                                    <th>@I18n[I18nKey.Ui.MeetingDetail.AuditNewValueColumn]</th>
                                    <th>@I18n[I18nKey.Ui.MeetingDetail.AuditUserColumn]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in AuditLogs) {
                                    <tr>
                                        <td class="text-nowrap"><LocalTime Value="log.Timestamp" /></td>
                                        <td>@log.Action</td>
                                        <td>@(log.FieldName ?? "-")</td>
                                        <td class="text-truncate" style="max-width: 200px;" title="@log.OldValue">@(log.OldValue ?? "-")</td>
                                        <td class="text-truncate" style="max-width: 200px;" title="@log.NewValue">@(log.NewValue ?? "-")</td>
                                        <td>@(log.UserDisplayName ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <div class="d-flex gap-2 flex-wrap mt-3">
        @if (Meeting.Status == MeetingStatus.InProgress) {
            <a href="/Administration/Meetings/@Id/Live" class="btn btn-outline-warning">
                <i class="bi bi-broadcast"></i> @I18n[I18nKey.Ui.MeetingDetail.GoToLiveMeeting]
            </a>
        }
        @if (Meeting.Status == MeetingStatus.Archived && !string.IsNullOrEmpty(Meeting.ArchivedPdfPath)) {
            <a class="btn btn-outline-primary" href="@($"/api/meetings/{Id}/protocol?format=pdf")" target="_blank">
                <i class="bi bi-file-earmark-pdf"></i> @I18n[I18nKey.Ui.MeetingDetail.DownloadPdfSnapshot]
            </a>
        }
        @foreach (var transition in AllowedTransitions) {
            <button class="btn btn-outline-primary" @onclick="() => ChangeStatus(transition.Target)">
                <i class="bi @transition.Icon"></i> @transition.Label
            </button>
        }
        @if (Meeting.Status == MeetingStatus.Draft) {
            <DeleteButton OnClick="DeleteMeeting" Small="false" CssClass="ms-auto" />
        }
    </div>

    <ConfirmDialog @ref="ConfirmDialog" />
}
