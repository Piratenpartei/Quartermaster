@page "/Administration/Meetings"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Meetings
@inject I18nService I18n

<PageHeader Title="@I18n[I18nKey.Ui.MeetingList.PageTitle]">
    <Actions>
        <a href="/Administration/Meetings/Create" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-circle"></i> @I18n[I18nKey.Ui.MeetingList.NewMeeting]
        </a>
    </Actions>
</PageHeader>

<div class="mb-3 d-flex gap-3 flex-wrap align-items-end">
    <div style="min-width: 220px;">
        <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.Common.Chapter]</label>
        <ChapterPicker Value="@SelectedChapterIdString" ValueChanged="OnChapterFilterChanged" AllowEmpty="true" />
    </div>
    <div>
        <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.Common.Status]</label>
        <select class="form-select" value="@StatusFilter" @onchange="OnStatusFilterChanged">
            <option value="">@I18n[I18nKey.Ui.MeetingStatus.All]</option>
            <option value="0">@I18n[I18nKey.Ui.MeetingStatus.Draft]</option>
            <option value="1">@I18n[I18nKey.Ui.MeetingStatus.Scheduled]</option>
            <option value="2">@I18n[I18nKey.Ui.MeetingStatus.InProgress]</option>
            <option value="3">@I18n[I18nKey.Ui.MeetingStatus.Completed]</option>
            <option value="4">@I18n[I18nKey.Ui.MeetingStatus.Archived]</option>
        </select>
    </div>
    <div>
        <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.Common.Visibility]</label>
        <select class="form-select" value="@VisibilityFilter" @onchange="OnVisibilityFilterChanged">
            <option value="">@I18n[I18nKey.Ui.MeetingVisibility.All]</option>
            <option value="0">@I18n[I18nKey.Ui.MeetingVisibility.Public]</option>
            <option value="1">@I18n[I18nKey.Ui.MeetingVisibility.Private]</option>
        </select>
    </div>
    <div>
        <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.MeetingList.DateFromLabel]</label>
        <input type="date" class="form-control" value="@DateFromFilter" @onchange="OnDateFromChanged" />
    </div>
    <div>
        <label class="form-label small text-secondary mb-0">@I18n[I18nKey.Ui.MeetingList.DateToLabel]</label>
        <input type="date" class="form-control" value="@DateToFilter" @onchange="OnDateToChanged" />
    </div>
</div>

@if (Loading) {
    <LoadingSpinner />
} else if (Response != null) {
    <div class="mb-2 text-secondary">
        @I18n[$"{I18nKey.Ui.MeetingList.TotalCount}?count={Response.TotalCount}"]
    </div>

    @if (Response.Items.Count == 0) {
        <EmptyState Message="@I18n[I18nKey.Ui.MeetingList.EmptyMessage]" />
    } else {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>@I18n[I18nKey.Ui.Common.Title]</th>
                        <th>@I18n[I18nKey.Ui.Common.Chapter]</th>
                        <th>@I18n[I18nKey.Ui.Common.Date]</th>
                        <th>@I18n[I18nKey.Ui.Common.Status]</th>
                        <th>@I18n[I18nKey.Ui.Common.Visibility]</th>
                        <th>@I18n[I18nKey.Ui.MeetingList.AgendaItemsColumn]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Response.Items) {
                        <tr>
                            <td><a href="/Administration/Meetings/@m.Id">@m.Title</a></td>
                            <td>@m.ChapterName</td>
                            <td><LocalTime DateValue="m.MeetingDate" /></td>
                            <td><MeetingStatusBadge Status="@m.Status" /></td>
                            <td><MeetingVisibilityBadge Visibility="@m.Visibility" /></td>
                            <td>@m.AgendaItemCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="GoToPage" />
    }
}
