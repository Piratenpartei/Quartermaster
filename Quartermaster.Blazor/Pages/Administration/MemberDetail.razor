@page "/Administration/Members/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Members
@using System.Globalization

<PageBackLink Href="/Administration/Members">
    <Links>
        @if (Member?.ViewableUserId != null) {
            <a href="/Administration/Users/@Member.ViewableUserId" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-person-gear"></i> @I18n[I18nKey.Ui.LinkedPages.UserAccount]
            </a>
        }
    </Links>
</PageBackLink>

@if (Loading) {
    <LoadingSpinner />
} else if (Member == null) {
    <div class="alert alert-danger">@I18n[I18nKey.Ui.MemberDetail.NotFound]</div>
} else {
    <PageHeader Title="@($"{Member.FirstName} {Member.LastName}")">
        <Subtitle>
            @if (Member.IsFloating) {
                <span>@(Member.AdmissionReference ?? "-")</span>
            } else {
                <span>@I18n[$"{I18nKey.Ui.MemberDetail.MemberNumberPrefix}?number={Member.MemberNumber}"]</span>
            }
        @if (Member.IsFloating) {
            <StatusBadge Tone="StatusTone.Info" Text="@I18n[I18nKey.Ui.MemberDetail.FloatingBadge]" />
        } else if (Member.IsExited) {
            <StatusBadge Tone="StatusTone.Danger" Text="@I18n[I18nKey.Ui.MemberDetail.StatusExited]" />
        } else if (Member.IsPending) {
            <StatusBadge Tone="StatusTone.Warning" Text="@I18n[I18nKey.Ui.MemberDetail.StatusPending]" />
        } else {
            <StatusBadge Tone="StatusTone.Success" Text="@I18n[I18nKey.Ui.MemberDetail.StatusActive]" />
        }
        </Subtitle>
    </PageHeader>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.PersonalDataSection]</h5>
            <dl class="row mb-0">
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.Common.FirstName]</dt>
                    <dd class="col-sm-8">@Member.FirstName</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.Common.LastName]</dt>
                    <dd class="col-sm-8">@Member.LastName</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.DateOfBirthLabel]</dt>
                    <dd class="col-sm-8"><LocalTime DateValue="Member.DateOfBirth" /></dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.CitizenshipLabel]</dt>
                    <dd class="col-sm-8">@(Member.Citizenship ?? "-")</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.Common.Email]</dt>
                    <dd class="col-sm-8">@(Member.Email ?? "-")</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.Common.Phone]</dt>
                    <dd class="col-sm-8">@(Member.Phone ?? "-")</dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.AddressSection]</h5>
            <dl class="row mb-0">
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.StreetLabel]</dt>
                    <dd class="col-sm-8">@(Member.Street ?? "-")</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.PostCodeCityLabel]</dt>
                    <dd class="col-sm-8">@Member.PostCode @Member.City</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.CountryLabel]</dt>
                    <dd class="col-sm-8">@(Member.Country ?? "-")</dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.AdminDivisionLabel]</dt>
                        <dd class="col-sm-8">
                            @if (Member.IsAdminDivisionOrphaned) {
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span>@Member.ResidenceAdministrativeDivisionName</span>
                                    @if (!string.IsNullOrEmpty(Member.ResidenceAdministrativeDivisionAdminCode)) {
                                        <span class="badge border text-secondary-emphasis">@Member.ResidenceAdministrativeDivisionAdminCode</span>
                                    }
                                    <span class="badge rounded-pill border bg-warning-subtle text-warning-emphasis border-warning-subtle">
                                        <i class="bi bi-exclamation-triangle"></i> @I18n[I18nKey.Ui.MemberDetail.OrphanedBadge]
                                    </span>
                                </div>
                                <div class="d-flex flex-wrap align-items-end gap-2">
                                    <div class="flex-grow-1">
                                        <AdminDivisionPicker Value="@NewAdminDivId" ValueChanged="OnAdminDivChanged" />
                                    </div>
                                    <button class="btn btn-sm btn-primary" @onclick="SaveAdminDivision" disabled="@(string.IsNullOrEmpty(NewAdminDivId) || SavingAdminDiv)">
                                        @if (SavingAdminDiv) {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                        } else {
                                            <span>@I18n[I18nKey.Ui.MemberDetail.AssignButton]</span>
                                        }
                                    </button>
                                </div>
                            } else if (string.IsNullOrEmpty(Member.ResidenceAdministrativeDivisionName)) {
                                <span>-</span>
                            } else {
                                <span>@Member.ResidenceAdministrativeDivisionName</span>
                                @if (!string.IsNullOrEmpty(Member.ResidenceAdministrativeDivisionAdminCode)) {
                                    <span class="badge border text-secondary-emphasis ms-2">@Member.ResidenceAdministrativeDivisionAdminCode</span>
                                }
                            }
                        </dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.ChapterSection]</h5>
            <dl class="row mb-0">
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.Common.Chapter]</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Member.ChapterName) ? "-" : Member.ChapterName)</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.FederalStateLabel]</dt>
                    <dd class="col-sm-8">@(Member.FederalState ?? "-")</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.CountyLabel]</dt>
                    <dd class="col-sm-8">@(Member.County ?? "-")</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.MunicipalityLabel]</dt>
                    <dd class="col-sm-8">@(Member.Municipality ?? "-")</dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.MembershipSection]</h5>
            <dl class="row mb-0">
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.EntryDateLabel]</dt>
                    <dd class="col-sm-8"><LocalTime DateValue="Member.EntryDate" /></dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.ExitDateLabel]</dt>
                    <dd class="col-sm-8"><LocalTime DateValue="Member.ExitDate" /></dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.AdmissionReferenceLabel]</dt>
                    <dd class="col-sm-8">@(Member.AdmissionReference ?? "-")</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.FeeLabel]</dt>
                    <dd class="col-sm-8">@Member.MembershipFee.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.ReducedFeeLabel]</dt>
                    <dd class="col-sm-8">@Member.ReducedFee.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</dd>
                    @if (Member.FirstFee.HasValue) {
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.FirstFeeLabel]</dt>
                        <dd class="col-sm-8">@Member.FirstFee.Value.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</dd>
                    }
                    @if (Member.ReducedFeeEnd.HasValue) {
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.ReducedFeeEndLabel]</dt>
                        <dd class="col-sm-8"><LocalTime DateValue="Member.ReducedFeeEnd" /></dd>
                    }
                    @if (Member.OpenFeeTotal.HasValue) {
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.OpenFeesLabel]</dt>
                        <dd class="col-sm-8">@Member.OpenFeeTotal.Value.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</dd>
                    }
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.PreferencesSection]</h5>
            <dl class="row mb-0">
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.VotingRightsLabel]</dt>
                        <dd class="col-sm-8">
                            @if (Member.HasVotingRights) {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            } else {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            }
                        </dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.SurveysLabel]</dt>
                        <dd class="col-sm-8">
                            @if (Member.ReceivesSurveys) {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            } else {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            }
                        </dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.ActionsLabel]</dt>
                        <dd class="col-sm-8">
                            @if (Member.ReceivesActions) {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            } else {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            }
                        </dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.NewsletterLabel]</dt>
                        <dd class="col-sm-8">
                            @if (Member.ReceivesNewsletter) {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            } else {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            }
                        </dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.PostBounceLabel]</dt>
                        <dd class="col-sm-8">
                            @if (Member.PostBounce) {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            } else {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            }
                        </dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.SystemSection]</h5>
            <dl class="row mb-0">
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.LinkedUserLabel]</dt>
                    <dd class="col-sm-8">@(Member.UserId.HasValue ? Member.UserId.ToString() : I18n[I18nKey.Ui.MemberDetail.NotLinked])</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.MemberDetail.LastImportLabel]</dt>
                    <dd class="col-sm-8"><LocalTime Value="Member.LastImportedAt" /></dd>
            </dl>
        </div>
    </div>

    @if (!AuditUnavailable) {
        <div class="card mb-4">
            <div class="card-body">
                <h5>@I18n[I18nKey.Ui.MemberDetail.AuditLogSection]</h5>
                @if (AuditLogs == null) {
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                } else if (AuditLogs.Count == 0) {
                    <EmptyState Message="@I18n[I18nKey.Ui.Common.NoEntries]" />
                } else {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>@I18n[I18nKey.Ui.MemberDetail.AuditTimestampColumn]</th>
                                    <th>@I18n[I18nKey.Ui.MemberDetail.AuditActionColumn]</th>
                                    <th>@I18n[I18nKey.Ui.MemberDetail.AuditFieldColumn]</th>
                                    <th>@I18n[I18nKey.Ui.MemberDetail.AuditOldValueColumn]</th>
                                    <th>@I18n[I18nKey.Ui.MemberDetail.AuditNewValueColumn]</th>
                                    <th>@I18n[I18nKey.Ui.MemberDetail.AuditUserColumn]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in AuditLogs) {
                                    <tr>
                                        <td class="text-nowrap"><LocalTime Value="log.Timestamp" /></td>
                                        <td>@log.Action</td>
                                        <td>@(log.FieldName ?? "-")</td>
                                        <td class="text-truncate" style="max-width: 200px;" title="@log.OldValue">@(log.OldValue ?? "-")</td>
                                        <td class="text-truncate" style="max-width: 200px;" title="@log.NewValue">@(log.NewValue ?? "-")</td>
                                        <td>@(log.UserDisplayName ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}
