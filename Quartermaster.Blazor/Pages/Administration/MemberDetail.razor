@page "/Administration/Members/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Members
@using System.Globalization

<PageBackLink Href="/Administration/Members" />

@if (Loading) {
    <LoadingSpinner />
} else if (Member == null) {
    <div class="alert alert-danger">@I18n[I18nKey.Ui.MemberDetail.NotFound]</div>
} else {
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3>@Member.FirstName @Member.LastName</h3>
            <span class="text-secondary">@I18n[$"{I18nKey.Ui.MemberDetail.MemberNumberPrefix}?number={Member.MemberNumber}"]</span>
        </div>
        @if (Member.ExitDate != null) {
            <span class="badge border border-danger text-danger-emphasis fs-6">@I18n[I18nKey.Ui.MemberDetail.StatusExited]</span>
        } else if (Member.IsPending) {
            <span class="badge border border-warning text-warning-emphasis fs-6">@I18n[I18nKey.Ui.MemberDetail.StatusPending]</span>
        } else {
            <span class="badge border border-success text-success-emphasis fs-6">@I18n[I18nKey.Ui.MemberDetail.StatusActive]</span>
        }
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.PersonalDataSection]</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">@I18n[I18nKey.Ui.Common.FirstName]</th><td>@Member.FirstName</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.Common.LastName]</th><td>@Member.LastName</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.DateOfBirthLabel]</th><td><LocalTime DateValue="Member.DateOfBirth" /></td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.CitizenshipLabel]</th><td>@(Member.Citizenship ?? "—")</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.Common.Email]</th><td>@(Member.Email ?? "—")</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.Common.Phone]</th><td>@(Member.Phone ?? "—")</td></tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.AddressSection]</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">@I18n[I18nKey.Ui.MemberDetail.StreetLabel]</th><td>@(Member.Street ?? "—")</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.PostCodeCityLabel]</th><td>@Member.PostCode @Member.City</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.CountryLabel]</th><td>@(Member.Country ?? "—")</td></tr>
                    <tr>
                        <th>@I18n[I18nKey.Ui.MemberDetail.AdminDivisionLabel]</th>
                        <td>
                            @if (Member.IsAdminDivisionOrphaned) {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span>@Member.ResidenceAdministrativeDivisionName</span>
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-exclamation-triangle"></i> @I18n[I18nKey.Ui.MemberDetail.OrphanedBadge]
                                    </span>
                                </div>
                                <div class="d-flex align-items-end gap-2">
                                    <div class="flex-grow-1">
                                        <AdminDivisionPicker Value="@NewAdminDivId" ValueChanged="OnAdminDivChanged" />
                                    </div>
                                    <button class="btn btn-sm btn-primary" @onclick="SaveAdminDivision" disabled="@(string.IsNullOrEmpty(NewAdminDivId) || SavingAdminDiv)">
                                        @if (SavingAdminDiv) {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                        } else {
                                            <span>@I18n[I18nKey.Ui.MemberDetail.AssignButton]</span>
                                        }
                                    </button>
                                </div>
                            } else {
                                @(string.IsNullOrEmpty(Member.ResidenceAdministrativeDivisionName) ? "—" : Member.ResidenceAdministrativeDivisionName)
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.ChapterSection]</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">@I18n[I18nKey.Ui.Common.Chapter]</th><td>@(string.IsNullOrEmpty(Member.ChapterName) ? "—" : Member.ChapterName)</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.FederalStateLabel]</th><td>@(Member.FederalState ?? "—")</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.CountyLabel]</th><td>@(Member.County ?? "—")</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.MunicipalityLabel]</th><td>@(Member.Municipality ?? "—")</td></tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.MembershipSection]</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">@I18n[I18nKey.Ui.MemberDetail.EntryDateLabel]</th><td><LocalTime DateValue="Member.EntryDate" /></td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.ExitDateLabel]</th><td><LocalTime DateValue="Member.ExitDate" /></td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.AdmissionReferenceLabel]</th><td>@(Member.AdmissionReference ?? "—")</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.FeeLabel]</th><td>@Member.MembershipFee.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.ReducedFeeLabel]</th><td>@Member.ReducedFee.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</td></tr>
                    @if (Member.FirstFee.HasValue) {
                        <tr><th>@I18n[I18nKey.Ui.MemberDetail.FirstFeeLabel]</th><td>@Member.FirstFee.Value.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</td></tr>
                    }
                    @if (Member.ReducedFeeEnd.HasValue) {
                        <tr><th>@I18n[I18nKey.Ui.MemberDetail.ReducedFeeEndLabel]</th><td><LocalTime DateValue="Member.ReducedFeeEnd" /></td></tr>
                    }
                    @if (Member.OpenFeeTotal.HasValue) {
                        <tr><th>@I18n[I18nKey.Ui.MemberDetail.OpenFeesLabel]</th><td>@Member.OpenFeeTotal.Value.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</td></tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.PreferencesSection]</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr>
                        <th style="width:200px">@I18n[I18nKey.Ui.MemberDetail.VotingRightsLabel]</th>
                        <td>
                            @if (Member.HasVotingRights) {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            } else {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>@I18n[I18nKey.Ui.MemberDetail.SurveysLabel]</th>
                        <td>
                            @if (Member.ReceivesSurveys) {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            } else {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>@I18n[I18nKey.Ui.MemberDetail.ActionsLabel]</th>
                        <td>
                            @if (Member.ReceivesActions) {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            } else {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>@I18n[I18nKey.Ui.MemberDetail.NewsletterLabel]</th>
                        <td>
                            @if (Member.ReceivesNewsletter) {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            } else {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>@I18n[I18nKey.Ui.MemberDetail.PostBounceLabel]</th>
                        <td>
                            @if (Member.PostBounce) {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            } else {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.SystemSection]</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">@I18n[I18nKey.Ui.MemberDetail.LinkedUserLabel]</th><td>@(Member.UserId.HasValue ? Member.UserId.ToString() : I18n[I18nKey.Ui.MemberDetail.NotLinked])</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.MemberDetail.LastImportLabel]</th><td><LocalTime Value="Member.LastImportedAt" /></td></tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.MemberDetail.AuditLogSection]</h5>
            @if (AuditLogs == null) {
                <div class="spinner-border spinner-border-sm" role="status"></div>
            } else if (AuditLogs.Count == 0) {
                <EmptyState Message="@I18n[I18nKey.Ui.Common.NoEntries]" />
            } else {
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>@I18n[I18nKey.Ui.MemberDetail.AuditTimestampColumn]</th>
                                <th>@I18n[I18nKey.Ui.MemberDetail.AuditActionColumn]</th>
                                <th>@I18n[I18nKey.Ui.MemberDetail.AuditFieldColumn]</th>
                                <th>@I18n[I18nKey.Ui.MemberDetail.AuditOldValueColumn]</th>
                                <th>@I18n[I18nKey.Ui.MemberDetail.AuditNewValueColumn]</th>
                                <th>@I18n[I18nKey.Ui.MemberDetail.AuditUserColumn]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in AuditLogs) {
                                <tr>
                                    <td class="text-nowrap"><LocalTime Value="log.Timestamp" /></td>
                                    <td>@log.Action</td>
                                    <td>@(log.FieldName ?? "-")</td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@log.OldValue">@(log.OldValue ?? "-")</td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@log.NewValue">@(log.NewValue ?? "-")</td>
                                    <td>@(log.UserDisplayName ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
