@page "/Administration/Members/Import"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Members
@using Microsoft.AspNetCore.Components.Forms

<PageBackLink Href="/Administration/Members" Text="@I18n[I18nKey.Ui.MemberImportHistory.BackToMembers]" />

<PageHeader Title="@I18n[I18nKey.Ui.MemberImportHistory.PageTitle]">
    <Actions>
        <button class="btn btn-primary" @onclick="TriggerImport" disabled="@Importing">
            @if (Importing) {
                <span class="spinner-border spinner-border-sm" role="status"></span>
                <span> @I18n[I18nKey.Ui.MemberImportHistory.Importing]</span>
            } else {
                <i class="bi bi-download"></i>
                <span> @I18n[I18nKey.Ui.MemberImportHistory.ManualImport]</span>
            }
        </button>
    </Actions>
</PageHeader>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title mb-3">@I18n[I18nKey.Ui.MemberImportHistory.UploadCardTitle]</h5>
        <div class="d-flex align-items-end gap-3">
            <div class="flex-grow-1">
                <label class="form-label small text-secondary">@I18n[I18nKey.Ui.MemberImportHistory.ChooseCsvFile]</label>
                <InputFile class="form-control" OnChange="OnFileSelected" accept=".csv" disabled="@Uploading" />
            </div>
            <button class="btn btn-primary" @onclick="UploadFile" disabled="@(SelectedFile == null || Uploading)">
                @if (Uploading) {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span> @I18n[I18nKey.Ui.MemberImportHistory.Importing]</span>
                } else {
                    <i class="bi bi-upload"></i>
                    <span> @I18n[I18nKey.Ui.MemberImportHistory.UploadAndImport]</span>
                }
            </button>
        </div>
        @if (SelectedFile != null) {
            <div class="mt-2 small text-secondary">
                @SelectedFile.Name (@FormatFileSize(SelectedFile.Size))
            </div>
        }
    </div>
</div>

@if (ImportResult != null) {
    <div class="alert alert-info alert-dismissible mb-3">
        <button type="button" class="btn-close" @onclick="() => ImportResult = null"></button>
        @I18n[$"{I18nKey.Ui.MemberImportHistory.ImportFinished}?total={ImportResult.TotalRecords}&new={ImportResult.NewRecords}&updated={ImportResult.UpdatedRecords}&errors={ImportResult.ErrorCount}&duration={ImportResult.DurationMs}"]
    </div>
}

@if (Loading) {
    <LoadingSpinner />
} else if (Response != null) {
    @if (Response.Items.Count == 0) {
        <p class="text-secondary">@I18n[I18nKey.Ui.MemberImportHistory.NoImportsYet]</p>
    } else {
        <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>@I18n[I18nKey.Ui.MemberImportHistory.TimestampColumn]</th>
                    <th>@I18n[I18nKey.Ui.MemberImportHistory.FileColumn]</th>
                    <th>@I18n[I18nKey.Ui.MemberImportHistory.DurationColumn]</th>
                    <th>@I18n[I18nKey.Ui.MemberImportHistory.TotalColumn]</th>
                    <th>@I18n[I18nKey.Ui.MemberImportHistory.NewColumn]</th>
                    <th>@I18n[I18nKey.Ui.MemberImportHistory.UpdatedColumn]</th>
                    <th>@I18n[I18nKey.Ui.MemberImportHistory.ErrorsColumn]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Response.Items) {
                    <tr>
                        <td><LocalTime Value="log.ImportedAt" /></td>
                        <td>@log.FileName</td>
                        <td>@FormatDuration(log.DurationMs)</td>
                        <td>@log.TotalRecords</td>
                        <td>@log.NewRecords</td>
                        <td>@log.UpdatedRecords</td>
                        <td>
                            @if (log.ErrorCount > 0) {
                                <button class="badge border border-danger text-danger-emphasis btn p-1"
                                        @onclick="() => ToggleErrors(log.Id)">
                                    @log.ErrorCount
                                </button>
                            } else {
                                <span class="badge border border-success text-success-emphasis">0</span>
                            }
                        </td>
                    </tr>
                    @if (ExpandedLogId == log.Id && log.Errors != null) {
                        <tr>
                            <td colspan="7">
                                <div class="bg-body-secondary p-2 rounded small font-monospace">
                                    @foreach (var error in ParseErrors(log.Errors)) {
                                        <div>@error</div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>

        <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="GoToPage" />
    }
}
