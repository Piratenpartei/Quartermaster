@page "/Administration/Members"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Members

<PageHeader Title="@I18n[I18nKey.Ui.MemberList.PageTitle]">
    <Actions>
        <a href="/Administration/Members/Import" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-clock-history"></i> @I18n[I18nKey.Ui.MemberList.ImportHistory]
        </a>
    </Actions>
</PageHeader>

<div class="mb-3 d-flex gap-3 flex-wrap align-items-center">
    <div class="flex-grow-1" style="max-width: 400px;">
        <input type="text" class="form-control" placeholder="@I18n[I18nKey.Ui.MemberList.SearchPlaceholder]"
               @bind="SearchQuery" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
    </div>
    <div>
        <ChapterPicker Value="@SelectedChapterIdString" ValueChanged="OnChapterFilterChanged" AllowEmpty="true" />
    </div>
    <div class="form-check">
        <input type="checkbox" class="form-check-input" id="orphanFilter" @bind="OrphanedOnly" @bind:after="() => GoToPage(1)" />
        <label class="form-check-label" for="orphanFilter">
            <i class="bi bi-exclamation-triangle text-warning"></i> @I18n[I18nKey.Ui.MemberList.OrphanedFilterLabel]
        </label>
    </div>
    <div>
        <button class="btn btn-primary" @onclick="() => GoToPage(1)">
            <i class="bi bi-search"></i> @I18n[I18nKey.Ui.Common.Search]
        </button>
    </div>
</div>

@if (Loading) {
    <LoadingSpinner />
} else if (Response != null) {
    <div class="mb-2 text-secondary">
        @I18n[$"{I18nKey.Ui.MemberList.TotalCount}?count={Response.TotalCount}"]
    </div>

    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.MemberList.MemberNumberColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.Name]</th>
                <th>@I18n[I18nKey.Ui.MemberList.CityColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.Chapter]</th>
                <th>@I18n[I18nKey.Ui.MemberList.EntryDateColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.Status]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Response.Items) {
                <tr>
                    <td>@m.MemberNumber</td>
                    <td><a href="/Administration/Members/@m.Id">@m.FirstName @m.LastName</a></td>
                    <td>@m.PostCode @m.City</td>
                    <td>@m.ChapterName</td>
                    <td><LocalTime DateValue="m.EntryDate" /></td>
                    <td>
                        @if (m.ExitDate != null) {
                            <span class="badge border border-danger text-danger-emphasis">@I18n[I18nKey.Ui.MemberList.StatusExited]</span>
                        } else if (m.IsPending) {
                            <span class="badge border border-warning text-warning-emphasis">@I18n[I18nKey.Ui.MemberList.StatusPending]</span>
                        } else {
                            <span class="badge border border-success text-success-emphasis">@I18n[I18nKey.Ui.MemberList.StatusActive]</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="GoToPage" />
}
