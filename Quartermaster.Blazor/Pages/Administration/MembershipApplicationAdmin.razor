@page "/Administration/MembershipApplications"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.MembershipApplications
@using System.Globalization
@inject I18nService I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.ApplicationAdmin.PageTitle]</h3>
</div>

<div class="mb-3 d-flex gap-3">
    <div>
        <label class="form-label">@I18n[I18nKey.Ui.ApplicationAdmin.ChapterFilterLabel]</label>
        <ChapterPicker Value="@SelectedChapterIdString" ValueChanged="OnChapterFilterChanged" AllowEmpty="true" />
    </div>
    <div>
        <label for="status" class="form-label">@I18n[I18nKey.Ui.ApplicationAdmin.StatusFilterLabel]</label>
        <select id="status" class="form-select" @onchange="OnStatusChanged">
            <option value="">@I18n[I18nKey.Ui.ApplicationAdmin.StatusAll]</option>
            <option value="0" selected>@I18n[I18nKey.Ui.ApplicationStatus.Pending]</option>
            <option value="1">@I18n[I18nKey.Ui.ApplicationStatus.Approved]</option>
            <option value="2">@I18n[I18nKey.Ui.ApplicationStatus.Rejected]</option>
            <option value="3">@I18n[I18nKey.Ui.ApplicationStatus.PendingDivisionLinking]</option>
        </select>
    </div>
</div>

@if (Loading) {
    <LoadingSpinner />
} else if (Response != null) {
    <div class="mb-2 text-secondary">
        @I18n[$"{I18nKey.Ui.ApplicationAdmin.TotalCount}?count={Response.TotalCount}"]
    </div>

    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.Common.Name]</th>
                <th>@I18n[I18nKey.Ui.Common.Email]</th>
                <th>@I18n[I18nKey.Ui.ApplicationAdmin.CityColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.Chapter]</th>
                <th>@I18n[I18nKey.Ui.Common.Status]</th>
                <th>@I18n[I18nKey.Ui.ApplicationAdmin.SubmittedColumn]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in Response.Items) {
                <tr>
                    <td><a href="/Administration/MembershipApplications/@app.Id">@app.FirstName @app.LastName</a></td>
                    <td>@app.Email</td>
                    <td>@app.AddressCity</td>
                    <td>@app.ChapterName</td>
                    <td>
                        @if (app.Status == ApplicationStatus.Pending) {
                            <span class="badge border border-warning text-warning-emphasis">@I18n[I18nKey.Ui.ApplicationStatus.Pending]</span>
                        } else if (app.Status == ApplicationStatus.Approved) {
                            <span class="badge border border-success text-success-emphasis">@I18n[I18nKey.Ui.ApplicationStatus.Approved]</span>
                        } else if (app.Status == ApplicationStatus.PendingDivisionLinking) {
                            <span class="badge border border-info text-info-emphasis">@I18n[I18nKey.Ui.ApplicationStatus.PendingDivisionLinking]</span>
                        } else {
                            <span class="badge border border-danger text-danger-emphasis">@I18n[I18nKey.Ui.ApplicationStatus.Rejected]</span>
                        }
                    </td>
                    <td><LocalTime Value="app.SubmittedAt" /></td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="GoToPage" />
}
