@page "/Administration/MembershipApplications/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.DueSelector
@using Quartermaster.Api.MembershipApplications
@using Quartermaster.Blazor.Components.Inputs
@using System.Globalization

<PageBackLink Href="/Administration/MembershipApplications" />

@if (Loading) {
    <LoadingSpinner />
} else if (App == null) {
    <div class="alert alert-danger">Antrag nicht gefunden.</div>
} else {
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Mitgliedsantrag — @App.FirstName @App.LastName</h3>
        @if (App.Status == ApplicationStatus.Pending) {
            <span class="badge border border-warning text-warning-emphasis fs-6">Ausstehend</span>
        } else if (App.Status == ApplicationStatus.Approved) {
            <span class="badge border border-success text-success-emphasis fs-6">Genehmigt</span>
        } else if (App.Status == ApplicationStatus.PendingDivisionLinking) {
            <span class="badge border border-info text-info-emphasis fs-6">Gliederung ausstehend</span>
        } else {
            <span class="badge border border-danger text-danger-emphasis fs-6">Abgelehnt</span>
        }
    </div>

    @if (App.Status == ApplicationStatus.PendingDivisionLinking) {
        <RequirePermission GlobalPermission="@PermissionIdentifier.LinkApplicationDivision">
            <div class="card border-warning mb-3">
                <div class="card-body">
                    <h5>Gliederung zuordnen</h5>
                    <p class="text-secondary">
                        Dieser Antrag wurde ohne Gliederung eingereicht (manuelle oder ausländische Adresse).
                        Suche die passende Gemeinde und ordne sie zu, damit der Antrag in die normale Bearbeitung übergeht.
                    </p>
                    <p class="mb-3">
                        <strong>Angegebene Adresse:</strong>
                        @App.AddressStreet @App.AddressHouseNbr, @App.AddressPostCode @App.AddressCity
                    </p>

                    <MunicipalityPicker InitialNameQuery="@App.AddressCity" OnSelect="OnDivisionSelected" />

                    @if (SelectedDivision != null) {
                        <div class="alert alert-info d-flex justify-content-between align-items-center">
                            <span>
                                Ausgewählt: <strong>@SelectedDivision.Name</strong>
                                @if (!string.IsNullOrEmpty(SelectedChapterName)) {
                                    <span class="d-block text-body-secondary small">Gliederung: @SelectedChapterName</span>
                                } else {
                                    <span class="d-block text-body-secondary small">Keine zugeordnete Gliederung (geht an Bundesverband)</span>
                                }
                            </span>
                            <button class="btn btn-success btn-hover-scale1" @onclick="ConfirmDivision" disabled="@Linking">
                                <i class="bi bi-check-circle me-1"></i> Zuordnen & weiterleiten
                            </button>
                        </div>
                    }

                    <hr />
                    <button class="btn btn-outline-secondary" @onclick="MarkNotInGermany" disabled="@Linking">
                        Kein deutscher Wohnsitz (an Bundesverband weiterleiten)
                    </button>
                </div>
            </div>
        </RequirePermission>
    }

    <div class="card mb-3">
        <div class="card-body">
            <h5>Persönliche Daten</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">Vorname</th><td>@App.FirstName</td></tr>
                    <tr><th>Nachname</th><td>@App.LastName</td></tr>
                    <tr><th>Geburtsdatum</th><td><LocalTime DateValue="App.DateOfBirth" /></td></tr>
                    <tr><th>Staatsangehörigkeit</th><td>@App.Citizenship</td></tr>
                    <tr><th>E-Mail</th><td>@App.Email</td></tr>
                    <tr>
                        <th>Telefon</th>
                        <td>@(string.IsNullOrEmpty(App.PhoneNumber) ? "—" : App.PhoneNumber)</td>
                    </tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>Adresse</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">Straße</th><td>@App.AddressStreet @App.AddressHouseNbr</td></tr>
                    <tr><th>PLZ / Ort</th><td>@App.AddressPostCode @App.AddressCity</td></tr>
                    <tr><th>Gliederung</th><td>@(string.IsNullOrEmpty(App.ChapterName) ? "—" : App.ChapterName)</td></tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    @if (App.DueSelection != null) {
        var ds = App.DueSelection;
        <div class="card mb-3">
            <div class="card-body">
                <h5>Beitragseinstufung</h5>
                <div class="table-responsive">
                <table class="table table-borderless mb-0">
                    <tbody>
                        <tr>
                            <th style="width:200px">Einstufungsart</th>
                            <td>@ValuationLabel(ds.SelectedValuation)</td>
                        </tr>
                        <tr>
                            <th>Jahresbeitrag</th>
                            <td>@ds.SelectedDue.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</td>
                        </tr>
                        @if (ds.SelectedValuation == SelectedValuation.Reduced) {
                            <tr>
                                <th>Geminderter Betrag</th>
                                <td>@ds.ReducedAmount.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</td>
                            </tr>
                            <tr>
                                <th>Begründung</th>
                                <td>@ds.ReducedJustification</td>
                            </tr>
                        }
                        <tr>
                            <th>Beitragsstatus</th>
                            <td>@DueStatusLabel(ds.Status)</td>
                        </tr>
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <h5>Erklärungen</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr>
                        <th style="width:200px">Konformitätserklärung</th>
                        <td>
                            @if (App.ConformityDeclarationAccepted) {
                                <span><i class="bi bi-check-circle-fill text-success"></i> Akzeptiert</span>
                            } else {
                                <span><i class="bi bi-x-circle-fill text-danger"></i> Nicht akzeptiert</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Früherer Antrag abgelehnt</th>
                        <td>
                            @if (App.HasPriorDeclinedApplication) {
                                <span><i class="bi bi-exclamation-triangle-fill text-warning"></i> Ja</span>
                            } else {
                                <span>Nein</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Mitglied anderer Partei</th>
                        <td>
                            @if (App.IsMemberOfAnotherParty) {
                                <span><i class="bi bi-exclamation-triangle-fill text-warning"></i> Ja</span>
                            } else {
                                <span>Nein</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
            </div>
            @if (!string.IsNullOrEmpty(App.ApplicationText)) {
                <hr />
                <h6>Nachricht</h6>
                <p class="mb-0">@App.ApplicationText</p>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>Zeitangaben</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">Eintritt zum</th><td><LocalTime DateValue="App.EntryDate" /></td></tr>
                    <tr><th>Eingereicht am</th><td><LocalTime Value="App.SubmittedAt" /></td></tr>
                    @if (App.ProcessedAt != null) {
                        <tr><th>Bearbeitet am</th><td><LocalTime Value="App.ProcessedAt" /></td></tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>

    @if (App.Status == ApplicationStatus.Approved) {
        <RequirePermission AnyOfPermissions="@WelcomePermissions">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>Mitglied aktivieren</h5>
                    @if (App.WelcomeSentAt != null) {
                        <p class="mb-0">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            Willkommens-Mail gesendet am <LocalTime Value="App.WelcomeSentAt" />
                            — Mitgliedsnummer <strong>@App.MemberNumber</strong>
                        </p>
                    } else {
                        <p class="text-muted">
                            Vergib eine Mitgliedsnummer und sende dem Antragsteller die Willkommens-Mail.
                        </p>
                        <div class="row g-2 align-items-end" style="max-width: 520px;">
                            <div class="col-sm">
                                <label class="form-label" for="welcome-member-number">Mitgliedsnummer</label>
                                <input id="welcome-member-number" type="number" min="1" class="form-control"
                                       @bind="WelcomeMemberNumber" />
                            </div>
                            <div class="col-sm-auto">
                                <button class="btn btn-primary btn-hover-scale1" @onclick="SendWelcome"
                                        disabled="@(Sending || WelcomeMemberNumber == null || WelcomeMemberNumber <= 0)">
                                    <i class="bi bi-envelope-check"></i> Willkommens-Mail senden
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </RequirePermission>
    }

    @if (App.LinkedMotionId != null) {
        <div class="mb-3">
            <a href="/Administration/Motions/@App.LinkedMotionId" class="btn btn-outline-primary">
                <i class="bi bi-file-earmark-text"></i> Zum Antrag / Abstimmung
            </a>
        </div>
    }
}
