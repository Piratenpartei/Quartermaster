@page "/Administration/MembershipApplications/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.DueSelector
@using Quartermaster.Api.ApplicantRegister
@using Quartermaster.Api.I18n
@using Quartermaster.Api.MembershipApplications
@using Quartermaster.Blazor.Components.Inputs
@using System.Globalization

<PageBackLink Href="/Administration/MembershipApplications">
    <Links>
        @if (App?.ViewableMotionId != null) {
            <a href="/Administration/Motions/@App.ViewableMotionId" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-file-earmark-text"></i> @I18n[I18nKey.Ui.LinkedPages.Motion]
            </a>
        }
        @if (App?.ViewableReductionId != null) {
            <a href="/Administration/DueSelections/@App.ViewableReductionId" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-currency-euro"></i> @I18n[I18nKey.Ui.LinkedPages.Reduction]
            </a>
        }
    </Links>
</PageBackLink>

@if (Loading) {
    <LoadingSpinner />
} else if (App == null) {
    <div class="alert alert-danger">@I18n[I18nKey.Ui.ApplicationDetail.NotFound]</div>
} else {
    <PageHeader Title="@(I18n[$"{I18nKey.Ui.ApplicationDetail.Heading}?first={App.FirstName}&last={App.LastName}"])">
        <Subtitle>
            @if (App.Status == ApplicationStatus.Pending) {
                <StatusBadge Tone="StatusTone.Warning" Text="@I18n[I18nKey.Ui.ApplicationStatus.Pending]" />
            } else if (App.Status == ApplicationStatus.Approved) {
                <StatusBadge Tone="StatusTone.Success" Text="@I18n[I18nKey.Ui.ApplicationStatus.Approved]" />
            } else if (App.Status == ApplicationStatus.PendingDivisionLinking) {
                <StatusBadge Tone="StatusTone.Info" Text="@I18n[I18nKey.Ui.ApplicationStatus.PendingDivisionLinking]" />
            } else if (App.Status == ApplicationStatus.PendingFederalApproval) {
                <StatusBadge Tone="StatusTone.Info" Text="@I18n[I18nKey.Ui.ApplicationStatus.PendingFederalApproval]" />
            } else {
                <StatusBadge Tone="StatusTone.Danger" Text="@I18n[I18nKey.Ui.ApplicationStatus.Rejected]" />
            }
        </Subtitle>
    </PageHeader>

    @if (App.ApprovalMailState != ApprovalMailState.None) {
        <div class="alert @ApprovalMailClass mb-3">
            @ApprovalMailText
            @if (App.ApprovalMailState == ApprovalMailState.Failed) {
                <a href="/Administration/Forwarding" class="ms-2"><i class="bi bi-arrow-right me-1"></i>@I18n[I18nKey.Ui.ForwardingCases.Title]</a>
            }
            @if (!string.IsNullOrEmpty(App.FederalTicketUrl)) {
                <a href="@App.FederalTicketUrl" target="_blank" rel="noopener" class="ms-2"><i class="bi bi-box-arrow-up-right me-1"></i>@I18n[I18nKey.Ui.ApplicationDetail.FederalTicket]</a>
            }
        </div>
    }

    @if (App.RequiresFederalApproval) {
        <div class="alert alert-info mb-3">
            @I18n[I18nKey.Ui.ApplicationDetail.FederalApprovalNotice]
            @if (App.FederalApprovalMotionId != null) {
                <a href="/Administration/Motions/@App.FederalApprovalMotionId" class="ms-2"><i class="bi bi-arrow-right me-1"></i>@I18n[I18nKey.Ui.ApplicationDetail.FederalMotionLink]</a>
            }
        </div>
    }

    @if (App.NextTakeOverAt != null && App.NextTakeOverChapterName != null) {
        <NextTakeOverNotice At="App.NextTakeOverAt.Value" ChapterName="@App.NextTakeOverChapterName" />
    }

    <RequirePermission GlobalPermission="@PermissionIdentifier.ManageApplicantRegister">
        @if (ShowRegisterCard) {
            <div class="card border-info mb-3">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.ApplicationDetail.RegisterHitsTitle]</h5>
                    @if (App.HasPriorDeclinedApplication) {
                        <p class="mb-2"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>@I18n[I18nKey.Ui.ApplicationDetail.RegisterSelfDeclared]</p>
                    }
                    @if (App.RegisterHits!.Count == 0) {
                        <p class="text-secondary mb-0">@I18n[I18nKey.Ui.ApplicationDetail.RegisterNoHits]</p>
                    }
                    @foreach (var hit in App.RegisterHits) {
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-2 mt-2">
                            <div>
                                <a href="/Administration/ApplicantRegister/@hit.EntryId" class="fw-semibold">@hit.FirstName @hit.LastName</a>
                                <span class="badge rounded-pill border bg-secondary-subtle text-secondary-emphasis border-secondary-subtle border ms-1">@RegisterKindLabel(hit.Kind)</span>
                                <span class="small text-secondary ms-1"><LocalTime DateValue="hit.OccurredOn" /></span>
                                <div class="small text-secondary">@I18n[I18nParams.With(I18nKey.Ui.ApplicationDetail.RegisterHitMatched, ("fields", MatchedFieldsText(hit.MatchedFields)))]</div>
                                @if (hit.DismissedAt != null) {
                                    <div class="small text-success">@I18n[I18nParams.With(I18nKey.Ui.ApplicationDetail.RegisterHitDismissedAt, ("date", hit.DismissedAt.Value.LocalDateTime.ToString("dd.MM.yyyy HH:mm")))]</div>
                                }
                            </div>
                            @if (CanDismiss(hit)) {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => DismissHit(hit)" disabled="@Dismissing">
                                    @I18n[I18nKey.Ui.ApplicationDetail.OtherPerson]
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
            <ConfirmDialog @ref="DismissConfirm" Title="@I18n[I18nKey.Ui.ApplicationDetail.OtherPersonDialogTitle]" Message="@I18n[I18nKey.Ui.ApplicationDetail.OtherPersonDialogMessage]"
                           ConfirmText="@I18n[I18nKey.Ui.ApplicationDetail.OtherPersonDialogConfirm]" />
        }
    </RequirePermission>

    @if (App.Status == ApplicationStatus.PendingDivisionLinking) {
        <RequirePermission GlobalPermission="@PermissionIdentifier.LinkApplicationDivision">
            <div class="card border-warning mb-3">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.ApplicationDetail.DivisionLinkingTitle]</h5>
                    <p class="text-secondary">
                        @I18n[I18nKey.Ui.ApplicationDetail.DivisionLinkingInstruction]
                    </p>
                    <p class="mb-3">
                        <strong>@I18n[I18nKey.Ui.ApplicationDetail.ProvidedAddressLabel]:</strong>
                        @App.AddressStreet @App.AddressHouseNbr, @App.AddressPostCode @App.AddressCity
                    </p>

                    <MunicipalityPicker InitialNameQuery="@App.AddressCity" OnSelect="OnDivisionSelected" />

                    @if (SelectedDivision != null) {
                        <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <span>
                                @I18n[I18nKey.Ui.ApplicationDetail.DivisionSelected]: <strong>@SelectedDivision.Name</strong>
                                @if (!string.IsNullOrEmpty(SelectedChapterName)) {
                                    <span class="d-block text-body-secondary small">@I18n[I18nKey.Ui.ApplicationDetail.ChapterPrefix]: @SelectedChapterName</span>
                                } else {
                                    <span class="d-block text-body-secondary small">@I18n[I18nKey.Ui.ApplicationDetail.NoMatchingChapter]</span>
                                }
                            </span>
                            <button class="btn btn-primary" @onclick="ConfirmDivision" disabled="@Linking">
                                <i class="bi bi-check-circle me-1"></i> @I18n[I18nKey.Ui.ApplicationDetail.LinkAndForward]
                            </button>
                        </div>
                    }

                    <hr />
                    <button class="btn btn-outline-secondary" @onclick="MarkNotInGermany" disabled="@Linking">
                        @I18n[I18nKey.Ui.ApplicationDetail.NoGermanResidence]
                    </button>
                </div>
            </div>
        </RequirePermission>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.ApplicationDetail.PersonalDataSection]</h5>
            <dl class="row mb-0">
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.FirstNameLabel]</dt>
                    <dd class="col-sm-8">@App.FirstName</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.LastNameLabel]</dt>
                    <dd class="col-sm-8">@App.LastName</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.DateOfBirthLabel]</dt>
                    <dd class="col-sm-8"><LocalTime DateValue="App.DateOfBirth" /></dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.CitizenshipLabel]</dt>
                    <dd class="col-sm-8">@App.Citizenship</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.Common.Email]</dt>
                    <dd class="col-sm-8">@App.Email</dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.PhoneLabel]</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(App.PhoneNumber) ? "-" : App.PhoneNumber)</dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.ApplicationDetail.AddressSection]</h5>
            <dl class="row mb-0">
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.StreetLabel]</dt>
                    <dd class="col-sm-8">@App.AddressStreet @App.AddressHouseNbr</dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.PostCodeCityLabel]</dt>
                    <dd class="col-sm-8">@App.AddressPostCode @App.AddressCity</dd>
                    @if (!string.IsNullOrEmpty(App.AddressCountry)) {
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.CountryLabel]</dt>
                        <dd class="col-sm-8">@App.AddressCountry</dd>
                    }
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.ChapterLabel]</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(App.ChapterName) ? "-" : App.ChapterName)</dd>
            </dl>
        </div>
    </div>

    @if (App.DueSelection != null) {
        var ds = App.DueSelection;
        <div class="card mb-4">
            <div class="card-body">
                <h5>@I18n[I18nKey.Ui.ApplicationDetail.DuesSection]</h5>
                <dl class="row mb-0">
                            <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.ValuationTypeLabel]</dt>
                            <dd class="col-sm-8">@ValuationLabel(ds.SelectedValuation)</dd>
                            <dt class="col-sm-4">@I18n[ds.SelectedValuation == SelectedValuation.Reduced ? I18nKey.Ui.ApplicationDetail.RejectedReductionDueLabel : I18nKey.Ui.ApplicationDetail.YearlyDueLabel]</dt>
                            <dd class="col-sm-8">@ds.SelectedDue.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</dd>
                        @if (ds.SelectedValuation == SelectedValuation.Reduced) {
                                <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.ReducedAmountLabel]</dt>
                                <dd class="col-sm-8">@ds.ReducedAmount.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</dd>
                                <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.ReducedJustificationLabel]</dt>
                                <dd class="col-sm-8">@ds.ReducedJustification</dd>
                        }
                            <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.DueStatusLabel]</dt>
                            <dd class="col-sm-8">@DueStatusLabel(ds.Status)</dd>
                </dl>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.ApplicationDetail.DeclarationsSection]</h5>
            <dl class="row mb-0">
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.ConformityLabel]</dt>
                        <dd class="col-sm-8">
                            @if (App.ConformityDeclarationAccepted) {
                                <span><i class="bi bi-check-circle-fill text-success"></i> @I18n[I18nKey.Ui.ApplicationDetail.ConformityAccepted]</span>
                            } else {
                                <span><i class="bi bi-x-circle-fill text-danger"></i> @I18n[I18nKey.Ui.ApplicationDetail.ConformityNotAccepted]</span>
                            }
                        </dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.PriorDeclinedLabel]</dt>
                        <dd class="col-sm-8">
                            @if (App.HasPriorDeclinedApplication) {
                                <span><i class="bi bi-exclamation-triangle-fill text-warning"></i> @I18n[I18nKey.Ui.Common.Yes]</span>
                            } else {
                                <span>@I18n[I18nKey.Ui.Common.No]</span>
                            }
                        </dd>
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.OtherPartyLabel]</dt>
                        <dd class="col-sm-8">
                            @if (App.IsMemberOfAnotherParty) {
                                <span><i class="bi bi-exclamation-triangle-fill text-warning"></i> @I18n[I18nKey.Ui.Common.Yes]</span>
                            } else {
                                <span>@I18n[I18nKey.Ui.Common.No]</span>
                            }
                        </dd>
                    @if (App.IsMemberOfAnotherParty && !string.IsNullOrEmpty(App.OtherParties)) {
                            <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.OtherPartiesLabel]</dt>
                            <dd class="col-sm-8">@App.OtherParties</dd>
                    }
            </dl>
            @if (!string.IsNullOrEmpty(App.ApplicationText)) {
                <hr />
                <h6>@I18n[I18nKey.Ui.ApplicationDetail.MessageHeading]</h6>
                <p class="mb-0">@App.ApplicationText</p>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.ApplicationDetail.TimingSection]</h5>
            <dl class="row mb-0">
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.EntryDateLabel]</dt>
                    <dd class="col-sm-8"><LocalTime DateValue="App.EntryDate" /></dd>
                    <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.SubmittedAtLabel]</dt>
                    <dd class="col-sm-8"><LocalTime Value="App.SubmittedAt" /></dd>
                    @if (App.ProcessedAt != null) {
                        <dt class="col-sm-4">@I18n[I18nKey.Ui.ApplicationDetail.ProcessedAtLabel]</dt>
                        <dd class="col-sm-8"><LocalTime Value="App.ProcessedAt" /></dd>
                    }
            </dl>
        </div>
    </div>

    @if (App.Status == ApplicationStatus.Approved) {
        <RequirePermission AnyOfPermissions="@WelcomePermissions">
            <div class="card mb-4">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.ApplicationDetail.ActivateMemberSection]</h5>
                    @if (App.WelcomeSentAt != null) {
                        <p class="mb-0">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            @I18n[I18nKey.Ui.ApplicationDetail.WelcomeSentPrefix]
                            <LocalTime Value="App.WelcomeSentAt" />
                            @I18n[$"{I18nKey.Ui.ApplicationDetail.WelcomeSentMemberNumber}?number={App.MemberNumber}"]
                        </p>
                    } else {
                        <p class="text-muted">
                            @I18n[I18nKey.Ui.ApplicationDetail.ActivateInstruction]
                        </p>
                        <div class="row g-2 align-items-end" style="max-width: 520px;">
                            <div class="col-sm">
                                <label class="form-label" for="welcome-member-number">@I18n[I18nKey.Ui.ApplicationDetail.MemberNumberLabel]</label>
                                <input id="welcome-member-number" type="number" min="1" class="form-control"
                                       @bind="WelcomeMemberNumber" />
                            </div>
                            <div class="col-sm-auto">
                                <button class="btn btn-primary" @onclick="SendWelcome"
                                        disabled="@(Sending || WelcomeMemberNumber == null || WelcomeMemberNumber <= 0)">
                                    <i class="bi bi-envelope-check"></i> @I18n[I18nKey.Ui.ApplicationDetail.SendWelcomeButton]
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </RequirePermission>
    }
}
