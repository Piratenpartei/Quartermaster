@page "/Administration/MembershipApplications/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.DueSelector
@using Quartermaster.Api.I18n
@using Quartermaster.Api.MembershipApplications
@using Quartermaster.Blazor.Components.Inputs
@using System.Globalization

<PageBackLink Href="/Administration/MembershipApplications" />

@if (Loading) {
    <LoadingSpinner />
} else if (App == null) {
    <div class="alert alert-danger">@I18n[I18nKey.Ui.ApplicationDetail.NotFound]</div>
} else {
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>@I18n[$"{I18nKey.Ui.ApplicationDetail.Heading}?first={App.FirstName}&last={App.LastName}"]</h3>
        @if (App.Status == ApplicationStatus.Pending) {
            <span class="badge border border-warning text-warning-emphasis fs-6">@I18n[I18nKey.Ui.ApplicationStatus.Pending]</span>
        } else if (App.Status == ApplicationStatus.Approved) {
            <span class="badge border border-success text-success-emphasis fs-6">@I18n[I18nKey.Ui.ApplicationStatus.Approved]</span>
        } else if (App.Status == ApplicationStatus.PendingDivisionLinking) {
            <span class="badge border border-info text-info-emphasis fs-6">@I18n[I18nKey.Ui.ApplicationStatus.PendingDivisionLinking]</span>
        } else {
            <span class="badge border border-danger text-danger-emphasis fs-6">@I18n[I18nKey.Ui.ApplicationStatus.Rejected]</span>
        }
    </div>

    @if (App.Status == ApplicationStatus.PendingDivisionLinking) {
        <RequirePermission GlobalPermission="@PermissionIdentifier.LinkApplicationDivision">
            <div class="card border-warning mb-3">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.ApplicationDetail.DivisionLinkingTitle]</h5>
                    <p class="text-secondary">
                        @I18n[I18nKey.Ui.ApplicationDetail.DivisionLinkingInstruction]
                    </p>
                    <p class="mb-3">
                        <strong>@I18n[I18nKey.Ui.ApplicationDetail.ProvidedAddressLabel]:</strong>
                        @App.AddressStreet @App.AddressHouseNbr, @App.AddressPostCode @App.AddressCity
                    </p>

                    <MunicipalityPicker InitialNameQuery="@App.AddressCity" OnSelect="OnDivisionSelected" />

                    @if (SelectedDivision != null) {
                        <div class="alert alert-info d-flex justify-content-between align-items-center">
                            <span>
                                @I18n[I18nKey.Ui.ApplicationDetail.DivisionSelected]: <strong>@SelectedDivision.Name</strong>
                                @if (!string.IsNullOrEmpty(SelectedChapterName)) {
                                    <span class="d-block text-body-secondary small">@I18n[I18nKey.Ui.ApplicationDetail.ChapterPrefix]: @SelectedChapterName</span>
                                } else {
                                    <span class="d-block text-body-secondary small">@I18n[I18nKey.Ui.ApplicationDetail.NoMatchingChapter]</span>
                                }
                            </span>
                            <button class="btn btn-success btn-hover-scale1" @onclick="ConfirmDivision" disabled="@Linking">
                                <i class="bi bi-check-circle me-1"></i> @I18n[I18nKey.Ui.ApplicationDetail.LinkAndForward]
                            </button>
                        </div>
                    }

                    <hr />
                    <button class="btn btn-outline-secondary" @onclick="MarkNotInGermany" disabled="@Linking">
                        @I18n[I18nKey.Ui.ApplicationDetail.NoGermanResidence]
                    </button>
                </div>
            </div>
        </RequirePermission>
    }

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.ApplicationDetail.PersonalDataSection]</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">@I18n[I18nKey.Ui.ApplicationDetail.FirstNameLabel]</th><td>@App.FirstName</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.ApplicationDetail.LastNameLabel]</th><td>@App.LastName</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.ApplicationDetail.DateOfBirthLabel]</th><td><LocalTime DateValue="App.DateOfBirth" /></td></tr>
                    <tr><th>@I18n[I18nKey.Ui.ApplicationDetail.CitizenshipLabel]</th><td>@App.Citizenship</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.Common.Email]</th><td>@App.Email</td></tr>
                    <tr>
                        <th>@I18n[I18nKey.Ui.ApplicationDetail.PhoneLabel]</th>
                        <td>@(string.IsNullOrEmpty(App.PhoneNumber) ? "—" : App.PhoneNumber)</td>
                    </tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.ApplicationDetail.AddressSection]</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">@I18n[I18nKey.Ui.ApplicationDetail.StreetLabel]</th><td>@App.AddressStreet @App.AddressHouseNbr</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.ApplicationDetail.PostCodeCityLabel]</th><td>@App.AddressPostCode @App.AddressCity</td></tr>
                    <tr><th>@I18n[I18nKey.Ui.ApplicationDetail.ChapterLabel]</th><td>@(string.IsNullOrEmpty(App.ChapterName) ? "—" : App.ChapterName)</td></tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>

    @if (App.DueSelection != null) {
        var ds = App.DueSelection;
        <div class="card mb-3">
            <div class="card-body">
                <h5>@I18n[I18nKey.Ui.ApplicationDetail.DuesSection]</h5>
                <div class="table-responsive">
                <table class="table table-borderless mb-0">
                    <tbody>
                        <tr>
                            <th style="width:200px">@I18n[I18nKey.Ui.ApplicationDetail.ValuationTypeLabel]</th>
                            <td>@ValuationLabel(ds.SelectedValuation)</td>
                        </tr>
                        <tr>
                            <th>@I18n[I18nKey.Ui.ApplicationDetail.YearlyDueLabel]</th>
                            <td>@ds.SelectedDue.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</td>
                        </tr>
                        @if (ds.SelectedValuation == SelectedValuation.Reduced) {
                            <tr>
                                <th>@I18n[I18nKey.Ui.ApplicationDetail.ReducedAmountLabel]</th>
                                <td>@ds.ReducedAmount.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</td>
                            </tr>
                            <tr>
                                <th>@I18n[I18nKey.Ui.ApplicationDetail.ReducedJustificationLabel]</th>
                                <td>@ds.ReducedJustification</td>
                            </tr>
                        }
                        <tr>
                            <th>@I18n[I18nKey.Ui.ApplicationDetail.DueStatusLabel]</th>
                            <td>@DueStatusLabel(ds.Status)</td>
                        </tr>
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.ApplicationDetail.DeclarationsSection]</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr>
                        <th style="width:200px">@I18n[I18nKey.Ui.ApplicationDetail.ConformityLabel]</th>
                        <td>
                            @if (App.ConformityDeclarationAccepted) {
                                <span><i class="bi bi-check-circle-fill text-success"></i> @I18n[I18nKey.Ui.ApplicationDetail.ConformityAccepted]</span>
                            } else {
                                <span><i class="bi bi-x-circle-fill text-danger"></i> @I18n[I18nKey.Ui.ApplicationDetail.ConformityNotAccepted]</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>@I18n[I18nKey.Ui.ApplicationDetail.PriorDeclinedLabel]</th>
                        <td>
                            @if (App.HasPriorDeclinedApplication) {
                                <span><i class="bi bi-exclamation-triangle-fill text-warning"></i> @I18n[I18nKey.Ui.Common.Yes]</span>
                            } else {
                                <span>@I18n[I18nKey.Ui.Common.No]</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>@I18n[I18nKey.Ui.ApplicationDetail.OtherPartyLabel]</th>
                        <td>
                            @if (App.IsMemberOfAnotherParty) {
                                <span><i class="bi bi-exclamation-triangle-fill text-warning"></i> @I18n[I18nKey.Ui.Common.Yes]</span>
                            } else {
                                <span>@I18n[I18nKey.Ui.Common.No]</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
            </div>
            @if (!string.IsNullOrEmpty(App.ApplicationText)) {
                <hr />
                <h6>@I18n[I18nKey.Ui.ApplicationDetail.MessageHeading]</h6>
                <p class="mb-0">@App.ApplicationText</p>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.ApplicationDetail.TimingSection]</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">@I18n[I18nKey.Ui.ApplicationDetail.EntryDateLabel]</th><td><LocalTime DateValue="App.EntryDate" /></td></tr>
                    <tr><th>@I18n[I18nKey.Ui.ApplicationDetail.SubmittedAtLabel]</th><td><LocalTime Value="App.SubmittedAt" /></td></tr>
                    @if (App.ProcessedAt != null) {
                        <tr><th>@I18n[I18nKey.Ui.ApplicationDetail.ProcessedAtLabel]</th><td><LocalTime Value="App.ProcessedAt" /></td></tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>

    @if (App.Status == ApplicationStatus.Approved) {
        <RequirePermission AnyOfPermissions="@WelcomePermissions">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.ApplicationDetail.ActivateMemberSection]</h5>
                    @if (App.WelcomeSentAt != null) {
                        <p class="mb-0">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            @I18n[I18nKey.Ui.ApplicationDetail.WelcomeSentPrefix]
                            <LocalTime Value="App.WelcomeSentAt" />
                            @I18n[$"{I18nKey.Ui.ApplicationDetail.WelcomeSentMemberNumber}?number={App.MemberNumber}"]
                        </p>
                    } else {
                        <p class="text-muted">
                            @I18n[I18nKey.Ui.ApplicationDetail.ActivateInstruction]
                        </p>
                        <div class="row g-2 align-items-end" style="max-width: 520px;">
                            <div class="col-sm">
                                <label class="form-label" for="welcome-member-number">@I18n[I18nKey.Ui.ApplicationDetail.MemberNumberLabel]</label>
                                <input id="welcome-member-number" type="number" min="1" class="form-control"
                                       @bind="WelcomeMemberNumber" />
                            </div>
                            <div class="col-sm-auto">
                                <button class="btn btn-primary btn-hover-scale1" @onclick="SendWelcome"
                                        disabled="@(Sending || WelcomeMemberNumber == null || WelcomeMemberNumber <= 0)">
                                    <i class="bi bi-envelope-check"></i> @I18n[I18nKey.Ui.ApplicationDetail.SendWelcomeButton]
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </RequirePermission>
    }

    @if (App.LinkedMotionId != null) {
        <div class="mb-3">
            <a href="/Administration/Motions/@App.LinkedMotionId" class="btn btn-outline-primary">
                <i class="bi bi-file-earmark-text"></i> @I18n[I18nKey.Ui.ApplicationDetail.LinkedMotionButton]
            </a>
        </div>
    }
}
