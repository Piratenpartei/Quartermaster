@page "/Administration/Motions/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.Motions
@using Quartermaster.Rendering

<PageBackLink Href="/Administration/Motions" />

@if (Loading) {
    <LoadingSpinner />
} else if (Motion == null) {
    <div class="alert alert-danger">Antrag nicht gefunden.</div>
} else {
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>@Motion.Title</h3>
        <div class="d-flex gap-2 align-items-center">
            @if (Motion.IsRealized) {
                <span class="badge border border-success text-success-emphasis fs-6">Umgesetzt</span>
            }
            <MotionApprovalBadge Status="@Motion.ApprovalStatus" Class="fs-6" />
            @if (CanEdit && !EditMode) {
                <button class="btn btn-outline-primary btn-sm btn-hover-scale1" @onclick="BeginEdit">
                    <i class="bi bi-pencil me-1"></i> Bearbeiten
                </button>
            }
        </div>
    </div>

    @if (EditMode) {
        <div class="card mb-3 border-primary">
            <div class="card-body">
                <h5>Antrag bearbeiten</h5>
                <div class="mb-3">
                    <label for="editTitle" class="form-label">Titel</label>
                    <input type="text" class="form-control" id="editTitle" @bind="EditTitle" />
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="editAuthorName" class="form-label">Antragsteller (Name)</label>
                        <input type="text" class="form-control" id="editAuthorName" @bind="EditAuthorName" />
                    </div>
                    <div class="col-md-6">
                        <label for="editAuthorEmail" class="form-label">Antragsteller (E-Mail)</label>
                        <input type="email" class="form-control" id="editAuthorEmail" @bind="EditAuthorEmail" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Antragstext (Markdown)</label>
                    <MarkdownEditor @bind-Value="EditTextMarkdown" Rows="8" Profile="SanitizationProfile.Strict" />
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveEdit" disabled="@Saving">
                        @if (Saving) {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        } else {
                            <i class="bi bi-check-circle me-1"></i>
                        }
                        Speichern
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="CancelEdit" disabled="@Saving">
                        Abbrechen
                    </button>
                </div>
            </div>
        </div>
    } else {
    <div class="card mb-3">
        <div class="card-body">
            <h5>Details</h5>
            <div class="table-responsive">
            <table class="table table-borderless mb-0">
                <tbody>
                    <tr><th style="width:200px">Antragsteller</th><td>@Motion.AuthorName</td></tr>
                    <tr><th>E-Mail</th><td>@Motion.AuthorEmail</td></tr>
                    <tr><th>Gliederung</th><td>@Motion.ChapterName</td></tr>
                    <tr>
                        <th>Sichtbarkeit</th>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span>@(Motion.IsPublic ? "Öffentlich" : "Nicht öffentlich (enthält personenbezogene Daten)")</span>
                                <RequirePermission AnyChapterPermission="@PermissionIdentifier.EditMotions">
                                    <button class="btn btn-sm btn-outline-secondary btn-hover-scale1" @onclick="TogglePublic" disabled="@TogglingPublic"
                                            title="@(Motion.IsPublic ? "Auf nicht öffentlich setzen" : "Öffentlich machen")">
                                        @if (TogglingPublic) {
                                            <span class="spinner-border spinner-border-sm" role="status"></span>
                                        } else if (Motion.IsPublic) {
                                            <i class="bi bi-eye-slash me-1"></i> @("Auf nicht öffentlich setzen")
                                        } else {
                                            <i class="bi bi-eye me-1"></i> @("Öffentlich machen")
                                        }
                                    </button>
                                </RequirePermission>
                            </div>
                        </td>
                    </tr>
                    <tr><th>Erstellt</th><td><LocalTime Value="Motion.CreatedAt" /></td></tr>
                    @if (Motion.ResolvedAt != null) {
                        <tr><th>Beschlossen</th><td><LocalTime Value="Motion.ResolvedAt" /></td></tr>
                    }
                    @if (Motion.LinkedMembershipApplicationId != null) {
                        <tr>
                            <th>Verknüpfung</th>
                            <td><a href="/Administration/MembershipApplications/@Motion.LinkedMembershipApplicationId">Mitgliedsantrag ansehen</a></td>
                        </tr>
                    }
                    @if (Motion.LinkedDueSelectionId != null) {
                        <tr>
                            <th>Verknüpfung</th>
                            <td><a href="/Administration/DueSelections/@Motion.LinkedDueSelectionId">Beitragseinstufung ansehen</a></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>Antragstext</h5>
            <div>@((MarkupString)Motion.Text)</div>
        </div>
    </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <h5>Abstimmung (@Motion.Votes.Count / @Motion.TotalOfficers Stimmen)</h5>

            <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Rolle</th>
                        <th>Stimme</th>
                        <th>Datum</th>
                        <th>Abstimmen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var officer in Motion.Officers) {
                        var existingVote = GetVoteForOfficer(officer.MemberId);
                        <tr>
                            <td>@officer.MemberName</td>
                            <td>@OfficerRoleLabel(officer.OfficerRole)</td>
                            <td>
                                @if (existingVote != null) {
                                    @if (existingVote.Vote == VoteType.Approve) {
                                        <span class="text-success"><i class="bi bi-hand-thumbs-up-fill"></i> Dafür</span>
                                    } else if (existingVote.Vote == VoteType.Deny) {
                                        <span class="text-danger"><i class="bi bi-hand-thumbs-down-fill"></i> Dagegen</span>
                                    } else {
                                        <span class="text-secondary"><i class="bi bi-dash-circle"></i> Enthaltung</span>
                                    }
                                } else {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td><LocalTime Value="existingVote?.VotedAt" /></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-success btn-sm @(existingVote?.Vote == VoteType.Approve ? "active" : "")"
                                            aria-label="Ja-Stimme" @onclick="() => CastVote(officer.MemberId, VoteType.Approve)">
                                        <i class="bi bi-hand-thumbs-up-fill"></i>
                                    </button>
                                    <button class="btn btn-danger btn-sm @(existingVote?.Vote == VoteType.Deny ? "active" : "")"
                                            aria-label="Nein-Stimme" @onclick="() => CastVote(officer.MemberId, VoteType.Deny)">
                                        <i class="bi bi-hand-thumbs-down-fill"></i>
                                    </button>
                                    <button class="btn btn-secondary btn-sm @(existingVote?.Vote == VoteType.Abstain ? "active" : "")"
                                            aria-label="Enthaltung" @onclick="() => CastVote(officer.MemberId, VoteType.Abstain)">
                                        <i class="bi bi-dash-circle"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>

    @if (Motion.ApprovalStatus == MotionApprovalStatus.Pending) {
        <div class="card mb-3">
            <div class="card-body">
                <h5>Verwaltung</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-warning btn-sm" @onclick="() => SetStatus(MotionApprovalStatus.FormallyRejected)">
                        <span>Formal ablehnen</span>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => SetStatus(MotionApprovalStatus.ClosedWithoutAction)">
                        <span>Ohne Beschluss schließen</span>
                    </button>
                </div>
            </div>
        </div>
    }

    @if (Motion.ApprovalStatus == MotionApprovalStatus.Approved && !Motion.IsRealized) {
        <div class="d-flex">
            <button class="btn btn-success" @onclick="MarkRealized">
                <i class="bi bi-check-circle"></i> Als umgesetzt markieren
            </button>
        </div>
    }

    @if (!AuditUnavailable) {
        <div class="card mt-3">
            <div class="card-body">
                <h5>Änderungsverlauf</h5>
                @if (AuditLoading) {
                    <LoadingSpinner />
                } else if (AuditEntries == null || AuditEntries.Count == 0) {
                    <p class="text-secondary mb-0">Keine Einträge.</p>
                } else {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th style="width:160px">Zeitpunkt</th>
                                    <th style="width:160px">Akteur</th>
                                    <th style="width:160px">Aktion</th>
                                    <th>Feld</th>
                                    <th>Vorher</th>
                                    <th>Nachher</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in AuditEntries) {
                                    <tr>
                                        <td><LocalTime Value="entry.Timestamp" /></td>
                                        <td>@(entry.UserDisplayName ?? "System")</td>
                                        <td>@ActionLabel(entry.Action)</td>
                                        <td>@FieldLabel(entry.FieldName)</td>
                                        <td><span class="text-secondary small">@entry.OldValue</span></td>
                                        <td><span class="small">@entry.NewValue</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}
