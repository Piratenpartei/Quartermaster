@page "/Administration/Motions"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Motions
@inject I18nService I18n

<PageHeader Title="@I18n[I18nKey.Ui.MotionList.PageTitle]">
    <Actions>
        <a href="/Administration/Motions/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> @I18n[I18nKey.Ui.MotionList.NewMotion]
        </a>
    </Actions>
</PageHeader>

<div class="mb-3 d-flex gap-3">
    <div>
        <label class="form-label">@I18n[I18nKey.Ui.Common.Chapter]</label>
        <ChapterPicker Value="@SelectedChapterIdString" ValueChanged="OnChapterFilterChanged" AllowEmpty="true" />
    </div>
    <div>
        <label for="status" class="form-label">@I18n[I18nKey.Ui.Common.Status]</label>
        <select id="status" class="form-select" @onchange="OnStatusChanged">
            <option value="">@I18n[I18nKey.Ui.MotionStatus.All]</option>
            <option value="0" selected>@I18n[I18nKey.Ui.MotionStatus.Pending]</option>
            <option value="1">@I18n[I18nKey.Ui.MotionStatus.Approved]</option>
            <option value="2">@I18n[I18nKey.Ui.MotionStatus.Rejected]</option>
            <option value="3">@I18n[I18nKey.Ui.MotionStatus.FormallyRejected]</option>
            <option value="4">@I18n[I18nKey.Ui.MotionStatus.ClosedWithoutAction]</option>
        </select>
    </div>
</div>

@if (Loading) {
    <LoadingSpinner />
} else if (Response != null) {
    <div class="mb-2 text-secondary">
        @I18n[$"{I18nKey.Ui.MotionList.TotalCount}?count={Response.TotalCount}"]
    </div>

    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.Common.Title]</th>
                <th>@I18n[I18nKey.Ui.MotionList.AuthorColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.Chapter]</th>
                <th>@I18n[I18nKey.Ui.Common.Visibility]</th>
                <th>@I18n[I18nKey.Ui.Common.Status]</th>
                <th>@I18n[I18nKey.Ui.MotionList.RealizedColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.Created]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var motion in Response.Items) {
                <tr>
                    <td><a href="/Administration/Motions/@motion.Id">@motion.Title</a></td>
                    <td>@motion.AuthorName</td>
                    <td>@motion.ChapterName</td>
                    <td>
                        @if (motion.IsPublic) {
                            <span class="badge border border-info text-info-emphasis">@I18n[I18nKey.Ui.Common.Public]</span>
                        } else {
                            <span class="badge border border-secondary text-secondary-emphasis">@I18n[I18nKey.Ui.Common.NotPublic]</span>
                        }
                    </td>
                    <td>
                        <MotionApprovalBadge Status="@motion.ApprovalStatus" />
                    </td>
                    <td>
                        @if (motion.IsRealized) {
                            <i class="bi bi-check-circle-fill text-success"></i>
                        }
                    </td>
                    <td><LocalTime Value="motion.CreatedAt" Format="dd.MM.yyyy" /></td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <Pagination CurrentPage="CurrentPage" TotalPages="TotalPages" OnPageChanged="GoToPage" />
}
