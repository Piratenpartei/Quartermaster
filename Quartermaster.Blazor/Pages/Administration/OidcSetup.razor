@page "/Administration/Setup/Oidc"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Pages.Administration.Settings
@inject I18nService I18n

<PageBackLink Href="/Administration/Settings" />

<RequirePermission GlobalPermission="@PermissionIdentifier.EditOptions">
    <h3 class="mb-3">@I18n[I18nKey.Ui.OidcSetup.PageTitle]</h3>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title mb-3">@I18n[I18nKey.Ui.OidcSetup.SettingsTitle]</h5>
            <OptionGroupEditor Fields="@SettingsAssistantCatalog.Oidc.Sections[0].Fields" FullWidthFields="true" OnSaved="RefreshClientConfig" />
        </div>
    </div>
</RequirePermission>
