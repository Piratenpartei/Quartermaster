@page "/Administration/Settings/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Options
@using Quartermaster.Api.Chapters

<PageBackLink Href="/Administration/Settings" />

@if (Loading) {
    <LoadingSpinner />
} else if (Option == null) {
    <div class="alert alert-danger">@I18n[I18nKey.Ui.OptionDetail.NotFound]</div>
} else {
    <h3 class="mb-3">@Option.FriendlyName</h3>

    <div class="row">
        <div class="col-12">
            <DirtyForm @ref="_globalForm">
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="mb-1">@I18n[I18nKey.Ui.OptionDetail.GlobalValueTitle]</h5>
                                <code class="text-secondary small">@Option.Identifier</code>
                                <span class="badge border ms-2 @DataTypeBadge(Option.DataType)">@DataTypeLabel(Option.DataType)</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Option.Description)) {
                            <p class="text-secondary small mb-3">@Option.Description</p>
                        }
                        <div class="input-group mb-2">
                            <FormInput @bind-Value="Option.GlobalValue" Type="@(Option.DataType == OptionDataType.Number ? "number" : "text")" />
                            <FormSaveButton OnClick="SaveGlobal" />
                        </div>
                    </div>
                </div>
            </DirtyForm>

            @if (Option.IsOverridable) {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5>@I18n[I18nKey.Ui.OptionDetail.ChapterOverridesTitle]</h5>

                        @if (Option.Overrides.Count > 0) {
                            <div class="table-responsive">
                            <table class="table table-sm mb-3">
                                <thead>
                                    <tr>
                                        <th>@I18n[I18nKey.Ui.OptionDetail.ShortCodeColumn]</th>
                                        <th>@I18n[I18nKey.Ui.Common.Chapter]</th>
                                        <th>@I18n[I18nKey.Ui.OptionDetail.ValueColumn]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ov in Option.Overrides) {
                                        <tr>
                                            <td><span class="badge bg-secondary">@ov.ChapterShortCode</span></td>
                                            <td>@ov.ChapterName</td>
                                            <td>
                                                <div class="input-group input-group-sm" style="max-width: 300px;">
                                                    <input type="@(Option.DataType == OptionDataType.Number ? "number" : "text")"
                                                           class="form-control" value="@ov.Value"
                                                           @onchange="(e) => SaveOverride(ov.ChapterId, e.Value?.ToString() ?? string.Empty)" />
                                                    <button class="btn btn-outline-primary" aria-label="@I18n[I18nKey.Ui.OptionDetail.SaveAriaLabel]" @onclick="() => SaveOverride(ov.ChapterId, ov.Value)">
                                                        <i class="bi bi-save"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        } else {
                            <EmptyState Message="@I18n[I18nKey.Ui.OptionDetail.NoOverrides]" />
                        }

                        <hr />
                        <div class="d-flex gap-2 align-items-center">
                            <select class="form-select form-select-sm" style="width: auto;" @bind="NewOverrideChapterId">
                                <option value="">@I18n[I18nKey.Ui.OptionDetail.AddChapterOption]</option>
                                @if (Chapters != null) {
                                    @foreach (var ch in Chapters.Where(c => !string.IsNullOrEmpty(c.ShortCode))) {
                                        @if (!Option.Overrides.Any(o => o.ChapterId == ch.Id)) {
                                            <option value="@ch.Id">@ch.Name (@ch.ShortCode)</option>
                                        }
                                    }
                                }
                            </select>
                            <button class="btn btn-sm btn-outline-success" @onclick="AddOverride">
                                <i class="bi bi-plus"></i> @I18n[I18nKey.Ui.OptionDetail.AddButton]
                            </button>
                        </div>
                    </div>
                </div>
            } else {
                <div class="card mb-3">
                    <div class="card-body text-secondary">
                        <i class="bi bi-info-circle me-1"></i> @I18n[I18nKey.Ui.OptionDetail.NotOverridableNotice]
                    </div>
                </div>
            }
        </div>
    </div>
}
