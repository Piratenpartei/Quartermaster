@page "/Administration/Settings/Advanced"
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Options
@using Quartermaster.Blazor.Pages.Administration.Settings

<PageBackLink Href="/Administration/Settings" />

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.OptionList.PageTitle]</h3>
    <p class="text-secondary mb-0">@I18n[I18nKey.Ui.OptionList.Intro]</p>
</div>

@if (Loading) {
    <LoadingSpinner />
} else if (Options != null) {
    <div class="input-group mb-3" style="max-width: 400px;">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="search" class="form-control" placeholder="@I18n[I18nKey.Ui.OptionList.SearchPlaceholder]"
               value="@Search" @oninput="e => Search = e.Value?.ToString() ?? string.Empty" />
    </div>

    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.Common.Name]</th>
                <th>@I18n[I18nKey.Ui.OptionList.IdentifierColumn]</th>
                <th>@I18n[I18nKey.Ui.OptionList.TypeColumn]</th>
                <th>@I18n[I18nKey.Ui.OptionList.OverridableColumn]</th>
                <th>@I18n[I18nKey.Ui.OptionList.OverridesColumn]</th>
                <th>@I18n[I18nKey.Ui.OptionList.AssistantColumn]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var opt in FilteredOptions()) {
                var assistant = SettingsAssistantCatalog.ForKey(opt.Identifier);
                <tr>
                    <td><a href="/Administration/Settings/@opt.Id">@opt.FriendlyName</a></td>
                    <td><code>@opt.Identifier</code></td>
                    <td><span class="badge border @DataTypeBadge(opt.DataType)">@DataTypeLabel(opt.DataType)</span></td>
                    <td>
                        @if (opt.IsOverridable) {
                            <i class="bi bi-check-circle text-success"></i>
                        }
                    </td>
                    <td>@opt.Overrides.Count</td>
                    <td>
                        @if (assistant != null) {
                            <a href="@assistant.Route">@I18n[assistant.TitleKey]</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
