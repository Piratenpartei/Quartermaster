@page "/Administration/Roles/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Roles

<PageBackLink Href="/Administration/Roles" Text="@I18n[I18nKey.Ui.RoleEdit.BackLink]" />

@if (Loading) {
    <LoadingSpinner />
} else if (Role == null) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.RoleEdit.NotFound]</div>
} else {
    <PageHeader Title="@Role.Name">
        <Subtitle>
            <div class="d-flex flex-wrap gap-2">
                @if (Role.Scope == 0) {
                    <StatusBadge Tone="StatusTone.Info" Text="@I18n[I18nKey.Ui.RoleEdit.ScopeGlobal]" />
                } else {
                    <StatusBadge Tone="StatusTone.Info" Text="@I18n[I18nKey.Ui.RoleEdit.ScopeChapterFull]" />
                }
                @if (Role.IsSystem) {
                    <StatusBadge Tone="StatusTone.Neutral" Text="@I18n[I18nKey.Ui.RoleEdit.SystemBadge]" />
                }
            </div>
        </Subtitle>
    </PageHeader>

    @if (Role.IsSystem) {
        <div class="alert alert-info">
            @I18n[I18nKey.Ui.RoleEdit.SystemNotice]
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <label for="roleName" class="form-label">@I18n[I18nKey.Ui.Common.Name]</label>
                <input type="text" class="form-control" id="roleName" @bind="Role.Name" disabled="@Role.IsSystem" />
            </div>
            <div class="mb-3">
                <label for="roleDescription" class="form-label">@I18n[I18nKey.Ui.RoleEdit.DescriptionLabel]</label>
                <textarea class="form-control" id="roleDescription" @bind="Role.Description" rows="2" disabled="@Role.IsSystem"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">@I18n[I18nKey.Ui.RoleEdit.PermissionsLabel]</label>
                @if (AvailablePermissions != null) {
                    <div class="border rounded p-2" style="max-height: 400px; overflow-y: auto;">
                        @foreach (var perm in FilteredPermissions) {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="perm_@perm.Identifier"
                                       checked="@Role.Permissions.Contains(perm.Identifier)"
                                       disabled="@Role.IsSystem"
                                       @onchange="e => TogglePerm(perm.Identifier, (bool)e.Value!)" />
                                <label class="form-check-label" for="perm_@perm.Identifier">
                                    @perm.DisplayName <small class="text-secondary">(@perm.Identifier)</small>
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>
            @if (!Role.IsSystem) {
                <AsyncButton Text="@I18n[I18nKey.Ui.Common.Save]" Icon="check-circle" Action="SaveRole" />
            }
        </div>
    </div>
}
