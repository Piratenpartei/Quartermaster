@page "/Administration/Roles"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Roles

<PageHeader Title="@I18n[I18nKey.Ui.RoleList.PageTitle]">
    <Actions>
        <a href="/Administration/Roles/Assignments" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-person-badge"></i> @I18n[I18nKey.Ui.RoleList.AssignmentsLink]
        </a>
        <button class="btn btn-sm btn-primary" @onclick="ShowCreateForm">
            <i class="bi bi-plus-circle"></i> @I18n[I18nKey.Ui.RoleList.NewRole]
        </button>
    </Actions>
</PageHeader>

@if (Loading) {
    <LoadingSpinner />
} else if (Roles != null) {
    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.Common.Name]</th>
                <th>@I18n[I18nKey.Ui.RoleList.ScopeColumn]</th>
                <th>@I18n[I18nKey.Ui.RoleList.PermissionsColumn]</th>
                <th>@I18n[I18nKey.Ui.RoleList.SystemColumn]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Roles) {
                <tr>
                    <td>
                        <a href="/Administration/Roles/@r.Id">@r.Name</a>
                        @if (!string.IsNullOrEmpty(r.Description)) {
                            <div class="small text-secondary">@r.Description</div>
                        }
                    </td>
                    <td>
                        @if (r.Scope == RoleScope.Global) {
                            <span class="badge border border-info text-info-emphasis">@I18n[I18nKey.Ui.RoleList.ScopeGlobal]</span>
                        } else {
                            <span class="badge border border-primary text-primary-emphasis">@I18n[I18nKey.Ui.RoleList.ScopeChapter]</span>
                        }
                    </td>
                    <td>@r.Permissions.Count</td>
                    <td>
                        @if (r.IsSystem) {
                            <span class="badge bg-secondary">@I18n[I18nKey.Ui.RoleList.SystemBadge]</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (!r.IsSystem) {
                            <DeleteButton OnClick="() => DeleteRole(r)" Text="" AriaLabel="@I18n[I18nKey.Ui.RoleList.DeleteAriaLabel]" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@if (ShowingCreateForm) {
    <div class="card mt-4">
        <div class="card-body">
            <h5>@I18n[I18nKey.Ui.RoleList.CreateFormTitle]</h5>
            <div class="mb-3">
                <label for="newName" class="form-label">@I18n[I18nKey.Ui.Common.Name]</label>
                <input type="text" class="form-control" id="newName" @bind="NewName" />
            </div>
            <div class="mb-3">
                <label for="newDescription" class="form-label">@I18n[I18nKey.Ui.RoleList.DescriptionLabel]</label>
                <textarea class="form-control" id="newDescription" @bind="NewDescription" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label for="newScope" class="form-label">@I18n[I18nKey.Ui.RoleList.ScopeLabel]</label>
                <select class="form-select" id="newScope" @bind="NewScope" @bind:after="OnScopeChanged">
                    <option value="@RoleScope.Global">@I18n[I18nKey.Ui.RoleList.ScopeGlobal]</option>
                    <option value="@RoleScope.ChapterScoped">@I18n[I18nKey.Ui.RoleList.ScopeChapterFull]</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">@I18n[I18nKey.Ui.RoleList.PermissionsLabel]</label>
                @if (AvailablePermissions != null) {
                    <div class="border rounded p-2" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var perm in FilteredPermissions) {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="perm_@perm.Identifier"
                                       checked="@NewPermissions.Contains(perm.Identifier)"
                                       @onchange="e => TogglePerm(perm.Identifier, (bool)e.Value!)" />
                                <label class="form-check-label" for="perm_@perm.Identifier">
                                    @perm.DisplayName <small class="text-secondary">(@perm.Identifier)</small>
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="CreateRole" disabled="@Creating">
                    @if (Creating) {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    <span> @I18n[I18nKey.Ui.Common.Create]</span>
                </button>
                <button class="btn btn-outline-secondary" @onclick="() => ShowingCreateForm = false">@I18n[I18nKey.Ui.Common.Cancel]</button>
            </div>
        </div>
    </div>
}
