@page "/Administration/Setup/PublicForms"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<PageBackLink Href="/Administration/Settings" />

<RequirePermission GlobalPermission="@PermissionIdentifier.EditOptions">
    <h3 class="mb-1"><i class="bi @SettingsAssistantCatalog.PublicForms.Icon me-2"></i>@I18n[SettingsAssistantCatalog.PublicForms.TitleKey]</h3>
    <p class="text-secondary">@I18n[I18nKey.Ui.PublicFormsSetup.Intro]</p>

    @if (Loading) {
        <LoadingSpinner />
    } else {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">@I18n[I18nKey.Ui.PublicFormsSetup.MembershipTitle]</h5>
                <div class="form-check form-switch mb-2">
                    <input id="public-form-membership" type="checkbox" class="form-check-input" role="switch" disabled="@Busy"
                           checked="@MembershipEnabled" @onchange="e => SetGlobal(MembershipKey, (bool)e.Value!)" />
                    <label class="form-check-label" for="public-form-membership">@I18n[I18nKey.Ui.PublicFormsSetup.MembershipLabel]</label>
                </div>
                <div class="form-check form-switch">
                    <input id="public-form-dues" type="checkbox" class="form-check-input" role="switch" disabled="@Busy"
                           checked="@DueSelectionEnabled" @onchange="e => SetGlobal(DueSelectionKey, (bool)e.Value!)" />
                    <label class="form-check-label" for="public-form-dues">@I18n[I18nKey.Ui.PublicFormsSetup.DueSelectionLabel]</label>
                </div>
                <div class="form-text">@I18n[I18nKey.Ui.PublicFormsSetup.MembershipHint]</div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-2">@I18n[I18nKey.Ui.PublicFormsSetup.MotionTitle]</h5>
                <p class="text-secondary small">@I18n[I18nKey.Ui.PublicFormsSetup.MotionDescription]</p>

                <div class="form-check form-switch mb-3">
                    <input id="public-form-motion" type="checkbox" class="form-check-input" role="switch" disabled="@Busy"
                           checked="@MotionDefault" @onchange="e => SetGlobal(MotionKey, (bool)e.Value!)" />
                    <label class="form-check-label" for="public-form-motion">@I18n[I18nKey.Ui.PublicFormsSetup.MotionDefaultLabel]</label>
                </div>

                <h6>@I18n[I18nKey.Ui.PublicFormsSetup.OverridesTitle]</h6>
                @if (Overrides.Count == 0) {
                    <p class="text-secondary small">@I18n[I18nKey.Ui.PublicFormsSetup.NoOverrides]</p>
                } else {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>@I18n[I18nKey.Ui.Common.Chapter]</th>
                                    <th>@I18n[I18nKey.Ui.PublicFormsSetup.ValueColumn]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ov in Overrides) {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(ov.ChapterShortCode)) {
                                                <span class="badge bg-secondary me-1">@ov.ChapterShortCode</span>
                                            }
                                            @ov.ChapterName
                                        </td>
                                        <td style="max-width: 10rem;">
                                            <select class="form-select form-select-sm" value="@(IsTrue(ov.Value) ? TrueValue : FalseValue)" disabled="@Busy"
                                                    @onchange="e => SetOverride(ov.ChapterId, e.Value?.ToString() == TrueValue)">
                                                <option value="@TrueValue">@I18n[I18nKey.Ui.PublicFormsSetup.Open]</option>
                                                <option value="@FalseValue">@I18n[I18nKey.Ui.PublicFormsSetup.Closed]</option>
                                            </select>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@Busy"
                                                    title="@I18n[I18nKey.Ui.PublicFormsSetup.InheritHint]" @onclick="() => RemoveOverride(ov.ChapterId)">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i>@I18n[I18nKey.Ui.PublicFormsSetup.Inherit]
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <div class="flex-grow-1" style="min-width: 15rem;">
                        <ChapterPicker @bind-Value="NewChapterId" ExcludeIds="@OverriddenChapterIds()" AllowEmpty="true"
                                       EmptyLabel="@I18n[I18nKey.Ui.PublicFormsSetup.AddChapterPlaceholder]" />
                    </div>
                    <select class="form-select" style="max-width: 10rem;" @bind="NewValue">
                        <option value="@TrueValue">@I18n[I18nKey.Ui.PublicFormsSetup.Open]</option>
                        <option value="@FalseValue">@I18n[I18nKey.Ui.PublicFormsSetup.Closed]</option>
                    </select>
                    <button type="button" class="btn btn-outline-primary" disabled="@(Busy || string.IsNullOrEmpty(NewChapterId))" @onclick="AddOverride">
                        <i class="bi bi-plus-lg me-1"></i>@I18n[I18nKey.Ui.PublicFormsSetup.AddButton]
                    </button>
                </div>

                <div class="alert alert-info small mt-3 mb-0">
                    <i class="bi bi-info-circle me-1"></i>@I18n[I18nParams.With(I18nKey.Ui.PublicFormsSetup.OpenCount, ("count", Config.MotionFormChapterIds.Count.ToString()))]
                </div>
            </div>
        </div>
    }
</RequirePermission>
