@page "/Administration/Settings"
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.Settings.PageTitle]</h3>
    <p class="text-secondary mb-0">@I18n[I18nKey.Ui.Settings.Intro]</p>
</div>

@if (Options == null) {
    <LoadingSpinner />
} else {
    @foreach (var group in Groups) {
        <h5 class="mt-4 mb-3">@I18n[GroupTitleKey(group)]</h5>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var assistant in SettingsAssistantCatalog.All.Where(a => a.Group == group)) {
                var status = SettingsStatusResolver.Resolve(assistant, Options);
                <div class="col">
                    <a href="@assistant.Route" class="card h-100 text-decoration-none text-body hover-interact qm-bg-body qm-hover-bg-secondary">
                        <div class="card-body d-flex gap-3">
                            <i class="bi @assistant.Icon fs-3 text-primary"></i>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                    <h6 class="mb-0">@I18n[assistant.TitleKey]</h6>
                                    @if (status != SettingsStatus.None) {
                                        <span class="badge border @StatusBadge(status)">@I18n[StatusKey(status)]</span>
                                    }
                                </div>
                                <p class="small text-secondary mb-0">@I18n[assistant.DescriptionKey]</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

    <div class="mt-4 text-end">
        <a href="/Administration/Settings/Advanced" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-list-ul me-1"></i>@I18n[I18nKey.Ui.Settings.AdvancedLink]
        </a>
    </div>
}
