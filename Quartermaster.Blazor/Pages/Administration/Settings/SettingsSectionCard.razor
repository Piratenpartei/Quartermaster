@using Quartermaster.Api.I18n

<div class="card mb-4">
    <div class="card-body">
        @if (Section.TitleKey != null) {
            <h5 class="card-title mb-2">@I18n[Section.TitleKey]</h5>
        }
        @if (Section.DescriptionKey != null) {
            <p class="text-secondary small">@I18n[Section.DescriptionKey]</p>
        }

        <OptionGroupEditor @ref="_editor" Fields="@Section.Fields" ShowSaveButton="false" CheckItems="@CheckItems" OnSaved="OnSaved" />

        <div class="d-flex flex-wrap gap-2 mt-3">
            <AsyncButton Text="@I18n[I18nKey.Ui.Common.Save]" Icon="check-circle" Action="Save" Disabled="@Busy" />
            @if (Section.Check != null) {
                <button type="button" class="btn btn-outline-secondary" @onclick="SaveAndCheck" disabled="@Busy">
                    @if (Busy) {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    } else {
                        <i class="bi bi-plug me-1"></i>
                    }
                    @I18n[I18nKey.Ui.Settings.CheckButton]
                </button>
            }
        </div>

        @if (CheckResult != null) {
            <div class="alert @(CheckResult.Success ? "alert-success" : "alert-danger") mt-3 mb-0">
                <i class="bi @(CheckResult.Success ? "bi-check-circle" : "bi-x-circle") me-1"></i>@I18n[CheckResult.MessageKey]
                @if (!string.IsNullOrEmpty(CheckResult.Detail)) {
                    <div class="small mt-1"><code>@CheckResult.Detail</code></div>
                }
                @if (ShowItems()) {
                    <ul class="small mt-2 mb-0">
                        @foreach (var item in CheckResult.Items) {
                            <li>@item</li>
                        }
                    </ul>
                }
            </div>
        }
    </div>
</div>
