@page "/Administration/Setup/Smtp"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<PageBackLink Href="/Administration/Settings" />

<RequirePermission GlobalPermission="@PermissionIdentifier.EditOptions">
    <h3 class="mb-3">@I18n[I18nKey.Ui.SmtpSetup.PageTitle]</h3>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">@I18n[I18nKey.Ui.SmtpSetup.ServerSettingsTitle]</h5>
            <OptionGroupEditor Keys="@SmtpKeys" />
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title mb-3">@I18n[I18nKey.Ui.SmtpSetup.TestSectionTitle]</h5>
            <p class="text-secondary">@I18n[I18nKey.Ui.SmtpSetup.TestDescription]</p>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input type="email" class="form-control" placeholder="@I18n[I18nKey.Ui.SmtpSetup.RecipientPlaceholder]"
                       value="@TestRecipient" @oninput="e => TestRecipient = e.Value?.ToString() ?? string.Empty" />
                <button class="btn btn-primary btn-hover-scale1" @onclick="SendTest" disabled="@(Sending || string.IsNullOrWhiteSpace(TestRecipient))">
                    @if (Sending) {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    @I18n[I18nKey.Ui.SmtpSetup.SendTestButton]
                </button>
            </div>
            @if (TestResult != null) {
                <div class="alert @(TestResult.Success ? "alert-success" : "alert-danger") mt-3 mb-0">
                    @if (TestResult.Success) {
                        <span><i class="bi bi-check-circle me-1"></i>@I18n[I18nKey.Ui.SmtpSetup.TestSuccess]</span>
                    } else {
                        <span><i class="bi bi-x-circle me-1"></i>@I18n[$"{I18nKey.Ui.SmtpSetup.TestErrorPrefix}?error={TestResult.Error}"]</span>
                    }
                </div>
            }
        </div>
    </div>
</RequirePermission>
