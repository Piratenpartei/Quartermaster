@page "/Administration/Templates"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Templates

<div class="mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <PageHeader Title="@I18n[I18nKey.Ui.TemplateList.PageTitle]" />
    <RequirePermission AnyChapterPermission="@PermissionIdentifier.EditTemplates">
        <a href="/Administration/Templates/New" class="btn btn-outline-secondary">
            <i class="bi bi-plus-lg me-1"></i> @I18n[I18nKey.Ui.TemplateList.CreateButton]
        </a>
    </RequirePermission>
</div>

@if (Loading) {
    <LoadingSpinner />
} else if (Templates != null) {
    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.Common.Name]</th>
                <th>@I18n[I18nKey.Ui.TemplateList.IdentifierColumn]</th>
                <th>@I18n[I18nKey.Ui.TemplateList.TypeColumn]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Templates.OrderBy(x => x.IsSystem ? 0 : 1).ThenBy(x => x.DisplayName)) {
                <tr>
                    <td><a href="/Administration/Templates/@t.Id">@t.DisplayName</a></td>
                    <td>
                        <code class="small">@(string.IsNullOrEmpty(t.Identifier) ? t.Id.ToString() : t.Identifier)</code>
                    </td>
                    <td>@TypeLabel(t)</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
