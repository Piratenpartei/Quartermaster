@page "/Administration/Users"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
    <h3 class="mb-0">@I18n[I18nKey.Ui.UserList.PageTitle]</h3>
    <RequirePermission GlobalPermission="@PermissionIdentifier.CreateUser">
        <a class="btn btn-primary" href="/Administration/Users/AddFromKeycloak">
            <i class="bi bi-person-plus me-1"></i>@I18n[I18nKey.Ui.UserList.AddFromKeycloak]
        </a>
    </RequirePermission>
</div>

@if (Loading) {
    <LoadingSpinner />
} else if (Users != null) {
    <div class="mb-2 text-secondary">
        @I18n[$"{I18nKey.Ui.UserList.TotalCount}?count={Users.Count}"]
    </div>

    <div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.UserList.UsernameColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.LastName]</th>
                <th>@I18n[I18nKey.Ui.Common.FirstName]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Users) {
                <tr>
                    <td><a href="/Administration/Users/@user.Id">@(string.IsNullOrEmpty(user.Username) ? "---" : user.Username)</a></td>
                    <td>@user.LastName</td>
                    <td>@user.FirstName</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
