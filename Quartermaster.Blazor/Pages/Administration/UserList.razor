@page "/Administration/Users"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<PageHeader Title="@I18n[I18nKey.Ui.UserList.PageTitle]">
    <Actions>
        <RequirePermission GlobalPermission="@PermissionIdentifier.CreateUser">
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary" disabled="@Refreshing" title="@I18n[I18nKey.Ui.UserList.RefreshFromKeycloakHint]" @onclick="RefreshAsync">
                    @if (Refreshing) {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    } else {
                        <i class="bi bi-arrow-repeat me-1"></i>
                    }
                    @I18n[I18nKey.Ui.UserList.RefreshFromKeycloak]
                </button>
                <a class="btn btn-primary" href="/Administration/Users/AddFromKeycloak">
                    <i class="bi bi-person-plus me-1"></i>@I18n[I18nKey.Ui.UserList.AddFromKeycloak]
                </a>
            </div>
        </RequirePermission>
    </Actions>
</PageHeader>

@if (RefreshResult != null) {
    <div class="alert alert-info">@RefreshSummary(RefreshResult)</div>
}

@if (Loading) {
    <LoadingSpinner />
} else if (Users != null) {
    <div class="mb-2 text-secondary">
        @I18n[$"{I18nKey.Ui.UserList.TotalCount}?count={Users.Count}"]
    </div>

    <div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>@I18n[I18nKey.Ui.UserList.UsernameColumn]</th>
                <th>@I18n[I18nKey.Ui.Common.LastName]</th>
                <th>@I18n[I18nKey.Ui.Common.FirstName]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Users) {
                <tr>
                    <td><a href="/Administration/Users/@user.Id">@(string.IsNullOrEmpty(user.Username) ? "---" : user.Username)</a></td>
                    <td>@user.LastName</td>
                    <td>@user.FirstName</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
