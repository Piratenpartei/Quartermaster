@page "/AssemblyMotions/{Id:guid}"
@using Quartermaster.Api.AssemblyMotions
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.AssemblyMotions

<PageTitle>@I18n[I18nKey.Ui.AssemblyMotion.DetailPageTitle]</PageTitle>

<PageBackLink Href="@BackHref" />

@if (Loading) {
    <LoadingSpinner />
} else if (Motion == null) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.AssemblyMotion.MotionNotFound]</div>
} else {
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <div class="text-secondary">
                @Motion.TypeName (@Motion.TypeCode)
                @if (Motion.NumberLabel != null) {
                    <span> - @Motion.NumberLabel</span>
                }
            </div>
            <h2 class="mb-0">@Motion.Title</h2>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <AssemblyMotionStatusBadge Status="@Motion.Status" IsInRevision="@Motion.IsInRevision" Class="fs-6" />
            @if (Motion.Result != AssemblyMotionResult.None) {
                <span class="badge border border-secondary text-secondary-emphasis fs-6">@AssemblyMotionDisplay.ResultLabel(I18n, Motion.Result)</span>
            }
        </div>
    </div>

    @if (Member != null) {
        <div class="d-flex gap-2 flex-wrap mb-3">
            @if (Member.CanEdit) {
                <a href="/AssemblyMotions/@Id/Edit" class="btn btn-outline-primary">
                    <i class="bi bi-pencil"></i> @I18n[I18nKey.Ui.Common.Edit]
                </a>
            }
            @if (Member.CanRelease) {
                <button class="btn btn-primary" disabled="@Busy" @onclick="Release">
                    <i class="bi bi-send"></i> @I18n[I18nKey.Ui.AssemblyMotion.Release]
                </button>
            }
            @if (Member.CanJoin) {
                <button class="btn btn-success" disabled="@Busy" @onclick="Join">
                    <i class="bi bi-person-plus"></i> @I18n[I18nKey.Ui.AssemblyMotion.Join]
                </button>
            }
            @if (Member.CanLeave) {
                <button class="btn btn-outline-secondary" disabled="@Busy" @onclick="Leave">
                    <i class="bi bi-person-dash"></i> @I18n[I18nKey.Ui.AssemblyMotion.Leave]
                </button>
            }
            @if (Member.CanWithdraw) {
                <button class="btn btn-outline-danger" disabled="@Busy" @onclick="Withdraw">
                    <i class="bi bi-x-circle"></i> @I18n[I18nKey.Ui.AssemblyMotion.Withdraw]
                </button>
            }
            @if (Member.CanDelete) {
                <button class="btn btn-outline-danger" disabled="@Busy" @onclick="DeleteDraft">
                    <i class="bi bi-trash"></i> @I18n[I18nKey.Ui.AssemblyMotion.DeleteDraft]
                </button>
            }
            @if (!string.IsNullOrEmpty(Member.ForumTopicUrl)) {
                <a href="@Member.ForumTopicUrl" target="_blank" rel="noopener" class="btn btn-outline-secondary">
                    <i class="bi bi-chat-square-text"></i> @I18n[I18nKey.Ui.AssemblyMotion.ForumDiscussion]
                </a>
            }
        </div>

        @if (ShowEditLockedHint()) {
            <div class="alert alert-secondary">
                @I18n[I18nKey.Ui.AssemblyMotion.EditLockedHint]
                @if (OpenInquiry != null) {
                    <a class="ms-1" href="/AssemblyMotions/@Id#inquiry-@OpenInquiry.Id">@I18n[I18nKey.Ui.AssemblyMotion.EditLockedInquiryLink]</a>
                }
            </div>
        }

        @if (Motion.Status == AssemblyMotionStatus.CollectingCoSubmitters) {
            <div class="alert alert-info">
                <div>
                    @CollectingProgressText
                    @I18n[I18nKey.Ui.AssemblyMotion.CollectingDeadline] <strong><DeadlineText Value="@Member.EffectiveDeadline" /></strong>
                </div>
                <div class="mt-1">
                    @I18n[I18nKey.Ui.AssemblyMotion.ShareHint] <code>@ShareLink</code>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button class="btn btn-sm btn-outline-primary" @onclick="CopyShareLinkAsync">
                        <i class="bi bi-clipboard"></i> @I18n[I18nKey.Ui.AssemblyMotion.CopyLink]
                    </button>
                    @if (CanShare) {
                        <button class="btn btn-sm btn-outline-primary" @onclick="ShareAsync">
                            <i class="bi bi-share"></i> @I18n[I18nKey.Ui.AssemblyMotion.Share]
                        </button>
                    }
                </div>
            </div>
        }
    }

    @if (Context != null) {
        @if (!Context.IsSignedIn) {
            <div class="alert alert-info">
                @I18n[I18nKey.Ui.AssemblyMotion.SignInHint]
                <a href="/Login">@I18n[I18nKey.Ui.AssemblyMotion.SignInLink]</a>
            </div>
        } else if (!Context.IsEligible) {
            <div class="alert alert-info">
                <strong>@I18n[I18nKey.Ui.AssemblyMotion.JoinNotEligibleTitle]</strong>
                @AssemblyMotionDisplay.ProblemLabel(I18n, Context.Problem)
            </div>
        }
    }

    <AssemblyMotionContentCard Motion="@Motion" ShowCompetitions="@(Member == null)" />

    @if (ShowUpvote) {
        <div class="card mb-3">
            <div class="card-body">
                <h5>@I18n[I18nKey.Ui.AssemblyMotion.PrioritizationTitle]</h5>
                @if (Member != null && Member.HasUpvoted) {
                    <div class="mb-2">
                        <i class="bi bi-star-fill text-warning"></i> @I18n[I18nKey.Ui.AssemblyMotion.UpvotedByYou]
                    </div>
                }
                @if (Motion.UpvoteCount != null) {
                    <div>@UpvoteCountText</div>
                }
                @if (ShowUpvoteToggle && Member != null) {
                    @if (Member.HasUpvoted) {
                        <button class="btn btn-outline-secondary" disabled="@Busy" @onclick="RemoveUpvote">
                            <i class="bi bi-star"></i> @I18n[I18nKey.Ui.AssemblyMotion.UpvoteRemove]
                        </button>
                    } else {
                        <button class="btn btn-primary" disabled="@Busy" @onclick="AddUpvote">
                            <i class="bi bi-star"></i> @I18n[I18nKey.Ui.AssemblyMotion.Upvote]
                        </button>
                    }
                }
            </div>
        </div>
    }

    @if (Member != null) {
        <AssemblyMotionCompetitions Motion="@Member" Types="@PortalTypes" OnChanged="Apply" />

        <AssemblyMotionSubmitterList Submitters="@Member.Submitters" />

        <AssemblyMotionInquiries MotionId="@Id" Inquiries="@Member.Inquiries" CanAnswer="@Member.IsSubmitter" OnChanged="Apply" />

        <AssemblyMotionRevisionHistory MotionId="@Id" CurrentRevision="@Member.Revision" />
    }

    <ConfirmDialog @ref="ReleaseDialog" Title="@I18n[I18nKey.Ui.AssemblyMotion.ReleaseConfirmTitle]" ConfirmText="@I18n[I18nKey.Ui.AssemblyMotion.Release]" />
    <ConfirmDialog @ref="JoinDialog" Title="@I18n[I18nKey.Ui.AssemblyMotion.JoinConfirmTitle]" ConfirmText="@I18n[I18nKey.Ui.AssemblyMotion.Join]" />
    <ConfirmDialog @ref="LeaveDialog" Title="@I18n[I18nKey.Ui.AssemblyMotion.LeaveConfirmTitle]" ConfirmText="@I18n[I18nKey.Ui.AssemblyMotion.Leave]" />
    <ConfirmDialog @ref="WithdrawDialog" Title="@I18n[I18nKey.Ui.AssemblyMotion.WithdrawConfirmTitle]" ConfirmText="@I18n[I18nKey.Ui.AssemblyMotion.Withdraw]" />
    <ConfirmDialog @ref="DeleteDialog" Title="@I18n[I18nKey.Ui.AssemblyMotion.DeleteConfirmTitle]" ConfirmText="@I18n[I18nKey.Ui.AssemblyMotion.DeleteDraft]" />
}
