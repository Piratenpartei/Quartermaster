@page "/Events/{EventId:guid}/Motions/New"
@page "/AssemblyMotions/{Id:guid}/Edit"
@using Quartermaster.Api.AssemblyMotions
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.AssemblyMotions

<PageTitle>@I18n[I18nKey.Ui.AssemblyMotion.EditorPageTitle]</PageTitle>

<PageBackLink Href="@BackHref" />

@if (Loading) {
    <LoadingSpinner />
} else if (!AuthService.IsAuthenticated) {
    <div class="alert alert-info">
        @I18n[I18nKey.Ui.AssemblyMotion.SignInHint]
        <a href="/Login">@I18n[I18nKey.Ui.AssemblyMotion.SignInLink]</a>
    </div>
} else if (Portal == null || (IsExisting && Detail == null)) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.AssemblyMotion.MotionNotFound]</div>
} else if (!IsExisting && Context != null && !Context.IsEligible) {
    <div class="alert alert-info">
        <strong>@I18n[I18nKey.Ui.AssemblyMotion.NotEligibleTitle]</strong>
        @AssemblyMotionDisplay.ProblemLabel(I18n, Context.Problem)
    </div>
} else if (!IsExisting && !AssemblyMotionDisplay.IsPortalOpen(Portal)) {
    <div class="alert alert-info">@AssemblyMotionDisplay.PortalClosedText(I18n, Portal)</div>
} else if (IsExisting && !Detail!.CanEdit) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.AssemblyMotion.EditNotAllowed]</div>
} else {
    <PageHeader Title="@(IsExisting ? I18n[I18nKey.Ui.AssemblyMotion.EditMotionTitle] : I18n[I18nKey.Ui.AssemblyMotion.NewMotion])" />

    @if (IsRevisionEdit) {
        <div class="alert alert-warning">
            <strong>@I18n[I18nKey.Ui.AssemblyMotion.RevisionWarningTitle]</strong>
            @RevisionWarning
        </div>
    }

    @if (Conflict != null) {
        <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>@Conflict</span>
            <button class="btn btn-outline-danger" @onclick="ReloadAsync">
                <i class="bi bi-arrow-clockwise"></i> @I18n[I18nKey.Ui.AssemblyMotion.Reload]
            </button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <AssemblyMotionFieldsForm Values="@Fields" Portal="@Portal" TypeLocked="@TypeLocked" TypeChanged="@StateHasChanged" />

            <div class="d-flex gap-2 flex-wrap">
                @if (IsDraftOrNew) {
                    <button class="btn btn-outline-secondary" disabled="@Saving" @onclick="SaveDraft">
                        <i class="bi bi-save"></i> @I18n[I18nKey.Ui.AssemblyMotion.SaveDraft]
                    </button>
                    <button class="btn btn-primary" disabled="@Saving" @onclick="Release">
                        <i class="bi bi-send"></i> @I18n[I18nKey.Ui.AssemblyMotion.Release]
                    </button>
                } else {
                    <button class="btn btn-primary" disabled="@Saving" @onclick="SaveDraft">
                        <i class="bi bi-save"></i> @I18n[I18nKey.Ui.AssemblyMotion.SaveChanges]
                    </button>
                }
                <a href="@BackHref" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> @I18n[I18nKey.Ui.Common.Cancel]</a>
            </div>
        </div>
    </div>

    <ConfirmDialog @ref="RevisionDialog" Title="@I18n[I18nKey.Ui.AssemblyMotion.RevisionWarningTitle]" ConfirmText="@I18n[I18nKey.Ui.AssemblyMotion.SaveChanges]" />
    <ConfirmDialog @ref="ReleaseDialog" Title="@I18n[I18nKey.Ui.AssemblyMotion.ReleaseConfirmTitle]" ConfirmText="@I18n[I18nKey.Ui.AssemblyMotion.Release]" />
    <ConfirmDialog @ref="ReloadDialog" Title="@I18n[I18nKey.Ui.AssemblyMotion.ReloadConfirmTitle]" ConfirmText="@I18n[I18nKey.Ui.AssemblyMotion.Reload]" />
}
