@page "/Events/{EventId:guid}/Motions/New"
@page "/AssemblyMotions/{Id:guid}/Edit"
@using Quartermaster.Api.AssemblyMotions
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.AssemblyMotions
@using Quartermaster.Rendering

<PageTitle>@I18n[I18nKey.Ui.AssemblyMotion.EditorPageTitle]</PageTitle>

<PageBackLink Href="@BackHref" />

@if (Loading) {
    <LoadingSpinner />
} else if (!AuthService.IsAuthenticated) {
    <div class="alert alert-info">
        @I18n[I18nKey.Ui.AssemblyMotion.SignInHint]
        <a href="/Login">@I18n[I18nKey.Ui.AssemblyMotion.SignInLink]</a>
    </div>
} else if (Portal == null || (IsExisting && Detail == null)) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.AssemblyMotion.MotionNotFound]</div>
} else if (!IsExisting && Context != null && !Context.IsEligible) {
    <div class="alert alert-info">
        <strong>@I18n[I18nKey.Ui.AssemblyMotion.NotEligibleTitle]</strong>
        @AssemblyMotionDisplay.ProblemLabel(I18n, Context.Problem)
    </div>
} else if (IsExisting && !Detail!.CanEdit) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.AssemblyMotion.EditNotAllowed]</div>
} else {
    <h2>@(IsExisting ? I18n[I18nKey.Ui.AssemblyMotion.EditMotionTitle] : I18n[I18nKey.Ui.AssemblyMotion.NewMotion])</h2>

    @if (IsRevisionEdit) {
        <div class="alert alert-warning">
            <strong>@I18n[I18nKey.Ui.AssemblyMotion.RevisionWarningTitle]</strong>
            @RevisionWarning
        </div>
    }

    @if (Conflict != null) {
        <div class="alert alert-danger d-flex justify-content-between align-items-center">
            <span>@Conflict</span>
            <button class="btn btn-sm btn-outline-danger" @onclick="ReloadAsync">
                <i class="bi bi-arrow-clockwise"></i> @I18n[I18nKey.Ui.AssemblyMotion.Reload]
            </button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldType] <RequiredStar /></label>
                <FormSelect Value="@TypeId" ValueChanged="OnTypeChanged" Disabled="@TypeLocked">
                    @foreach (var type in Portal.Types) {
                        <option value="@type.Id">@type.Code - @type.Name</option>
                    }
                </FormSelect>
                @if (SelectedType != null) {
                    <div class="form-text">
                        @I18n[I18nKey.Ui.AssemblyMotion.TypeDeadline] <strong>@AssemblyMotionDisplay.Berlin(SelectedType.Deadline ?? Portal.ClosesAt)</strong>
                        @if (SelectedType.CompetingDeadline != null) {
                            <span> (@I18n[I18nKey.Ui.AssemblyMotion.TypeCompetingDeadline] <strong>@AssemblyMotionDisplay.Berlin(SelectedType.CompetingDeadline.Value)</strong>)</span>
                        }
                        <br />
                        @I18n[I18nKey.Ui.AssemblyMotion.TypeMinSubmitters] <strong>@SelectedType.MinSubmitters</strong>,
                        @AssemblyMotionDisplay.MajorityLabel(I18n, SelectedType.RequiredMajority)
                    </div>
                }
            </div>
            <div class="mb-3">
                <label class="form-label">@I18n[I18nKey.Ui.Common.Title] <RequiredStar /></label>
                <FormInput @bind-Value="Title" />
            </div>
            <div class="mb-3">
                <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldSection]</label>
                <FormInput @bind-Value="Section" />
                <div class="form-text">@I18n[I18nKey.Ui.AssemblyMotion.SectionHelp]</div>
            </div>
            <div class="mb-3">
                <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldText] <RequiredStar /></label>
                <MarkdownEditorWithPreview @bind-Value="TextMarkdown" Rows="12" Flavor="MarkdownFlavor.Motion" />
                <div class="form-text">@I18n[I18nKey.Ui.AssemblyMotion.FormattingHelp]</div>
            </div>
            <div class="mb-3">
                <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldReason] <RequiredStar /></label>
                <MarkdownEditorWithPreview @bind-Value="ReasonMarkdown" Rows="10" Flavor="MarkdownFlavor.Motion" />
                <div class="form-text">@I18n[I18nKey.Ui.AssemblyMotion.FormattingHelp]</div>
            </div>
            <div class="mb-3">
                <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldSummary]</label>
                <FormInput @bind-Value="Summary" />
            </div>
            <div class="mb-3">
                <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldKeywords]</label>
                <FormInput @bind-Value="Keywords" />
                <div class="form-text">@I18n[I18nKey.Ui.AssemblyMotion.KeywordsHelp]</div>
            </div>
            <div class="mb-3">
                <label class="form-label">@I18n[I18nKey.Ui.AssemblyMotion.FieldPriorDiscussion]</label>
                <FormInput @bind-Value="PriorDiscussion" />
            </div>

            <div class="d-flex gap-2 flex-wrap">
                @if (IsDraftOrNew) {
                    <button class="btn btn-outline-primary" disabled="@Saving" @onclick="SaveDraft">
                        <i class="bi bi-save"></i> @I18n[I18nKey.Ui.AssemblyMotion.SaveDraft]
                    </button>
                    <button class="btn btn-primary" disabled="@Saving" @onclick="Release">
                        <i class="bi bi-send"></i> @I18n[I18nKey.Ui.AssemblyMotion.Release]
                    </button>
                } else {
                    <button class="btn btn-primary" disabled="@Saving" @onclick="SaveDraft">
                        <i class="bi bi-save"></i> @I18n[I18nKey.Ui.AssemblyMotion.SaveChanges]
                    </button>
                }
                <a href="@BackHref" class="btn btn-outline-secondary">@I18n[I18nKey.Ui.Common.Cancel]</a>
            </div>
        </div>
    </div>

    <ConfirmDialog @ref="_revisionDialog" Title="@I18n[I18nKey.Ui.AssemblyMotion.RevisionWarningTitle]" ConfirmText="@I18n[I18nKey.Ui.AssemblyMotion.SaveChanges]" />
    <ConfirmDialog @ref="_reloadDialog" Title="@I18n[I18nKey.Ui.AssemblyMotion.ReloadConfirmTitle]" ConfirmText="@I18n[I18nKey.Ui.AssemblyMotion.Reload]" />
}
