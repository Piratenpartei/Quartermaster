@page "/Events/{EventId:guid}/Motions/Mine"
@using Quartermaster.Api.AssemblyMotions
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.AssemblyMotions

<PageTitle>@I18n[I18nKey.Ui.AssemblyMotion.MinePageTitle]</PageTitle>

<PageHeader Title="@I18n[I18nKey.Ui.AssemblyMotion.MinePageTitle]" BackHref="@($"/Events/{EventId}/Motions")" />

@if (Loading) {
    <LoadingSpinner />
} else if (!AuthService.IsAuthenticated) {
    <div class="alert alert-info">
        @I18n[I18nKey.Ui.AssemblyMotion.SignInHint]
        <a href="/Login">@I18n[I18nKey.Ui.AssemblyMotion.SignInLink]</a>
    </div>
} else if (Forbidden) {
    <div class="alert alert-info">@I18n[I18nKey.Ui.AssemblyMotion.MembersOnly]</div>
} else if (Items.Count == 0) {
    <EmptyState Message="@I18n[I18nKey.Ui.AssemblyMotion.NoOwnMotions]" />
} else {
    <div class="card mb-4">
        <div class="card-body">
            <ResponsiveList Items="@Items">
                <Header>
                    <tr>
                        <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnNumber]</th>
                        <th>@I18n[I18nKey.Ui.Common.Title]</th>
                        <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnRole]</th>
                        <th>@I18n[I18nKey.Ui.Common.Status]</th>
                        <th class="text-end">@I18n[I18nKey.Ui.AssemblyMotion.ColumnInquiries]</th>
                    </tr>
                </Header>
                <Row Context="item">
                    <tr>
                        <td class="text-nowrap">@(item.NumberLabel ?? "-")</td>
                        <td><a href="/AssemblyMotions/@item.Id">@item.Title</a></td>
                        <td>@RoleLabel(item.IsAuthor)</td>
                        <td><AssemblyMotionStatusBadge Status="@item.Status" /></td>
                        <td class="text-end">
                            @if (item.OpenInquiryCount > 0) {
                                <StatusBadge Tone="StatusTone.Warning" Text="@item.OpenInquiryCount.ToString()" />
                            }
                        </td>
                    </tr>
                </Row>
                <Stacked Context="item">
                    <a class="fw-semibold" href="/AssemblyMotions/@item.Id">@item.Title</a>
                    <div class="d-flex flex-wrap align-items-center gap-2 small text-secondary mt-1">
                        <span class="text-nowrap">@(item.NumberLabel ?? "-")</span>
                        <span>@RoleLabel(item.IsAuthor)</span>
                        <AssemblyMotionStatusBadge Status="@item.Status" />
                        @if (item.OpenInquiryCount > 0) {
                            <StatusBadge Tone="StatusTone.Warning" Icon="question-circle" Text="@item.OpenInquiryCount.ToString()" />
                        }
                    </div>
                </Stacked>
            </ResponsiveList>
        </div>
    </div>
}
