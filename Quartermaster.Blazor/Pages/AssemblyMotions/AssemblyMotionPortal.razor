@page "/Events/{EventId:guid}/Motions"
@using Quartermaster.Api.AssemblyMotions
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.AssemblyMotions
@using Quartermaster.Blazor.Components.Events

<PageTitle>@I18n[I18nKey.Ui.AssemblyMotion.PortalPageTitle]</PageTitle>

@if (Loading) {
    <PageBackLink Href="@($"/Events/{EventId}")" />
    <LoadingSpinner />
} else if (Portal == null) {
    <PageBackLink Href="@($"/Events/{EventId}")" />
    <div class="alert alert-warning">@I18n[I18nKey.Ui.AssemblyMotion.PortalNotFound]</div>
} else {
    <PageHeader Title="@Portal.EventName" BackHref="@($"/Events/{EventId}")">
        <Subtitle>
            <span>
                @I18n[I18nKey.Ui.AssemblyMotion.PortalWindow]
                <strong>@AssemblyMotionDisplay.Berlin(Portal.OpensAt)</strong>
                @I18n[I18nKey.Ui.AssemblyMotion.PortalWindowTo]
                <strong><DeadlineText Value="@Portal.ClosesAt" /></strong>
            </span>
            @if (Context != null && Context.IsEligible && !AssemblyMotionDisplay.IsPortalOpen(Portal)) {
                <span>@AssemblyMotionDisplay.PortalClosedText(I18n, Portal)</span>
            }
        </Subtitle>
        <Actions>
            @if (Context != null && Context.IsEligible) {
                @if (AssemblyMotionDisplay.IsPortalOpen(Portal)) {
                    <a href="/Events/@EventId/Motions/New" class="btn btn-primary">
                        <i class="bi bi-plus-lg"></i> @I18n[I18nKey.Ui.AssemblyMotion.NewMotion]
                    </a>
                }
                <a href="/Events/@EventId/Motions/Collecting" class="btn btn-outline-secondary">
                    <i class="bi bi-people"></i> @I18n[I18nKey.Ui.AssemblyMotion.CollectingButton]
                </a>
                <a href="/Events/@EventId/Motions/Mine" class="btn btn-outline-secondary">
                    <i class="bi bi-person"></i> @I18n[I18nKey.Ui.AssemblyMotion.MineButton]
                </a>
            }
            @if (RankingAvailable) {
                <a href="/Events/@EventId/Motions/Ranking" class="btn btn-outline-secondary">
                    <i class="bi bi-list-ol"></i> @I18n[I18nKey.Ui.AssemblyMotion.RankingLink]
                </a>
            }
            <EventSubscriptionToggle EventId="EventId" />
        </Actions>
        <Links>
            @if (Context != null && Context.IsCommission) {
                <a href="/Administration/Events/@EventId/Motions" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-clipboard-check"></i> @I18n[I18nKey.Ui.AssemblyMotion.CommissionButton]
                </a>
            }
        </Links>
    </PageHeader>

    @if (Context != null && Context.IsSignedIn && !Context.IsEligible) {
        <div class="alert alert-info">
            <strong>@I18n[I18nKey.Ui.AssemblyMotion.NotEligibleTitle]</strong>
            @AssemblyMotionDisplay.ProblemLabel(I18n, Context.Problem)
        </div>
    } else if (Context != null && !Context.IsSignedIn) {
        <div class="alert alert-info">
            @I18n[I18nKey.Ui.AssemblyMotion.SignInHint]
            <a href="/Login">@I18n[I18nKey.Ui.AssemblyMotion.SignInLink]</a>
        </div>
    }

    @if (PrioritizationOpen && Portal.PrioritizationEndsAt != null) {
        <div class="alert alert-info">
            @I18n[I18nParams.With(I18nKey.Ui.AssemblyMotion.PrioritizationOpenHint, ("date", AssemblyMotionDisplay.Deadline(I18n, Portal.PrioritizationEndsAt.Value)))]
        </div>
    }

    @if (!string.IsNullOrEmpty(Portal.IntroHtml)) {
        <div class="card mb-4">
            <div class="card-body rendered-markdown">
                @((MarkupString)Portal.IntroHtml)
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="mb-3">@I18n[I18nKey.Ui.AssemblyMotion.DeadlinesTitle]</h5>
            <ResponsiveList Items="@Portal.Types">
                <Header>
                    <tr>
                        <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnType]</th>
                        <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnCode]</th>
                        <th class="text-end">@I18n[I18nKey.Ui.AssemblyMotion.ColumnMinSubmitters]</th>
                        <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnDeadline]</th>
                        <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnCompetingDeadline]</th>
                    </tr>
                </Header>
                <Row Context="type">
                    <tr>
                        <td>@type.Name</td>
                        <td>@type.Code</td>
                        <td class="text-end">@type.MinSubmitters</td>
                        <td><DeadlineText Value="@(type.Deadline ?? Portal.ClosesAt)" /></td>
                        <td><DeadlineText Value="@type.CompetingDeadline" /></td>
                    </tr>
                </Row>
                <Stacked Context="type">
                    <div class="fw-semibold">@type.Name (@type.Code)</div>
                    <div class="small text-secondary">@I18n[I18nKey.Ui.AssemblyMotion.ColumnMinSubmitters]: @type.MinSubmitters</div>
                    <div class="small text-secondary">@I18n[I18nKey.Ui.AssemblyMotion.ColumnDeadline]: <DeadlineText Value="@(type.Deadline ?? Portal.ClosesAt)" /></div>
                    @if (type.CompetingDeadline != null) {
                        <div class="small text-secondary">@I18n[I18nKey.Ui.AssemblyMotion.ColumnCompetingDeadline]: <DeadlineText Value="@type.CompetingDeadline" /></div>
                    }
                </Stacked>
            </ResponsiveList>
        </div>
    </div>

    <div class="row g-2 mb-4">
        <div class="col-md-3">
            <FormSelect Value="@FilterTypeId" ValueChanged="OnTypeFilterChanged">
                <option value="">@I18n[I18nKey.Ui.AssemblyMotion.FilterAllTypes]</option>
                @foreach (var type in Portal.Types) {
                    <option value="@type.Id">@type.Name</option>
                }
            </FormSelect>
        </div>
        <div class="col-md-3">
            <FormSelect Value="@FilterStatus" ValueChanged="OnStatusFilterChanged">
                <option value="">@I18n[I18nKey.Ui.AssemblyMotion.FilterAllStatuses]</option>
                @foreach (var status in _filterStatuses) {
                    <option value="@((int)status)">@AssemblyMotionDisplay.StatusLabel(I18n, status, false)</option>
                }
            </FormSelect>
        </div>
        <div class="col-md-6">
            <div class="input-group">
                <input type="search" class="form-control" value="@Search" @oninput="OnSearchInput" @onkeydown="OnSearchKeyDown"
                       placeholder="@I18n[I18nKey.Ui.AssemblyMotion.SearchPlaceholder]" />
                <button class="btn btn-outline-secondary" @onclick="ApplySearch">
                    <i class="bi bi-search"></i> @I18n[I18nKey.Ui.Common.Search]
                </button>
            </div>
        </div>
    </div>

    @if (ListLoading) {
        <LoadingSpinner />
    } else if (Items.Count == 0) {
        <EmptyState Message="@I18n[I18nKey.Ui.AssemblyMotion.NoMotions]" />
    } else {
        @foreach (var group in GetGroups()) {
            var first = group.First();
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="mb-3">@first.TypeName (@first.TypeCode)</h5>
                    <ResponsiveList Items="@group.ToList()">
                        <Header>
                            <tr>
                                <th>@I18n[I18nKey.Ui.AssemblyMotion.ColumnNumber]</th>
                                <th>@I18n[I18nKey.Ui.Common.Title]</th>
                                <th class="text-end">@I18n[I18nKey.Ui.Common.Status]</th>
                            </tr>
                        </Header>
                        <Row Context="item">
                            <tr>
                                <td class="text-nowrap">@(item.NumberLabel ?? "-")</td>
                                <td>
                                    <a href="/AssemblyMotions/@item.Id">@item.Title</a>
                                    @if (UpvotedIds.Contains(item.Id)) {
                                        <StatusBadge Tone="StatusTone.Warning" Icon="star-fill" Text="@I18n[I18nKey.Ui.AssemblyMotion.UpvotedMarker]" Class="ms-1" />
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap justify-content-end gap-1">
                                        <AssemblyMotionStatusBadge Status="@item.Status" IsInRevision="@item.IsInRevision" />
                                        @if (item.Result != AssemblyMotionResult.None) {
                                            <StatusBadge Tone="StatusTone.Neutral" Text="@AssemblyMotionDisplay.ResultLabel(I18n, item.Result)" />
                                        }
                                    </div>
                                </td>
                            </tr>
                        </Row>
                        <Stacked Context="item">
                            <a class="fw-semibold" href="/AssemblyMotions/@item.Id">@item.Title</a>
                            <div class="d-flex flex-wrap align-items-center gap-2 small text-secondary mt-1">
                                <span class="text-nowrap">@(item.NumberLabel ?? "-")</span>
                                <AssemblyMotionStatusBadge Status="@item.Status" IsInRevision="@item.IsInRevision" />
                                @if (item.Result != AssemblyMotionResult.None) {
                                    <StatusBadge Tone="StatusTone.Neutral" Text="@AssemblyMotionDisplay.ResultLabel(I18n, item.Result)" />
                                }
                                @if (UpvotedIds.Contains(item.Id)) {
                                    <StatusBadge Tone="StatusTone.Warning" Icon="star-fill" Text="@I18n[I18nKey.Ui.AssemblyMotion.UpvotedMarker]" />
                                }
                            </div>
                        </Stacked>
                    </ResponsiveList>
                </div>
            </div>
        }
        <Pagination CurrentPage="@CurrentPage" TotalPages="@TotalPages" OnPageChanged="OnPageChanged" />
    }
}
