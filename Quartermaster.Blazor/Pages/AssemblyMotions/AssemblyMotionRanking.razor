@page "/Events/{EventId:guid}/Motions/Ranking"
@using Quartermaster.Api.AssemblyMotions
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.AssemblyMotions

<PageTitle>@I18n[I18nKey.Ui.AssemblyMotion.RankingPageTitle]</PageTitle>

@if (Loading) {
    <PageBackLink Href="@($"/Events/{EventId}/Motions")" />
    <LoadingSpinner />
} else if (Portal == null) {
    <PageBackLink Href="@($"/Events/{EventId}/Motions")" />
    <div class="alert alert-warning">@I18n[I18nKey.Ui.AssemblyMotion.PortalNotFound]</div>
} else {
    <PageHeader Title="@I18n[I18nKey.Ui.AssemblyMotion.RankingPageTitle]" BackHref="@($"/Events/{EventId}/Motions")">
        <Subtitle>@Portal.EventName</Subtitle>
    </PageHeader>

    @if (NotAvailable) {
        <div class="alert alert-info">@NotAvailableText</div>
    } else if (Items.Count == 0) {
        <EmptyState Message="@I18n[I18nKey.Ui.AssemblyMotion.RankingEmpty]" />
    } else {
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button type="button" class="nav-link @(ByType ? "" : "active")" @onclick="() => SwitchView(false)">@I18n[I18nKey.Ui.AssemblyMotion.RankingTabOverall]</button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link @(ByType ? "active" : "")" @onclick="() => SwitchView(true)">@I18n[I18nKey.Ui.AssemblyMotion.RankingTabByType]</button>
            </li>
        </ul>

        @if (ByType) {
            @foreach (var group in Groups) {
                var first = group.First();
                <div class="card mb-4" @key="group.Key">
                    <div class="card-body">
                        <h5 class="mb-3">@first.TypeName (@first.TypeCode)</h5>
                        <AssemblyMotionRankingTable Items="@group.ToList()" />
                    </div>
                </div>
            }
        } else {
            <div class="card mb-4">
                <div class="card-body">
                    <AssemblyMotionRankingTable Items="@Items" />
                </div>
            </div>
        }
    }
}
