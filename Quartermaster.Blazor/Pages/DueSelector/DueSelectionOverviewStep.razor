@using Quartermaster.Api.I18n

<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.ApplicationSummary.PersonalDataSection]</h5>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>@I18n[I18nKey.Ui.ApplicationSummary.NameLabel]:</strong> @State.FirstName @State.LastName</li>
            <li class="list-group-item"><strong>@I18n[I18nKey.Ui.ApplicationSummary.EmailLabel]:</strong> @State.Email</li>
            <li class="list-group-item"><strong>@I18n[I18nKey.Ui.DueSelectorUserData.MemberNumberLabel]:</strong> @State.MemberNumber</li>
        </ul>
    </div>
</div>

<DuesSummary State="@State" />

<h5 class="mb-0">@I18n[I18nKey.Ui.DueSelectorSummary.AreAllDataCorrectHeader]</h5>
