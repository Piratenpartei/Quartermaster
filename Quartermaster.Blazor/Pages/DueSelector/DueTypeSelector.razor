@page "/DueSelector/DueTypeSelector"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.DueTypeSelector.PageTitle]</h3>
</div>

@if (EntryState == null)
    return;

<div class="mb-2">
    <CardLink HRef="/DueSelector/SelectOnePercentYearlyPay" OnNavigate=@(() => SelectDueType(SelectedValuation.OnePercentYearlyPay))>
        <span>@I18n[I18nKey.Ui.DuesTypeSelection.OnePercentLabel]</span>
        <span class="fw-bold">@I18n[I18nKey.Ui.DuesTypeSelection.RecommendedBadge]</span>
    </CardLink>
</div>

<div class="mb-2">
    <CardLink HRef="/DueSelector/SelectByMonthlyPay" OnNavigate=@(() => SelectDueType(SelectedValuation.MonthlyPayGroup))>
        <span>@I18n[I18nKey.Ui.DuesTypeSelection.MonthlyPayLabel]</span>
    </CardLink>
</div>

<div class="mb-2">
    <CardLink HRef="@($"/DueSelector/PaymentOptionSelection/{System.Net.WebUtility.UrlEncode("/DueSelector/DueTypeSelector")}")"
              OnNavigate=@(() => HandleUnderage(SelectedValuation.Underage))>
        <span>@I18n[I18nKey.Ui.DuesTypeSelection.UnderageLabel]</span><br />
        <span>@I18n[I18nKey.Ui.DuesTypeSelection.UnderageHint]</span>
    </CardLink>
</div>

<div class="mb-3">
    <CardLink HRef="/DueSelector/SelectReduced" OnNavigate=@(() => SelectDueType(SelectedValuation.Reduced))>
        <span>@I18n[I18nKey.Ui.DuesTypeSelection.ReducedLabel]</span>
    </CardLink>
</div>

<div>
    <a href="/DueSelector/UserDataInput" class="btn btn-primary">@I18n[I18nKey.Ui.Common.Back]</a>
</div>
