@using Quartermaster.Api.DueSelector
@using Quartermaster.Api.I18n

<p class="text-secondary">@I18n[I18nKey.Ui.DuesTypeSelection.Instruction]</p>

<div class="d-grid gap-2 mb-3" role="radiogroup">
    <ChoiceCard Name="dues-valuation" Selected="@IsSelected(SelectedValuation.OnePercentYearlyPay)" OnSelect="() => Select(SelectedValuation.OnePercentYearlyPay)">
        <span>@I18n[I18nKey.Ui.DuesTypeSelection.OnePercentLabel]</span>
        <StatusBadge Tone="StatusTone.Info" Text="@I18n[I18nKey.Ui.DuesTypeSelection.RecommendedBadge]" Class="ms-1" />
    </ChoiceCard>
    <ChoiceCard Name="dues-valuation" Selected="@IsSelected(SelectedValuation.MonthlyPayGroup)" OnSelect="() => Select(SelectedValuation.MonthlyPayGroup)">
        @I18n[I18nKey.Ui.DuesTypeSelection.MonthlyPayLabel]
    </ChoiceCard>
    <ChoiceCard Name="dues-valuation" Selected="@IsSelected(SelectedValuation.Underage)" OnSelect="() => Select(SelectedValuation.Underage)">
        <div>@I18n[I18nKey.Ui.DuesTypeSelection.UnderageLabel]</div>
        <div class="small text-secondary">@I18n[I18nKey.Ui.DuesTypeSelection.UnderageHint]</div>
    </ChoiceCard>
    <ChoiceCard Name="dues-valuation" Selected="@IsSelected(SelectedValuation.Reduced)" OnSelect="() => Select(SelectedValuation.Reduced)">
        @I18n[I18nKey.Ui.DuesTypeSelection.ReducedLabel]
    </ChoiceCard>
</div>

@if (State.SelectedValuation == SelectedValuation.OnePercentYearlyPay) {
    var isValid = State.YearlyIncome >= DueSelectorEntryState.MinimumOnePercentIncome;
    <hr />
    <div class="mb-2">
        <label for="yearlyIncome" class="form-label">@I18n[I18nKey.Ui.SelectOnePercentYearlyPay.YearlyIncomeLabel]</label>
        <div class="input-group @(isValid ? "" : "has-validation")">
            <span class="input-group-text">€</span>
            <input type="number" class="form-control @(isValid ? "" : "is-invalid")" id="yearlyIncome"
                   min="7200" @bind="State.YearlyIncome" @bind:event="oninput" @bind:after="State.RecalculateDue" />
            @if (!isValid) {
                <div class="invalid-feedback">
                    @I18n[I18nKey.Ui.SelectOnePercentYearlyPay.IncomeTooLowLine1]<br />
                    @I18n[I18nKey.Ui.SelectOnePercentYearlyPay.IncomeTooLowLine2]<br />
                    @I18n[I18nKey.Ui.SelectOnePercentYearlyPay.IncomeTooLowLine3]
                </div>
            }
        </div>
    </div>
    <div class="mb-0">
        <label for="calculatedYearlyDue" class="form-label">@I18n[I18nKey.Ui.SelectOnePercentYearlyPay.CalculatedYearlyDueLabel]</label>
        <input type="text" class="form-control" id="calculatedYearlyDue" value="@FormatAmount(State.SelectedDue)" readonly disabled />
    </div>
} else if (State.SelectedValuation == SelectedValuation.MonthlyPayGroup) {
    <hr />
    <MonthlyIncomeGroupInput State="@State" />
} else if (State.SelectedValuation == SelectedValuation.Reduced) {
    var justificationMissing = string.IsNullOrWhiteSpace(State.ReducedJustification);
    var amountInvalid = State.ReducedAmount != null && !State.IsReducedAmountValid();
    <hr />
    <div class="mb-3">
        <label for="reducedJustification" class="form-label">@I18n[I18nKey.Ui.SelectReduced.JustificationLabel] <RequiredStar /></label>
        <textarea class="form-control" id="reducedJustification" @bind="State.ReducedJustification" @bind:event="oninput" maxlength="2048"></textarea>
        @if (justificationMissing) {
            <div class="form-text">@I18n[I18nKey.Ui.SelectReduced.JustificationRequired]</div>
        }
    </div>
    <div class="mb-3">
        <label for="reducedAmount" class="form-label">@I18n[I18nKey.Ui.SelectReduced.YearlyAmountLabel] <RequiredStar /></label>
        <div class="input-group @(amountInvalid ? "has-validation" : "")">
            <span class="input-group-text">€</span>
            <input type="number" class="form-control @(amountInvalid ? "is-invalid" : "")" id="reducedAmount"
                   min="@MinimumAmountValue()" max="@MaximumAmountValue()" step="1" @bind="State.ReducedAmount" @bind:event="oninput" />
            @if (amountInvalid) {
                <div class="invalid-feedback">@I18n[RangeText(I18nKey.Ui.SelectReduced.AmountOutOfRangeFeedback)]</div>
            }
        </div>
        @if (!amountInvalid) {
            <div class="form-text">@I18n[RangeText(I18nKey.Ui.SelectReduced.AmountRangeHint)]</div>
        }
    </div>
    <div class="mb-3">
        @if (Config.PermanentReductionEnabled) {
            <RadioGroup E="ReducedTimeSpan" @bind-Value="State.ReducedTimeSpan" ToStringFunc="TextForReducedTimeSpan" />
        } else {
            <p class="mb-0">@I18n[I18nKey.Ui.SelectReduced.OneYearOnlyNotice]</p>
        }
    </div>

    <h5>@I18n[I18nKey.Ui.SelectReduced.ClassificationHeader]</h5>
    <p>@I18n[I18nKey.Ui.SelectReduced.ClassificationNotice]</p>
    @if (State.ReducedIncomeFallback) {
        <MonthlyIncomeGroupInput State="@State" />
        <div class="mt-3">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ConfirmSkipClassification">
                @I18n[I18nKey.Ui.SelectReduced.SkipOption]
            </button>
        </div>
    } else {
        <div class="alert alert-warning mb-0">
            <p>@I18n[I18nParams.With(I18nKey.Ui.SelectReduced.SkippedNotice, ("amount", FormatWholeAmount(DueSelectionRates.RejectedReductionDue)))]</p>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SetIncomeFallback(true)">
                @I18n[I18nKey.Ui.SelectReduced.ClassifyAgainButton]
            </button>
        </div>
    }
}

<ConfirmDialog @ref="SkipConfirm" Title="@I18n[I18nKey.Ui.SelectReduced.SkipConfirmTitle]"
               ConfirmText="@I18n[I18nKey.Ui.SelectReduced.SkipConfirmButton]" />
