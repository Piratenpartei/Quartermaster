@using Quartermaster.Api.DueSelector
@using Quartermaster.Api.I18n

<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.DueSelectorSummary.YourChosenDueHeader]</h5>
        @if (State.SelectedValuation == SelectedValuation.MonthlyPayGroup) {
            <p class="card-text">@Markup(I18nKey.Ui.DueSelectorSummary.MonthlyPayAmountLine, ("amount", Amount(State.SelectedDue)))</p>
            <p class="card-text">@Markup(I18nKey.Ui.DueSelectorSummary.MonthlyPayBasisLine, ("income", Amount(State.MonthlyIncomeGroup)))</p>
        } else if (State.SelectedValuation == SelectedValuation.OnePercentYearlyPay) {
            <p class="card-text">@Markup(I18nKey.Ui.DueSelectorSummary.OnePercentAmountLine, ("amount", Amount(State.SelectedDue)))</p>
            <p class="card-text">@Markup(I18nKey.Ui.DueSelectorSummary.OnePercentBasisLine, ("income", Amount(State.YearlyIncome)))</p>
        } else if (State.SelectedValuation == SelectedValuation.Reduced) {
            <p class="card-text">@Markup(I18nKey.Ui.DueSelectorSummary.ReducedAmountLine, ("amount", Amount(State.ReducedAmount)))</p>
            <p class="card-text">@Markup(I18nKey.Ui.DueSelectorSummary.ReducedJustificationLine, ("justification", Encode(State.ReducedJustification)))</p>
            <p class="card-text">
                @I18n[State.ReducedTimeSpan == ReducedTimeSpan.Permanent ? I18nKey.Ui.DueSelectorSummary.ReducedPermanentLine : I18nKey.Ui.DueSelectorSummary.ReducedOneYearLine]
            </p>
            @if (State.ReducedIncomeFallback) {
                <p class="card-text">
                    @Markup(I18nKey.Ui.DueSelectorSummary.ReducedFallbackLine, ("income", Amount(State.MonthlyIncomeGroup)), ("amount", Amount(State.SelectedDue)))
                </p>
            }
        } else if (State.SelectedValuation == SelectedValuation.Underage) {
            <p class="card-text">@Markup(I18nKey.Ui.DueSelectorSummary.UnderageLine, ("amount", Amount(DueSelectorEntryState.UnderageDue)))</p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.DueSelectorSummary.PaymentMethodHeader]</h5>
        @if (State.IsDirectDeposit) {
            <p class="card-text">@I18n[I18nKey.Ui.DueSelectorSummary.DirectDepositLine]</p>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>@I18n[I18nKey.Ui.DueSelectorSummary.AccountHolderLabel]</strong> @State.AccountHolder</li>
                <li class="list-group-item"><strong>@I18n[I18nKey.Ui.DueSelectorSummary.IbanLabel]</strong> @State.IBAN</li>
            </ul>
        } else {
            <p class="card-text">@I18n[I18nKey.Ui.DueSelectorSummary.ManualTransferLine]</p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.DueSelectorSummary.PaymentScheduleHeader]</h5>
        <p class="card-text">@ScheduleLine()</p>
    </div>
</div>
