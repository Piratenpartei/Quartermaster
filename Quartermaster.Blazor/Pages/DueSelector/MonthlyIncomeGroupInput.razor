@using System.Globalization
@using Quartermaster.Api.I18n

<div class="mb-0">
    <label for="monthlyIncomeGroup" class="form-label">@I18n[I18nKey.Ui.SelectByMonthlyPay.IncomeGroupLabel]</label>
    <div class="d-flex">
        <input class="form-range" type="range" min="0" step="500" max="6000" id="monthlyIncomeGroup"
               @bind="State.MonthlyIncomeGroup" @bind:event="oninput" @bind:after="State.RecalculateDue" />
        <span style="min-width: 10em; text-align: right">@State.MonthlyIncomeGroup.ToString("C2", German)</span>
    </div>
    <div class="mt-3">
        @I18n[I18nParams.With(I18nKey.Ui.SelectByMonthlyPay.CalculatedDueText, ("amount", State.SelectedDue.ToString("C2", German)))]
    </div>
</div>
