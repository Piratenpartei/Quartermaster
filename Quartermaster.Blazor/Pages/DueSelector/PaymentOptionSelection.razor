@page "/DueSelector/PaymentOptionSelection/{ReturnUrl}"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.PaymentOptionSelection.PageTitle]</h3>
</div>

@if (EntryState == null)
    return;

<div class="mb-3">
    <p>
        @I18n[I18nKey.Ui.PaymentOptionSelection.DirectDepositInstruction]
    </p>

    <Checkbox @bind-Value=EntryState.IsDirectDeposit>@I18n[I18nKey.Ui.PaymentOptionSelection.DirectDepositMandate]</Checkbox>
</div>

<Collapsable Collapsed=!EntryState.IsDirectDeposit>
    <div class="mb-2">
        <label for="accountHolder" class="form-label">@I18n[I18nKey.Ui.PaymentOptionSelection.AccountHolderLabel]</label>
        @{ var fullName = EntryState.FirstName + " " + EntryState.LastName; }
        @if (fullName != EntryState.AccountHolder) {
            <span> - </span>
            <a href="#" class="btn-link" @onclick=UseNameAsAccountHolder @onclick:preventDefault>
                @I18n[$"{I18nKey.Ui.PaymentOptionSelection.UseFullNameLink}?name={fullName}"]
            </a>
        }
        <input type="email" class="form-control" id="accountHolder" @bind=EntryState.AccountHolder @bind:event="oninput" />
    </div>

    <div class="mb-3">
        <label for="iban" class="form-label">@I18n[I18nKey.Ui.PaymentOptionSelection.IbanLabel]</label>
        <input type="email" class="form-control" id="iban" @bind=EntryState.IBAN @bind:event="oninput" />
    </div>

    <hr />
</Collapsable>

<div class="mb-3">
    <h2>@I18n[I18nKey.Ui.PaymentOptionSelection.PaymentScheduleHeader]</h2>
    <RadioGroup E="PaymentSchedule" @bind-Value=EntryState.PaymentSchedule ToStringFunc="TextForPaymentSchedule"
                DisabledValueFunc="DisabledPaymentSchedule" ExcludeValueFunc="ExcludedPaymentSchedule" />
</div>

<div class="d-flex justify-content-between">
    <a href="@ReturnUrl" class="btn btn-primary">@I18n[I18nKey.Ui.Common.Back]</a>
    <a href="/DueSelector/Summary/@System.Net.WebUtility.UrlEncode(ReturnUrl)" class="btn btn-primary">@I18n[I18nKey.Ui.Common.Next]</a>
</div>
