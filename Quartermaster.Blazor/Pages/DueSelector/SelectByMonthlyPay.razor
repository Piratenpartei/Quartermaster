@page "/DueSelector/SelectByMonthlyPay"
@using System.Globalization
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.SelectByMonthlyPay.PageTitle]</h3>
</div>

@if (EntryState == null)
    return;

<div class="mb-3">
    <label for="monthlyIncomeGroup" class="form-label">
        @I18n[I18nKey.Ui.SelectByMonthlyPay.IncomeGroupLabel]
    </label>

    <div class="from-group d-flex">
        <input class="form-range" type="range" min="0" step="500" max="6000" id="monthlyIncomeGroup"
               @bind=EntryState.MonthlyIncomeGroup @bind:event="oninput" />
        <span style="min-width: 10em; text-align: right">
            @EntryState.MonthlyIncomeGroup.ToString("C2", CultureInfo.GetCultureInfo("de-de"))
        </span>
    </div>

    <div class="mt-4">
        <span>
            @I18n[$"{I18nKey.Ui.SelectByMonthlyPay.CalculatedDueText}?amount={CalculateDues().ToString("C2", CultureInfo.GetCultureInfo("de-de"))}"]
        </span>
    </div>
</div>

<div class="d-flex justify-content-between">
    <a href="@GetPreviousUrl()" class="btn btn-primary">@I18n[I18nKey.Ui.Common.Back]</a>
    <a href="/DueSelector/PaymentOptionSelection/@System.Net.WebUtility.UrlEncode("/DueSelector/SelectByMonthlyPay")" class="btn btn-primary">@I18n[I18nKey.Ui.Common.Next]</a>
</div>
