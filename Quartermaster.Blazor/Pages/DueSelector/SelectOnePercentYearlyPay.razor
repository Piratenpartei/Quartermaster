@page "/DueSelector/SelectOnePercentYearlyPay"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.SelectOnePercentYearlyPay.PageTitle]</h3>
</div>

@if (EntryState == null)
    return;

<div class="mb-2">
    @{
        var isValid = EntryState.YearlyIncome >= 7200;
    }

    <label for="yearlyIncome" class="form-label">@I18n[I18nKey.Ui.SelectOnePercentYearlyPay.YearlyIncomeLabel]</label>
    <div class="input-group @(isValid ? "" : "has-validation")">
        <span class="input-group-text">€</span>
        <input type="number" class="form-control @(isValid ? "" : "is-invalid")" id="yearlyIncome"
               min="7200" @bind=EntryState.YearlyIncome @bind:event="oninput" />

        @if (!isValid) {
            <div class="invalid-feedback">
                @I18n[I18nKey.Ui.SelectOnePercentYearlyPay.IncomeTooLowLine1]<br />
                @I18n[I18nKey.Ui.SelectOnePercentYearlyPay.IncomeTooLowLine2]<br />
                @I18n[I18nKey.Ui.SelectOnePercentYearlyPay.IncomeTooLowLine3]
            </div>
        }
    </div>
</div>

<div class="mb-3">
    <label for="calculatedYearlyDue" class="form-label">@I18n[I18nKey.Ui.SelectOnePercentYearlyPay.CalculatedYearlyDueLabel]</label>
    <div class="input-group">
        <span class="input-group-text">€</span>
        <input type="number" class="form-control" id="calculatedYearlyDue" value="@CalculatedPercentOfIncome()" readonly disabled />
    </div>
</div>

<div class="d-flex justify-content-between">
    <a href="/DueSelector/DueTypeSelector" class="btn btn-primary">@I18n[I18nKey.Ui.Common.Back]</a>
    <a href="/DueSelector/PaymentOptionSelection/@System.Net.WebUtility.UrlEncode("/DueSelector/SelectOnePercentYearlyPay")"
       class="btn btn-primary @(isValid ? "" : "disabled")">
       @I18n[I18nKey.Ui.Common.Next]
    </a>
</div>
