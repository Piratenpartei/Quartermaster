@page "/DueSelector/SelectReduced"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.SelectReduced.PageTitle]</h3>
</div>

@if (EntryState == null)
    return;

<div class="mb-3">
    @{
        var isTxtValid = !string.IsNullOrEmpty(EntryState.ReducedJustification)
            || !NextStepButtonHovered;
    }

    <label for="reducedJustification" class="form-label">@I18n[I18nKey.Ui.SelectReduced.JustificationLabel] <RequiredStar /></label>
    <textarea class="form-control @(isTxtValid ? "" : "is-invalid")" id="reducedJustification" @bind=EntryState.ReducedJustification
              @bind:event="oninput" maxlength="2048"></textarea>
</div>

<div class="mb-3">
    @{
        var isInvalid = EntryState.ReducedAmount < 1;
    }

    <label for="reducedAmount" class="form-label">@I18n[I18nKey.Ui.SelectReduced.YearlyAmountLabel] <RequiredStar /></label>
    <div class="input-group @(isInvalid ? "has-validation" : "")">
        <span class="input-group-text">€</span>
        <input type="number" class="form-control @(isInvalid ? "is-invalid" : "")" min="1" id="reducedAmount"
               @bind=EntryState.ReducedAmount @bind:event="oninput" />

        @if (isInvalid) {
            <div class="invalid-feedback">
                @I18n[I18nKey.Ui.SelectReduced.AmountTooLowFeedback]
            </div>
        }
    </div>
</div>

<div class="mb-3">
    <RadioGroup E="ReducedTimeSpan" @bind-Value="EntryState.ReducedTimeSpan" ToStringFunc="TextForReducedTimeSpan" />
</div>

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.SelectReduced.ClassificationHeader]</h3>
    <p>
        @I18n[I18nKey.Ui.SelectReduced.ClassificationNotice]
    </p>
</div>

<div class="mb-2">
    <CardLink HRef="/DueSelector/SelectByMonthlyPay" EnabledFunc=@CanContinue @bind-Hovered=NextStepButtonHovered>
        <span>@I18n[I18nKey.Ui.SelectReduced.MonthlyClassificationOption]</span><br />
        @if (string.IsNullOrEmpty(EntryState.ReducedJustification)) {
            <span>@I18n[I18nKey.Ui.SelectReduced.JustificationRequired]</span>
        }
    </CardLink>
</div>

<div class="mb-3">
    <CardLink HRef="@($"/DueSelector/PaymentOptionSelection/{System.Net.WebUtility.UrlEncode("/DueSelector/SelectReduced")}")"
              EnabledFunc=@CanContinue @bind-Hovered=NextStepButtonHovered CardBorderType="warning">
        <span>@I18n[I18nKey.Ui.SelectReduced.SkipOption]</span><br />
        @if (string.IsNullOrEmpty(EntryState.ReducedJustification)) {
            <span>@I18n[I18nKey.Ui.SelectReduced.JustificationRequired]</span>
        }
    </CardLink>
</div>

<div>
    <a href="/DueSelector/DueTypeSelector" class="btn btn-primary">@I18n[I18nKey.Ui.Common.Back]</a>
</div>
