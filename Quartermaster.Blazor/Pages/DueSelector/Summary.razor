@page "/DueSelector/Summary/{ReturnUrl}"
@using System.Globalization
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.DueSelectorSummary.PageTitle]</h3>
</div>

@if (SubmittedDirect) {
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-2"></i>
        @I18n[I18nKey.Ui.DueSelectorSummary.SubmittedDirect]
    </div>
    return;
}

@if (SubmittedEmail != null) {
    <SubmissionConfirmationNotice Email="@SubmittedEmail" />
    return;
}

@if (EntryState == null)
    return;

<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.DueSelectorSummary.YourChosenDueHeader]</h5>
        @if (EntryState.SelectedValuation == SelectedValuation.MonthlyPayGroup) {
            <p class="card-text">
                @((MarkupString)I18n[$"{I18nKey.Ui.DueSelectorSummary.MonthlyPayAmountLine}?amount={EntryState.SelectedDue.ToString("C2", CultureInfo.GetCultureInfo("de-de"))}"])
            </p>
            <p class="card-text">
                @((MarkupString)I18n[$"{I18nKey.Ui.DueSelectorSummary.MonthlyPayBasisLine}?income={EntryState.MonthlyIncomeGroup.ToString("C2", CultureInfo.GetCultureInfo("de-de"))}"])
            </p>
        } else if (EntryState.SelectedValuation == SelectedValuation.OnePercentYearlyPay) {
            <p class="card-text">
                @((MarkupString)I18n[$"{I18nKey.Ui.DueSelectorSummary.OnePercentAmountLine}?amount={EntryState.SelectedDue.ToString("C2", CultureInfo.GetCultureInfo("de-de"))}"])
            </p>
            <p class="card-text">
                @((MarkupString)I18n[$"{I18nKey.Ui.DueSelectorSummary.OnePercentBasisLine}?income={EntryState.YearlyIncome.ToString("C2", CultureInfo.GetCultureInfo("de-de"))}"])
            </p>
        } else if (EntryState.SelectedValuation == SelectedValuation.Reduced) {
            <p class="card-text">
                @((MarkupString)I18n[$"{I18nKey.Ui.DueSelectorSummary.ReducedAmountLine}?amount={EntryState.ReducedAmount.ToString("C2", CultureInfo.GetCultureInfo("de-de"))}"])
            </p>
            <p class="card-text">
                @((MarkupString)I18n[$"{I18nKey.Ui.DueSelectorSummary.ReducedJustificationLine}?justification={EntryState.ReducedJustification}"])
            </p>
            @if (EntryState.ReducedTimeSpan == ReducedTimeSpan.Permanent) {
                <p class="card-text">
                    @I18n[I18nKey.Ui.DueSelectorSummary.ReducedPermanentLine]
                </p>
            } else {
                <p class="card-text">
                    @I18n[I18nKey.Ui.DueSelectorSummary.ReducedOneYearLine]
                </p>
            }
            @if (EntryState.MonthlyIncomeGroup != 0) {
                <p class="card-text">
                    @((MarkupString)I18n[$"{I18nKey.Ui.DueSelectorSummary.ReducedFallbackLine}?income={EntryState.MonthlyIncomeGroup.ToString("C2", CultureInfo.GetCultureInfo("de-de"))}&amount={EntryState.SelectedDue.ToString("C2", CultureInfo.GetCultureInfo("de-de"))}"])
                </p>
            }
        } else if (EntryState.SelectedValuation == SelectedValuation.Underage) {
            <p class="card-text">
                @((MarkupString)I18n[$"{I18nKey.Ui.DueSelectorSummary.UnderageLine}?amount={12.ToString("C2", CultureInfo.GetCultureInfo("de-de"))}"])
            </p>
        }
    </div>
</div>


<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.DueSelectorSummary.PaymentMethodHeader]</h5>
        @if (EntryState.IsDirectDeposit) {
            <p class="card-text">
                @I18n[I18nKey.Ui.DueSelectorSummary.DirectDepositLine]
            </p>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>@I18n[I18nKey.Ui.DueSelectorSummary.AccountHolderLabel]</strong> @EntryState.AccountHolder</li>
                <li class="list-group-item"><strong>@I18n[I18nKey.Ui.DueSelectorSummary.IbanLabel]</strong> @EntryState.IBAN</li>
            </ul>
        } else {
            <p class="card-text">
                @I18n[I18nKey.Ui.DueSelectorSummary.ManualTransferLine]
            </p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.DueSelectorSummary.PaymentScheduleHeader]</h5>
        @if (EntryState.PaymentSchedule == PaymentSchedule.Annual) {
            <p class="card-text">
                @((MarkupString)I18n[I18nKey.Ui.DueSelectorSummary.AnnualLine])
            </p>
        } else if (EntryState.PaymentSchedule == PaymentSchedule.Quarterly) {
            <p class="card-text">
                @if (!EntryState.SelectedValuation.Equals(SelectedValuation.Reduced)) {
                    @((MarkupString)I18n[$"{I18nKey.Ui.DueSelectorSummary.QuarterlyLineWithAmount}?amount={(EntryState.SelectedDue / 4).ToString("C2", CultureInfo.GetCultureInfo("de-de"))}"])
                } else {
                    @((MarkupString)I18n[I18nKey.Ui.DueSelectorSummary.QuarterlyLineReduced])
                }
            </p>
        } else if (EntryState.PaymentSchedule == PaymentSchedule.Monthly) {
            <p class="card-text">
                @if (EntryState.SelectedValuation != SelectedValuation.Reduced) {
                    @((MarkupString)I18n[$"{I18nKey.Ui.DueSelectorSummary.MonthlyLineWithAmount}?amount={(EntryState.SelectedDue / 12).ToString("C2", CultureInfo.GetCultureInfo("de-de"))}"])
                } else {
                    @((MarkupString)I18n[I18nKey.Ui.DueSelectorSummary.MonthlyLineReduced])
                }
            </p>
        }
    </div>
</div>

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.DueSelectorSummary.AreAllDataCorrectHeader]</h3>
</div>

<div class="mb-2">
    <CardButton OnClick=@Submit>
        <span>@I18n[I18nKey.Ui.DueSelectorSummary.SubmitFormButton]</span>
    </CardButton>
</div>

<div>
    <a href="/DueSelector/PaymentOptionSelection/@System.Net.WebUtility.UrlEncode(ReturnUrl)" class="btn btn-primary">@I18n[I18nKey.Ui.Common.Back]</a>
</div>
