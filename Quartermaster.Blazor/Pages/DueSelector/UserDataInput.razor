@page "/DueSelector/UserDataInput"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.DueSelectorUserData.PageTitle]</h3>
</div>

@if (EntryState == null)
    return;

<div class="mb-3 d-flex flex-row">
    <div class="flex-grow-1 pe-3">
        <label for="firstName" class="form-label">@I18n[I18nKey.Ui.Common.FirstName] <RequiredStar /></label>
        <input type="text" class="form-control" id="firstName" @bind=EntryState.FirstName @bind:event="oninput" disabled="@AuthService.IsAuthenticated" />
    </div>
    <div class="flex-grow-1">
        <label for="lastName" class="form-label">@I18n[I18nKey.Ui.Common.LastName] <RequiredStar /></label>
        <input type="text" class="form-control" id="lastName" @bind=EntryState.LastName @bind:event="oninput" disabled="@AuthService.IsAuthenticated" />
    </div>
</div>
<div class="mb-3">
    <label for="eMail" class="form-label">@I18n[I18nKey.Ui.DueSelectorUserData.EmailLabel] <RequiredStar /></label>
    <input type="email" class="form-control" id="eMail" @bind=EntryState.Email @bind:event="oninput" disabled="@AuthService.IsAuthenticated" />
</div>
@if (AuthService.IsAuthenticated) {
    <p class="text-secondary small mb-3">@I18n[I18nKey.Ui.DueSelectorUserData.PrefillNotice]</p>
}
<div class="mb-3">
    <label for="memberNumber" class="form-label">@I18n[I18nKey.Ui.DueSelectorUserData.MemberNumberLabel] <RequiredStar /></label>
    <input type="number" step="1" class="form-control" id="memberNumber" @bind=EntryState.MemberNumber @bind:event="oninput" />
</div>

<div class="d-flex justify-content-end">
    <a class="btn btn-primary @(CanContinue() ? "" : "disabled")" href="/DueSelector/DueTypeSelector">@I18n[I18nKey.Ui.Common.Next]</a>
</div>
