@page "/Events/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.Events
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.Events

<PageTitle>@I18n[I18nKey.Ui.PublicEventDetail.PageTitle]</PageTitle>

@if (Loading) {
    <PageBackLink Href="/Events" />
    <LoadingSpinner />
} else if (NotFound) {
    <PageBackLink Href="/Events" />
    <div class="alert alert-warning">
        @I18n[I18nKey.Ui.PublicEventDetail.NotPubliclyAvailable]
    </div>
} else if (Event != null) {
    <PageHeader Title="@Event.PublicName" BackHref="/Events">
        <Subtitle>
            <span>@Event.ChapterName</span>
            @if (Event.EventDate.HasValue) {
                <span>· <EventDateText Date="Event.EventDate" StartTime="Event.StartTime" /></span>
            }
        </Subtitle>
        <Actions>
            @if (!string.IsNullOrWhiteSpace(Event.MeetingUrl)) {
                <a href="@Event.MeetingUrl" target="_blank" rel="noopener" class="btn btn-primary">
                    <i class="bi bi-camera-video"></i> @I18n[I18nKey.Ui.Events.JoinOnline]
                </a>
            }
            <EventSubscriptionToggle EventId="Id" />
        </Actions>
        <Links>
            @if (HasMotionPortal) {
                <a href="/Events/@Id/Motions" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-file-earmark-text"></i> @I18n[I18nKey.Ui.AssemblyMotion.PortalButton]
                </a>
            }
            @if (Event.CanManage) {
                <a href="/Administration/Events/@Id" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil-square"></i> @I18n[I18nKey.Ui.LinkedPages.ManageEvent]
                </a>
            }
        </Links>
    </PageHeader>

    @if (!string.IsNullOrEmpty(DescriptionHtml)) {
        <div class="card mb-4">
            <div class="card-body">
                @((MarkupString)DescriptionHtml)
            </div>
        </div>
    }
}
