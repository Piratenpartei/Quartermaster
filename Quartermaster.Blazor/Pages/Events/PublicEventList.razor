@page "/Events"
@using Quartermaster.Api
@using Quartermaster.Api.Events
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.Events

<PageTitle>@I18n[I18nKey.Ui.PublicEventList.PageTitle]</PageTitle>

<h1 class="mb-4">@I18n[I18nKey.Ui.PublicEventList.PageTitle]</h1>

@if (Loading) {
    <LoadingSpinner />
} else if (Response == null || Response.Items.Count == 0) {
    <p class="text-secondary">@I18n[I18nKey.Ui.PublicEventList.EmptyMessage]</p>
} else {
    <div class="list-group">
        @foreach (var ev in Response.Items) {
            <div class="list-group-item list-group-item-action position-relative">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <h5 class="mb-1"><a href="/Events/@ev.Id" class="stretched-link text-reset text-decoration-none">@ev.PublicName</a></h5>
                        <small class="text-secondary">@ev.ChapterName</small>
                    </div>
                    <div class="d-flex flex-column align-items-end gap-2">
                        @if (ev.EventDate.HasValue) {
                            <span class="text-secondary">
                                <i class="bi bi-calendar-event"></i>
                                <EventDateText Date="ev.EventDate" StartTime="ev.StartTime" />
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(ev.MeetingUrl)) {
                            <a href="@ev.MeetingUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary position-relative z-2">
                                <i class="bi bi-camera-video"></i> @I18n[I18nKey.Ui.Events.JoinOnline]
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
