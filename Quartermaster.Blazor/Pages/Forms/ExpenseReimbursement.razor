@page "/Formulare/auslagenerstattung"
@page "/Formulare/auslagenerstattung/{Id:guid}"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Forms.ExpenseReimbursements
@using Quartermaster.Blazor.Components.Forms
@using Quartermaster.Blazor.Components.Inputs

<PageTitle>@I18n[I18nKey.Ui.ExpenseReimbursement.PageTitle]</PageTitle>

<AnonymousFormGate @ref="Gate" />

@if (GateBlocked) {
    <div class="alert alert-info">@I18n[I18nKey.Ui.AnonymousFormGate.IntroParagraph]</div>
} else if (Loading) {
    <LoadingSpinner />
} else {
    <h3 class="mb-3">@I18n[I18nKey.Ui.ExpenseReimbursement.PageTitle]</h3>

    @if (IsSubmitted) {
        <div class="alert alert-success d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>
                <i class="bi bi-check2-circle me-2"></i>
                @I18n[$"{I18nKey.Ui.ExpenseReimbursement.SubmittedNotice}?submittedAt={FormatTimestamp(SubmittedAt)}"]
            </span>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary btn-sm" @onclick="DownloadAgain" disabled="@Busy">
                    <i class="bi bi-download me-1"></i> @I18n[I18nKey.Ui.ExpenseReimbursement.DownloadAgainButton]
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CopyToDraft" disabled="@Busy">
                    <i class="bi bi-files me-1"></i> @I18n[I18nKey.Ui.ExpenseReimbursement.CopyToDraftButton]
                </button>
            </div>
        </div>
        <ExpenseReimbursementReadOnlyView Input="Input" />
    } else {
        <FormWizard Steps="Steps"
                    ShowSaveDraftButton="@HasPersistentBacking"
                    CanSubmit="@(LineItemTotal > 0m && PayoutValid)"
                    SubmitLabel="@I18n[I18nKey.Ui.ExpenseReimbursement.GeneratePdfButton]"
                    OnAdvance="OnAdvance"
                    OnSaveDraft="SaveDraft"
                    OnSubmit="Submit" />
        @if (HasPersistentBacking) {
            <div class="text-end">
                <button class="btn btn-outline-danger btn-sm" @onclick="DeleteDraft" disabled="@Busy">
                    <i class="bi bi-trash me-1"></i> @I18n[I18nKey.Ui.ExpenseReimbursement.DeleteDraftButton]
                </button>
            </div>
        }
    }
}

@code {
    private RenderFragment Step1Personal => @<text>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.FirstNameLabel]</label>
                <input class="form-control" @bind="Input.FirstName" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.LastNameLabel]</label>
                <input class="form-control" @bind="Input.LastName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.MemberNumberLabel]</label>
                <input class="form-control" type="number" @bind="Input.MemberNumber" />
            </div>
            <div class="col-md-8">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.StreetLabel]</label>
                <input class="form-control" @bind="Input.Street" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.PostCodeLabel]</label>
                <input class="form-control" @bind="Input.PostCode" />
            </div>
            <div class="col-md-9">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.CityLabel]</label>
                <input class="form-control" @bind="Input.City" />
            </div>
        </div>
    </text>;

    private RenderFragment Step2Chapter => @<text>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.ChapterLabel]</label>
                <ChapterPicker Value="@ChapterIdString" ValueChanged="OnChapterPicked" AllowEmpty="true" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.FunctionLabel]</label>
                <input class="form-control" list="functionSuggestions"
                       placeholder="@I18n[I18nKey.Ui.ExpenseReimbursement.FunctionPlaceholder]"
                       @bind="Input.Function" />
                <datalist id="functionSuggestions">
                    @foreach (var suggestion in FunctionSuggestions) {
                        <option value="@suggestion" />
                    }
                </datalist>
            </div>
            <div class="col-md-4">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.MotionDateLabel]</label>
                <input type="date" class="form-control" value="@FormatIso(Input.MotionDate)"
                       @oninput="e => Input.MotionDate = ParseIso(e.Value?.ToString())" />
            </div>
        </div>
    </text>;

    private RenderFragment Step3LineItems => @<text>
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>@I18n[I18nKey.Ui.ExpenseReimbursement.LineItemDescription]</th>
                    <th style="width: 160px;" class="text-end">@I18n[I18nKey.Ui.ExpenseReimbursement.LineItemValue]</th>
                    <th style="width: 40px;"></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Input.LineItems.Count; i++) {
                    var index = i;
                    <tr>
                        <td><input class="form-control" @bind="Input.LineItems[index].Description" /></td>
                        <td><input type="number" step="0.01" class="form-control text-end" @bind="Input.LineItems[index].Value" /></td>
                        <td>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveLineItem(index)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td class="text-end fw-semibold">@I18n[I18nKey.Ui.ExpenseReimbursement.LineItemSum]</td>
                    <td class="text-end fw-semibold">@LineItemTotal.ToString("N2", De) €</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
        <button class="btn btn-outline-secondary btn-sm" @onclick="AddLineItem">
            <i class="bi bi-plus-lg me-1"></i> @I18n[I18nKey.Ui.ExpenseReimbursement.LineItemAdd]
        </button>
    </text>;

    private RenderFragment Step4Payout => @<text>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.DonatedAmountLabel]</label>
                <input type="number" step="0.01" class="form-control"
                       value="@Input.DonatedAmount" @oninput="OnDonatedChanged" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.PayoutAmountLabel]</label>
                <input type="number" step="0.01" class="form-control"
                       value="@Input.PayoutAmount" @oninput="OnPayoutChanged" />
            </div>
            <div class="col-12">
                <small class="@SplitClass">
                    @if (SplitSum == LineItemTotal) {
                        @I18n[I18nKey.Ui.ExpenseReimbursement.SplitOk]
                    } else {
                        @I18n[I18nKey.Ui.ExpenseReimbursement.SplitMismatch]
                    }
                    (@SplitSum.ToString("N2", De) € / @LineItemTotal.ToString("N2", De) €)
                </small>
            </div>
        </div>

        @if (Input.DonatedAmount > 0m) {
            <div class="form-check mt-3">
                <input class="form-check-input" type="checkbox" id="reqReceipt" @bind="Input.RequestsDonationReceipt" />
                <label class="form-check-label" for="reqReceipt">
                    @I18n[I18nKey.Ui.ExpenseReimbursement.RequestDonationReceipt]
                </label>
            </div>
        }

        @if (Input.PayoutAmount > 0m) {
            <div class="mt-3">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.PayoutMethodSection]</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="payoutMethod" id="payoutCash"
                           checked="@(Input.PayoutMethod == ExpensePayoutMethodDTO.Cash)"
                           @onchange="() => Input.PayoutMethod = ExpensePayoutMethodDTO.Cash" />
                    <label class="form-check-label" for="payoutCash">@I18n[I18nKey.Ui.ExpenseReimbursement.PayoutCash]</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="payoutMethod" id="payoutTransfer"
                           checked="@(Input.PayoutMethod == ExpensePayoutMethodDTO.BankTransfer)"
                           @onchange="() => Input.PayoutMethod = ExpensePayoutMethodDTO.BankTransfer" />
                    <label class="form-check-label" for="payoutTransfer">@I18n[I18nKey.Ui.ExpenseReimbursement.PayoutBankTransfer]</label>
                </div>
                @if (Input.PayoutMethod == ExpensePayoutMethodDTO.BankTransfer) {
                    <div class="mt-2" style="max-width: 480px;">
                        <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.IbanLabel]</label>
                        <input class="form-control" @bind="Input.Iban" placeholder="DE..." />
                        <div class="form-text">
                            <em>@I18n[I18nKey.Ui.ExpenseReimbursement.BicHint]</em>
                        </div>
                    </div>
                }
            </div>
        }
    </text>;

    private RenderFragment Step5Overview => @<text>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.SignatureLocationLabel]</label>
                <input class="form-control" @bind="Input.SignatureLocation" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@I18n[I18nKey.Ui.ExpenseReimbursement.FormDateLabel]</label>
                <input type="date" class="form-control" value="@FormatIso(Input.FormDate)"
                       @oninput="e => Input.FormDate = ParseIso(e.Value?.ToString())" />
            </div>
        </div>
        <hr class="my-3" />
        <p class="text-secondary">@I18n[I18nKey.Ui.ExpenseReimbursement.OverviewIntro]</p>
        <ExpenseReimbursementReadOnlyView Input="Input" />
    </text>;
}
