@page "/Formulare"
@using Quartermaster.Api
@using Quartermaster.Api.Forms
@using Quartermaster.Api.I18n

<PageTitle>@I18n[I18nKey.Ui.FormCatalog.PageTitle]</PageTitle>

<h3 class="mb-2">@I18n[I18nKey.Ui.FormCatalog.PageTitle]</h3>
<p class="text-secondary">@I18n[I18nKey.Ui.FormCatalog.PageIntro]</p>

<RequirePermission RequireAuth="true">
    <div class="mb-3">
        <a class="btn btn-outline-secondary btn-sm" href="/Formulare/meine">
            <i class="bi bi-folder2-open me-1"></i> @I18n[I18nKey.Ui.FormCatalog.MyFormsLink]
        </a>
    </div>
</RequirePermission>

<div class="row g-3">
    @foreach (var entry in FormCatalog.Entries) {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <i class="bi @entry.Icon fs-2 text-primary"></i>
                        <h5 class="card-title mb-0">@I18n[entry.DisplayNameI18nKey]</h5>
                    </div>
                    <p class="card-text flex-grow-1 text-secondary">@I18n[entry.DescriptionI18nKey]</p>
                    <a class="btn btn-primary mt-auto align-self-start" href="@entry.Route">
                        <i class="bi bi-arrow-right-circle me-1"></i> @I18n[I18nKey.Ui.FormCatalog.StartButton]
                    </a>
                </div>
            </div>
        </div>
    }
</div>
