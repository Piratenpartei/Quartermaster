@page "/Forms/Receipts"
@using Quartermaster.Api.I18n

<PageTitle>@I18n[I18nKey.Ui.Receipts.PageTitle]</PageTitle>

<h3 class="mb-2">@I18n[I18nKey.Ui.Receipts.PageTitle]</h3>
<p class="text-secondary">@I18n[I18nKey.Ui.Receipts.PageIntro]</p>

<ConfirmDialog @ref="DeleteConfirm" />

@if (List == null) {
    <LoadingSpinner />
} else {
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <label class="btn btn-primary mb-0 @(LimitReached() ? "disabled" : "")">
            <i class="bi bi-upload me-1"></i>@I18n[I18nKey.Ui.Receipts.UploadNew]
            <InputFile class="d-none" multiple accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" OnChange="Upload" disabled="@LimitReached()" />
        </label>
        @if (Uploading) {
            <span class="spinner-border spinner-border-sm text-secondary"></span>
        }
        <span class="small text-secondary">@UsageText()</span>
    </div>

    @if (List.Items.Count == 0) {
        <p class="text-secondary">@I18n[I18nKey.Ui.Receipts.Empty]</p>
    } else {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>@I18n[I18nKey.Ui.Receipts.LabelColumn]</th>
                        <th>@I18n[I18nKey.Ui.Receipts.FileColumn]</th>
                        <th>@I18n[I18nKey.Ui.Receipts.UploadedColumn]</th>
                        <th class="text-end">@I18n[I18nKey.Ui.MyForms.ActionsColumn]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var receipt in List.Items) {
                        <tr>
                            <td>
                                @if (EditingId == receipt.Id) {
                                    <div class="input-group input-group-sm">
                                        <input class="form-control" maxlength="200" @bind="EditingLabel" />
                                        <button class="btn btn-outline-primary" @onclick="SaveLabel" title="@I18n[I18nKey.Ui.Common.Save]"><i class="bi bi-check-lg"></i></button>
                                        <button class="btn btn-outline-secondary" @onclick="CancelEdit" title="@I18n[I18nKey.Ui.Common.Cancel]"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                } else {
                                    @receipt.Label
                                }
                            </td>
                            <td class="small text-secondary">
                                <i class="bi @(receipt.ContentType == "application/pdf" ? "bi-file-earmark-pdf" : "bi-file-earmark-image") me-1"></i>@receipt.FileName (@SizeText(receipt.SizeBytes))
                            </td>
                            <td class="small">@receipt.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button class="btn btn-outline-secondary" @onclick="() => Receipts.DownloadAsync(receipt)" title="@I18n[I18nKey.Ui.MyForms.DownloadAction]"><i class="bi bi-download"></i></button>
                                    <button class="btn btn-outline-primary" @onclick="() => StartEdit(receipt)" title="@I18n[I18nKey.Ui.Common.Edit]"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-outline-danger" @onclick="() => Delete(receipt)" title="@I18n[I18nKey.Ui.Common.Delete]"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
