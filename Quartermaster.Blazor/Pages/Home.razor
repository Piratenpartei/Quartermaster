@page "/"
@using Quartermaster.Api
@using Quartermaster.Api.Dashboard
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.Events
@using Quartermaster.Blazor.Components.SupportSignatures
@using System.Globalization

<PageTitle>@I18n[I18nKey.Ui.Home.PageTitle]</PageTitle>

<h1 class="mb-2">@I18n[I18nKey.Ui.Home.Heading]</h1>
<p class="lead text-secondary mb-4">@I18n[I18nKey.Ui.Home.Intro]</p>

@if (Loading) {
    <LoadingSpinner />
} else if (Dashboard != null) {
    @if (Dashboard.UpcomingEvents != null && Dashboard.UpcomingEvents.Count > 0) {
        <h2 class="h4 mt-4 mb-3">@I18n[I18nKey.Ui.Home.SectionEvents]</h2>
        <DashboardCard Icon="bi-calendar-event"
                       Title="@I18n[I18nKey.Ui.Home.UpcomingEventsTitle]"
                       AllUrl="/Events">
            <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>@I18n[I18nKey.Ui.Common.Name]</th>
                        <th>@I18n[I18nKey.Ui.Common.Chapter]</th>
                        <th>@I18n[I18nKey.Ui.Common.Date]</th>
                        <th><span class="visually-hidden">@I18n[I18nKey.Ui.Common.Action]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Dashboard.UpcomingEvents) {
                        <tr>
                            <td><a href="/Events/@ev.Id">@ev.PublicName</a></td>
                            <td>@ev.ChapterName</td>
                            <td>
                                @if (ev.EventDate.HasValue) {
                                    <EventDateText Date="ev.EventDate" StartTime="ev.StartTime" />
                                } else {
                                    @I18n[I18nKey.Ui.Home.UpcomingEventDateOpen]
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (!string.IsNullOrWhiteSpace(ev.MeetingUrl)) {
                                    <a href="@ev.MeetingUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-camera-video"></i> @I18n[I18nKey.Ui.Events.JoinOnline]
                                    </a>
                                }
                                @if (ev.HasMotionPortal) {
                                    <a href="/Events/@ev.Id/Motions" class="btn btn-sm btn-primary">
                                        <i class="bi bi-file-earmark-text"></i> @I18n[I18nKey.Ui.AssemblyMotion.PortalButton]
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </DashboardCard>
    }

    @if (HasOpenItems()) {
        <h2 class="h4 mt-4 mb-3">@I18n[I18nKey.Ui.Home.SectionOpenItems]</h2>
    }
    @if (Dashboard.OpenMotions?.Items.Count > 0) {
        <DashboardCard Icon="bi-file-text"
                       Title="@I18n[I18nKey.Ui.Home.OpenMotionsTitle]"
                       TotalCount="@Dashboard.OpenMotions.TotalCount"
                       AllUrl="/Administration/Motions">
            <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>@I18n[I18nKey.Ui.Common.Title]</th>
                        <th>@I18n[I18nKey.Ui.Common.Chapter]</th>
                        <th>@I18n[I18nKey.Ui.Common.Created]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Dashboard.OpenMotions.Items) {
                        <tr>
                            <td><a href="/Administration/Motions/@m.Id">@m.Title</a></td>
                            <td>@m.ChapterName</td>
                            <td><LocalTime Value="m.CreatedAt" Format="dd.MM.yyyy" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </DashboardCard>
    }

    @if (Dashboard.PendingApplications?.Items.Count > 0) {
        <DashboardCard Icon="bi-person-plus"
                       Title="@I18n[I18nKey.Ui.Home.PendingApplicationsTitle]"
                       TotalCount="@Dashboard.PendingApplications.TotalCount"
                       AllUrl="/Administration/MembershipApplications">
            <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>@I18n[I18nKey.Ui.Common.Name]</th>
                        <th>@I18n[I18nKey.Ui.Common.Chapter]</th>
                        <th>@I18n[I18nKey.Ui.Home.SubmittedColumn]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Dashboard.PendingApplications.Items) {
                        <tr>
                            <td><a href="/Administration/MembershipApplications/@app.Id">@app.FirstName @app.LastName</a></td>
                            <td>@app.ChapterName</td>
                            <td><LocalTime Value="app.SubmittedAt" Format="dd.MM.yyyy" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </DashboardCard>
    }

    @if (Dashboard.PendingDueSelections?.Items.Count > 0) {
        <DashboardCard Icon="bi-currency-euro"
                       Title="@I18n[I18nKey.Ui.Home.PendingDueSelectionsTitle]"
                       TotalCount="@Dashboard.PendingDueSelections.TotalCount"
                       AllUrl="/Administration/DueSelections">
            <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>@I18n[I18nKey.Ui.Common.Name]</th>
                        <th class="text-end">@I18n[I18nKey.Ui.Home.SelectedFeeColumn]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ds in Dashboard.PendingDueSelections.Items) {
                        <tr>
                            <td><a href="/Administration/DueSelections/@ds.Id">@ds.FirstName @ds.LastName</a></td>
                            <td class="text-end">@ds.SelectedDue.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </DashboardCard>
    }

    @if (Dashboard.SupportSignatureCampaigns?.Count > 0) {
        <h2 class="h4 mt-4 mb-3">@I18n[I18nKey.Ui.Home.SectionSupportSignatures]</h2>
        @if (!AuthService.IsAuthenticated) {
            <SupportSignatureHelp />
        }
    }
    @foreach (var campaign in Dashboard.SupportSignatureCampaigns ?? []) {
        <SupportSignatureProgressCard Campaign="@campaign" />
    }
}

<h2 class="h4 mt-4 mb-3">@I18n[I18nKey.Ui.Home.SectionFeatures]</h2>
<FeatureOverview />

@if (!Loading && !AuthService.IsAuthenticated) {
    <h2 class="h4 mt-4 mb-3">@I18n[I18nKey.Ui.Home.SectionSignIn]</h2>
    <SignInPrompt />
}
