@page "/MembershipApplication/Summary"
@using System.Globalization
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Pages.DueSelector

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.ApplicationSummary.PageTitle]</h3>
</div>

@if (SubmittedDirect) {
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-2"></i>
        @I18n[I18nKey.Ui.ApplicationSummary.DirectSubmittedNotice]
    </div>
    return;
}

@if (SubmittedEmail != null) {
    <SubmissionConfirmationNotice Email="@SubmittedEmail" />
    return;
}

@if (EntryState == null)
    return;

<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.ApplicationSummary.PersonalDataSection]</h5>
        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>@I18n[I18nKey.Ui.ApplicationSummary.NameLabel]:</strong> @EntryState.FirstName @EntryState.LastName</li>
            <li class="list-group-item"><strong>@I18n[I18nKey.Ui.ApplicationSummary.DateOfBirthLabel]:</strong> <LocalTime DateValue="EntryState.DateOfBirth.HasValue ? DateOnly.FromDateTime(EntryState.DateOfBirth.Value) : null" /></li>
            <li class="list-group-item"><strong>@I18n[I18nKey.Ui.ApplicationSummary.CitizenshipLabel]:</strong> @EntryState.Citizenship</li>
            <li class="list-group-item"><strong>@I18n[I18nKey.Ui.ApplicationSummary.EmailLabel]:</strong> @EntryState.Email</li>
            <li class="list-group-item"><strong>@I18n[I18nKey.Ui.ApplicationSummary.PhoneLabel]:</strong> @EntryState.PhoneNumber</li>
        </ul>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.ApplicationSummary.AddressSection]</h5>
        <p class="card-text">
            @EntryState.AddressStreet @EntryState.AddressHouseNbr<br />
            @EntryState.AddressPostCode @EntryState.AddressCity
        </p>
        @if (EntryState.ChapterName != null) {
            <p class="card-text"><strong>@I18n[I18nKey.Ui.ApplicationSummary.ChapterLabel]:</strong> @EntryState.ChapterName</p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.ApplicationSummary.DuesSection]</h5>
        @if (DuesState != null && DuesState.SelectedDue > 0) {
            <p class="card-text">
                @I18n[I18nKey.Ui.ApplicationSummary.YearlyDue]: <strong>@DuesState.SelectedDue.ToString("C2", CultureInfo.GetCultureInfo("de-de"))</strong>
            </p>
        } else {
            <p class="card-text text-warning">@I18n[I18nKey.Ui.ApplicationSummary.DueNotSet]</p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5>@I18n[I18nKey.Ui.ApplicationSummary.DeclarationsSection]</h5>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">
                @I18n[$"{I18nKey.Ui.ApplicationSummary.ConformityLine}?status={(EntryState.ConformityDeclarationAccepted ? I18n[I18nKey.Ui.ApplicationSummary.ConformityAccepted] : I18n[I18nKey.Ui.ApplicationSummary.ConformityNotAccepted])}"]
            </li>
            @if (EntryState.HasPriorDeclinedApplication) {
                <li class="list-group-item text-warning">@I18n[I18nKey.Ui.ApplicationSummary.PriorDeclined]</li>
            }
            @if (EntryState.IsMemberOfAnotherParty) {
                <li class="list-group-item">@I18n[I18nKey.Ui.ApplicationSummary.MemberOfAnotherParty]</li>
            }
        </ul>
        @if (!string.IsNullOrEmpty(EntryState.ApplicationText)) {
            <p class="card-text mt-2"><em>@EntryState.ApplicationText</em></p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <p class="card-text small text-secondary">
            @I18n[I18nKey.Ui.ApplicationSummary.PrivacyNotice]
        </p>
    </div>
</div>

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.ApplicationSummary.ConfirmCorrectHeading]</h3>
</div>

<div class="mb-2">
    <CardButton OnClick=@Submit>
        <span>@I18n[I18nKey.Ui.ApplicationSummary.SubmitButton]</span>
    </CardButton>
</div>

<div>
    <a href="/MembershipApplication/Declarations" class="btn btn-primary">@I18n[I18nKey.Ui.Common.Back]</a>
</div>
