@page "/MembershipApplication/CountrySelection"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.CountrySelection.PageTitle]</h3>
</div>

@if (EntryState == null)
    return;

<div class="mb-2">
    <CardLink HRef="/MembershipApplication/Address" OnNavigate=@(() => SelectCountry(true))>
        <span>@I18n[I18nKey.Ui.CountrySelection.LivesInGermany]</span>
    </CardLink>
</div>

<div class="mb-3">
    <CardLink HRef="/MembershipApplication/AddressDetails" OnNavigate=@(() => SelectCountry(false))>
        <span>@I18n[I18nKey.Ui.CountrySelection.LivesElsewhere]</span>
    </CardLink>
</div>

<div>
    <a href="/MembershipApplication/PersonalData" class="btn btn-primary">@I18n[I18nKey.Ui.Common.Back]</a>
</div>
