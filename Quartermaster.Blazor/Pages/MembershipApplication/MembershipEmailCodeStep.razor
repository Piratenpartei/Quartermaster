@using Quartermaster.Api.I18n

@if (WasSentToCurrentAddress) {
    <p>@((MarkupString)SentToMarkup)</p>
}

@if (NotRequired) {
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>@I18n[I18nKey.Ui.EmailCodeStep.NotRequired]
    </div>
}

@if (EditingAddress) {
    <div class="mb-3">
        <label for="codeStepEmail" class="form-label">@I18n[I18nKey.Ui.PersonalData.EmailLabel]</label>
        <input type="email" class="form-control" id="codeStepEmail" autocomplete="email" @bind="AddressInput" @bind:event="oninput" />
    </div>
    <div class="d-flex gap-2 mb-3">
        <button type="button" class="btn btn-primary" @onclick="SaveAddress" disabled="@(Sending || string.IsNullOrWhiteSpace(AddressInput))">
            @I18n[I18nKey.Ui.EmailCodeStep.SaveAddress]
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEditing" disabled="@Sending">
            @I18n[I18nKey.Ui.FormWizard.BackButton]
        </button>
    </div>
} else {
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary" @onclick="StartEditing" disabled="@Sending">
            <i class="bi bi-pencil me-1"></i>@I18n[I18nKey.Ui.EmailCodeStep.ChangeAddress]
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="Resend" disabled="@(Sending || SecondsLeft > 0)">
            <i class="bi bi-send me-1"></i>@ResendLabel
        </button>
    </div>
}

@if (!NotRequired) {
    <div class="mb-0">
        <label for="emailCode" class="form-label">@I18n[I18nKey.Ui.EmailCodeStep.CodeLabel] <RequiredStar /></label>
        <input type="text" class="form-control" id="emailCode" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code"
               value="@(RawCodeInput ?? State.EmailCode)" @oninput="OnCodeInput" />
    </div>
}
