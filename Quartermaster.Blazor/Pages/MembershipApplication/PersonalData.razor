@page "/MembershipApplication/PersonalData"
@using Quartermaster.Api
@using Quartermaster.Api.I18n

<div class="mb-3">
    <h3>@I18n[I18nKey.Ui.PersonalData.PageTitle]</h3>
</div>

@if (AuthService.IsAuthenticated) {
    <div class="alert alert-warning">
        <i class="bi bi-info-circle me-2"></i>
        @I18n[I18nKey.Ui.PersonalData.ProxyApplicationNotice]
    </div>
}

@if (EntryState == null)
    return;

<div class="mb-3 d-flex flex-row">
    <div class="flex-grow-1 pe-3">
        <label for="firstName" class="form-label">@I18n[I18nKey.Ui.PersonalData.FirstNameLabel] <RequiredStar /></label>
        <input type="text" class="form-control" id="firstName" @bind=EntryState.FirstName @bind:event="oninput" />
    </div>
    <div class="flex-grow-1">
        <label for="lastName" class="form-label">@I18n[I18nKey.Ui.PersonalData.LastNameLabel] <RequiredStar /></label>
        <input type="text" class="form-control" id="lastName" @bind=EntryState.LastName @bind:event="oninput" />
    </div>
</div>

<div class="mb-3">
    <label for="dateOfBirth" class="form-label">@I18n[I18nKey.Ui.PersonalData.DateOfBirthLabel] <RequiredStar /></label>
    <p class="text-secondary small">@I18n[I18nKey.Ui.PersonalData.MinimumAgeHint]</p>
    <input type="date" class="form-control" id="dateOfBirth" @bind=EntryState.DateOfBirth />
</div>

<div class="mb-3">
    <label for="citizenship" class="form-label">@I18n[I18nKey.Ui.PersonalData.CitizenshipLabel] <RequiredStar /></label>
    <input type="text" class="form-control" id="citizenship" @bind=EntryState.Citizenship @bind:event="oninput" />
</div>

<div class="mb-3">
    <label for="eMail" class="form-label">@I18n[I18nKey.Ui.PersonalData.EmailLabel] <RequiredStar /></label>
    <input type="email" class="form-control" id="eMail" @bind=EntryState.Email @bind:event="oninput" />
</div>

<div class="mb-3">
    <label for="phoneNumber" class="form-label">@I18n[I18nKey.Ui.PersonalData.PhoneLabel]</label>
    <input type="tel" class="form-control" id="phoneNumber" @bind=EntryState.PhoneNumber @bind:event="oninput" />
</div>

<div class="d-flex justify-content-end">
    <a class="btn btn-primary @(CanContinue() ? "" : "disabled")"
       href="/MembershipApplication/CountrySelection">@I18n[I18nKey.Ui.Common.Next]</a>
</div>
