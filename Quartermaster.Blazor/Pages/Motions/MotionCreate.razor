@page "/Motions/Create"
@using Quartermaster.Api.Motions

<div class="mb-3">
    <h3>Antrag einreichen</h3>
</div>

@if (SubmittedDirect) {
    <div class="alert alert-success">
        <i class="bi bi-check-circle me-2"></i>
        Dein Antrag wurde eingereicht und an die Officer weitergeleitet.
    </div>
    return;
}

@if (SubmittedEmail != null) {
    <SubmissionConfirmationNotice Email="@SubmittedEmail" />
    return;
}

<div class="mb-3">
    <label class="form-label">Gliederung <RequiredStar /></label>
    <ChapterPicker @bind-Value="SelectedChapterId" />
</div>

<div class="mb-3">
    <label for="authorName" class="form-label">Dein Name <RequiredStar /></label>
    <input type="text" class="form-control" id="authorName" @bind="AuthorName" @bind:event="oninput" disabled="@AuthService.IsAuthenticated" />
</div>

<div class="mb-3">
    <label for="authorEmail" class="form-label">Deine E-Mail Adresse <RequiredStar /></label>
    <input type="email" class="form-control" id="authorEmail" @bind="AuthorEmail" @bind:event="oninput" disabled="@AuthService.IsAuthenticated" />
</div>

@if (AuthService.IsAuthenticated) {
    <p class="text-secondary small mb-3">Name und E-Mail sind mit deinem Konto vorausgefüllt.</p>
}

<div class="mb-3">
    <label for="title" class="form-label">Titel des Antrags <RequiredStar /></label>
    <input type="text" class="form-control" id="title" @bind="Title" @bind:event="oninput" />
</div>

<div class="mb-3">
    <label for="text" class="form-label">Antragstext <RequiredStar /></label>
    <textarea class="form-control" rows="6" id="text" @bind="Text" @bind:event="oninput" maxlength="8192"></textarea>
</div>

<div class="d-flex justify-content-end">
    <button class="btn btn-primary btn-hover-scale1" @onclick="Submit" disabled="@(!CanSubmit() || Submitting)">
        @if (Submitting) {
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
        }
        Antrag einreichen
    </button>
</div>
