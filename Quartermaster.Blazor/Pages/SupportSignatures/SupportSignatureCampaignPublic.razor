@page "/SupportSignatures/{Id:guid}"
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.AssemblyMotions
@using Quartermaster.Blazor.Components.SupportSignatures

<PageTitle>@(Campaign?.Name ?? I18n[I18nKey.Ui.SupportSignatures.CardSubtitle])</PageTitle>

@if (Loading) {
    <LoadingSpinner />
} else if (Campaign == null) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.SupportSignatures.CampaignNotFound]</div>
} else {
    <div class="small text-secondary">@I18n[I18nKey.Ui.SupportSignatures.CardSubtitle] · @Campaign.ChapterName</div>
    <h3>@Campaign.Name</h3>
    <SupportSignatureProgress Certified="@Campaign.CertifiedTotal" Collected="@Campaign.CollectedTotal" Target="@Campaign.Target" Goal="@Campaign.Goal" />
    <p class="mt-3">@I18n[I18nKey.Ui.SupportSignatures.Deadline]: <DeadlineText Value="@Campaign.Deadline" /></p>
    @if (NoticeHtml != null) {
        <div class="card mb-3">
            <div class="card-body">@NoticeHtml</div>
        </div>
    }
    @if (Campaign.HasForm) {
        <button class="btn btn-primary" @onclick="DownloadForm"><i class="bi bi-download me-1"></i>@I18n[I18nKey.Ui.SupportSignatures.DownloadForm]</button>
    }
    <p class="small text-secondary mt-3">@I18n[I18nKey.Ui.SupportSignatures.MemberPageHint]</p>
}
