@page "/SupportSignatures/{Id:guid}"
@using Quartermaster.Api.I18n
@using Quartermaster.Blazor.Components.AssemblyMotions
@using Quartermaster.Blazor.Components.SupportSignatures

<PageTitle>@(Campaign?.Name ?? I18n[I18nKey.Ui.SupportSignatures.CardSubtitle])</PageTitle>

@if (Loading) {
    <LoadingSpinner />
} else if (Campaign == null) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.SupportSignatures.CampaignNotFound]</div>
} else {
    <PageHeader Title="@Campaign.Name">
        <Subtitle>@I18n[I18nKey.Ui.SupportSignatures.CardSubtitle] · @Campaign.ChapterName</Subtitle>
        <Actions>
            @if (Campaign.CanManage) {
                <a class="btn btn-outline-secondary" href="/Administration/SupportSignatures/@Campaign.Id"><i class="bi bi-pen me-1"></i>@I18n[I18nKey.Ui.SupportSignatures.OpenInAssistant]</a>
            }
        </Actions>
    </PageHeader>
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <SupportSignatureProgress Certified="@Campaign.CertifiedTotal" Collected="@Campaign.CollectedTotal" Target="@Campaign.Target" Goal="@Campaign.Goal" />
            <p class="small text-secondary mt-2">@I18n[I18nKey.Ui.SupportSignatures.Deadline]: <DeadlineText Value="@Campaign.Deadline" /></p>
            @if (NoticeHtml != null) {
                <div class="card mb-4">
                    <div class="card-body">@NoticeHtml</div>
                </div>
            }
            <SupportSignatureHelp />
            <p class="small text-secondary mt-3">@I18n[I18nKey.Ui.SupportSignatures.MemberPageHint]</p>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card mt-lg-3">
                <div class="card-body">
                    @if (Campaign.HasForm) {
                        <button class="btn btn-primary w-100 mb-3" @onclick="DownloadForm"><i class="bi bi-download me-1"></i>@I18n[I18nKey.Ui.SupportSignatures.DownloadForm]</button>
                    }
                    <SupportSignatureContact PostalAddress="@Campaign.PostalAddress" ContactEmail="@Campaign.ContactEmail" />
                </div>
            </div>
        </div>
    </div>
}
