@page "/Account/Benachrichtigungen"
@using Quartermaster.Api.Notifications

<PageTitle>Benachrichtigungen</PageTitle>

<h3 class="mb-3">Benachrichtigungen</h3>

<p class="text-secondary">Lege fest, über welchen Kanal du bei welchen Ereignissen benachrichtigt werden möchtest. Standardmäßig sind E-Mail-Benachrichtigungen aktiviert.</p>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3">
            <i class="bi bi-telegram me-1"></i>
            Telegram
        </h5>
        @if (TelegramStatus == null) {
            <LoadingSpinner />
        } else if (TelegramStatus.Linked) {
            <p class="mb-2">Verknüpft mit Chat-ID <code>@TelegramStatus.ChatId</code>.</p>
            <button class="btn btn-outline-danger btn-sm" @onclick="Unlink" disabled="@TelegramBusy">
                <i class="bi bi-link-45deg me-1"></i>
                Verknüpfung aufheben
            </button>
        } else if (TelegramLinkStart != null) {
            <ol class="mb-2 ps-3">
                <li>
                    @if (!string.IsNullOrEmpty(TelegramLinkStart.Deeplink)) {
                        <span>
                            Öffne den Bot in Telegram:
                            <a href="@TelegramLinkStart.Deeplink" target="_blank" rel="noopener">@@@TelegramLinkStart.BotUsername</a>
                        </span>
                    } else {
                        <span>Öffne den Quartermaster-Bot in Telegram.</span>
                    }
                </li>
                <li>Drücke im Bot-Chat den <strong>Start</strong>-Knopf.</li>
                <li>
                    Sende anschließend folgenden Befehl:
                    <div class="input-group input-group-sm mt-1" style="max-width: 420px;">
                        <input type="text" class="form-control font-monospace" readonly value="@LinkCommand" />
                        <button class="btn btn-outline-secondary btn-hover-scale1" type="button" @onclick="CopyLinkCommand" title="In die Zwischenablage kopieren">
                            @if (LinkCommandCopied) {
                                <i class="bi bi-check2"></i>
                            } else {
                                <i class="bi bi-clipboard"></i>
                            }
                        </button>
                    </div>
                </li>
            </ol>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary btn-sm btn-hover-scale1" @onclick="CheckLinkStatus" title="Verknüpfung prüfen">
                    <i class="bi bi-arrow-clockwise me-1"></i>
                    Verknüpfung prüfen
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelLinkStart">Abbrechen</button>
            </div>
            <div class="text-secondary small mt-2">Gültig bis @TelegramLinkStart.ExpiresAt.ToLocalTime().ToString("HH:mm") — automatische Prüfung alle 5 Sekunden</div>
        } else {
            <p class="text-secondary mb-2">Verknüpfe deinen Telegram-Account, um Benachrichtigungen dort zu erhalten.</p>
            <button class="btn btn-primary btn-sm" @onclick="StartLink" disabled="@TelegramBusy">
                <i class="bi bi-telegram me-1"></i>
                Telegram verknüpfen
            </button>
        }
    </div>
</div>

@if (Loading) {
    <LoadingSpinner />
} else if (Data == null) {
    <div class="alert alert-warning">Konnte Einstellungen nicht laden.</div>
} else {
    <div class="d-flex justify-content-end mb-2">
        <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@Saving">
            @if (Saving) {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            } else {
                <i class="bi bi-check-circle me-1"></i>
            }
            Speichern
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Ereignis</th>
                    @foreach (var ch in Data.Channels) {
                        <th class="text-center" style="width:120px">
                            @ch.DisplayName
                            @if (!ch.Available && !string.IsNullOrEmpty(ch.UnavailableReason)) {
                                <div class="text-secondary small fw-normal" title="@ch.UnavailableReason">@ch.UnavailableReason</div>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var trigger in Data.Triggers) {
                    <tr>
                        <td>
                            <div class="fw-semibold">@trigger.DisplayName</div>
                            <div class="text-secondary small">@trigger.Description</div>
                        </td>
                        @foreach (var ch in Data.Channels) {
                            var key = (trigger.TriggerId, ch.ChannelId);
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input"
                                       checked="@IsChecked(key)"
                                       disabled="@(!ch.Available)"
                                       @onchange="@(e => OnToggle(key, (bool)e.Value!))" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
