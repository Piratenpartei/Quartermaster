@page "/Sessions"
@using Quartermaster.Api.Users

<PageTitle>Meine Sitzungen</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Meine Sitzungen</h3>
    @if (Sessions != null && Sessions.Count > 1) {
        <button class="btn btn-outline-danger btn-sm" @onclick="RevokeOthers" disabled="@RevokingOthers">
            @if (RevokingOthers) {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            } else {
                <i class="bi bi-box-arrow-right me-1"></i>
            }
            Alle anderen abmelden
        </button>
    }
</div>

<p class="text-secondary">Hier siehst du alle Geräte, auf denen du derzeit angemeldet bist. Du kannst einzelne Sitzungen beenden oder alle anderen außer dieser abmelden.</p>

@if (Loading) {
    <LoadingSpinner />
} else if (Sessions == null || Sessions.Count == 0) {
    <EmptyState>Keine aktiven Sitzungen.</EmptyState>
} else {
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Gerät / Browser</th>
                    <th>IP-Adresse</th>
                    <th>Angemeldet seit</th>
                    <th>Läuft ab</th>
                    <th class="text-end">Aktion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Sessions) {
                    <tr>
                        <td>
                            @if (session.IsCurrent) {
                                <span class="badge bg-primary me-2">Diese Sitzung</span>
                            }
                            <span class="text-secondary">@(string.IsNullOrEmpty(session.IssuedUserAgent) ? "—" : session.IssuedUserAgent)</span>
                        </td>
                        <td><code>@(string.IsNullOrEmpty(session.IssuedIp) ? "—" : session.IssuedIp)</code></td>
                        <td><LocalTime Value="session.IssuedAt" /></td>
                        <td><LocalTime Value="session.ExpiresAt" /></td>
                        <td class="text-end">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => RevokeSession(session))" disabled="@(_revokingId == session.TokenId)">
                                @if (_revokingId == session.TokenId) {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                } else {
                                    <i class="bi bi-box-arrow-right me-1"></i>
                                }
                                Abmelden
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmDialog @ref="ConfirmDialog" />
