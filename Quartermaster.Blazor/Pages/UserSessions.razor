@page "/Sessions"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Users

<PageTitle>@I18n[I18nKey.Ui.UserSessions.PageTitle]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@I18n[I18nKey.Ui.UserSessions.PageTitle]</h3>
    @if (Sessions != null && Sessions.Count > 1) {
        <button class="btn btn-outline-danger btn-sm" @onclick="RevokeOthers" disabled="@RevokingOthers">
            @if (RevokingOthers) {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            } else {
                <i class="bi bi-box-arrow-right me-1"></i>
            }
            @I18n[I18nKey.Ui.UserSessions.LogOutAllOthers]
        </button>
    }
</div>

<p class="text-secondary">@I18n[I18nKey.Ui.UserSessions.Description]</p>

@if (Loading) {
    <LoadingSpinner />
} else if (Sessions == null || Sessions.Count == 0) {
    <EmptyState>@I18n[I18nKey.Ui.UserSessions.NoSessions]</EmptyState>
} else {
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>@I18n[I18nKey.Ui.UserSessions.DeviceBrowserColumn]</th>
                    <th>@I18n[I18nKey.Ui.UserSessions.IpAddressColumn]</th>
                    <th>@I18n[I18nKey.Ui.UserSessions.SignedInSinceColumn]</th>
                    <th>@I18n[I18nKey.Ui.UserSessions.ExpiresColumn]</th>
                    <th class="text-end">@I18n[I18nKey.Ui.UserSessions.ActionColumn]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Sessions) {
                    <tr>
                        <td>
                            @if (session.IsCurrent) {
                                <span class="badge bg-primary me-2">@I18n[I18nKey.Ui.UserSessions.ThisSessionBadge]</span>
                            }
                            <span class="text-secondary">@(string.IsNullOrEmpty(session.IssuedUserAgent) ? "—" : session.IssuedUserAgent)</span>
                        </td>
                        <td><code>@(string.IsNullOrEmpty(session.IssuedIp) ? "—" : session.IssuedIp)</code></td>
                        <td><LocalTime Value="session.IssuedAt" /></td>
                        <td><LocalTime Value="session.ExpiresAt" /></td>
                        <td class="text-end">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => RevokeSession(session))" disabled="@(_revokingId == session.TokenId)">
                                @if (_revokingId == session.TokenId) {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                } else {
                                    <i class="bi bi-box-arrow-right me-1"></i>
                                }
                                @I18n[I18nKey.Ui.UserSessions.SignOutButton]
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmDialog @ref="ConfirmDialog" />
