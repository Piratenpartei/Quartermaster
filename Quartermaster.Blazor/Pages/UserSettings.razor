@page "/Settings"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Users

<PageTitle>@I18n[I18nKey.Ui.UserSettings.PageTitle]</PageTitle>

@if (Loading) {
    <LoadingSpinner />
} else if (Settings == null) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.UserSettings.NotLoggedIn]</div>
} else {
    <h3>@I18n[I18nKey.Ui.UserSettings.MyAccount]</h3>

    <div class="row mb-3">
        <div class="@(Settings.Member != null ? "col-12 col-lg-6 mb-3 mb-lg-0" : "col-12")">
            <div class="card h-100">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.UserSettings.UserDataTitle]</h5>
                    <div class="table-responsive">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr><th style="width:180px">@I18n[I18nKey.Ui.UserSettings.DisplayName]</th><td>@Settings.User.DisplayName</td></tr>
                            <tr><th>@I18n[I18nKey.Ui.UserSettings.Username]</th><td>@(string.IsNullOrEmpty(Settings.User.Username) ? "---" : Settings.User.Username)</td></tr>
                            <tr><th>@I18n[I18nKey.Ui.Common.Email]</th><td>@(string.IsNullOrEmpty(Settings.User.Email) ? "---" : Settings.User.Email)</td></tr>
                            <tr>
                                <th>@I18n[I18nKey.Ui.UserSettings.LoginMethod]</th>
                                <td>
                                    @if (Settings.User.Username == Settings.User.Email) {
                                        <span class="badge bg-primary"><i class="bi bi-shield-lock me-1"></i>@I18n[I18nKey.Ui.UserSettings.LoginMethodSso]</span>
                                    } else {
                                        <span class="badge bg-secondary"><i class="bi bi-person-fill me-1"></i>@I18n[I18nKey.Ui.UserSettings.LoginMethodManual]</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>
        @if (Settings.Member != null) {
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>@I18n[I18nKey.Ui.UserSettings.MembershipTitle]</h5>
                        <div class="table-responsive">
                        <table class="table table-borderless mb-0">
                            <tbody>
                                <tr><th style="width:180px">@I18n[I18nKey.Ui.UserSettings.MemberNumber]</th><td>@Settings.Member.MemberNumber</td></tr>
                                <tr><th>@I18n[I18nKey.Ui.Common.Chapter]</th><td>@(string.IsNullOrEmpty(Settings.Member.ChapterName) ? "---" : Settings.Member.ChapterName)</td></tr>
                                <tr><th>@I18n[I18nKey.Ui.UserSettings.EntryDate]</th><td><LocalTime DateValue="Settings.Member.EntryDate" /></td></tr>
                                <tr><th>@I18n[I18nKey.Ui.UserSettings.MembershipFee]</th><td>@Settings.Member.MembershipFee.ToString("0.00") @I18n[I18nKey.Ui.UserSettings.FeeSuffix]</td></tr>
                                @if (Settings.Member.ReducedFee > 0) {
                                    <tr><th>@I18n[I18nKey.Ui.UserSettings.ReducedFee]</th><td>@Settings.Member.ReducedFee.ToString("0.00") @I18n[I18nKey.Ui.UserSettings.FeeSuffix]</td></tr>
                                }
                                <tr>
                                    <th>@I18n[I18nKey.Ui.UserSettings.VotingRights]</th>
                                    <td>
                                        @if (Settings.Member.HasVotingRights) {
                                            <span class="badge bg-success">@I18n[I18nKey.Ui.Common.Yes]</span>
                                        } else if (Settings.Member.OpenFeeTotal.HasValue && Settings.Member.OpenFeeTotal.Value > 0) {
                                            <span class="badge bg-danger">@I18n[$"{I18nKey.Ui.UserSettings.VotingRightsNoOpenFee}?amount={Settings.Member.OpenFeeTotal.Value.ToString("0.00")}"]</span>
                                        } else {
                                            <span class="badge bg-secondary">@I18n[I18nKey.Ui.Common.No]</span>
                                        }
                                    </td>
                                </tr>
                                @if (Settings.Member.IsPending) {
                                    <tr>
                                        <th>@I18n[I18nKey.Ui.Common.Status]</th>
                                        <td><span class="badge bg-warning text-dark">@I18n[I18nKey.Ui.UserSettings.PendingBadge]</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row mb-3">
        <div class="col-12 col-lg-6 mb-3 mb-lg-0">
            <div class="card h-100">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.UserSettings.GlobalPermissionsTitle]</h5>
                    @if (Settings.GlobalPermissions.Count > 0) {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var perm in Settings.GlobalPermissions) {
                                <span class="badge bg-success" title="@perm.Identifier">@perm.DisplayName</span>
                            }
                        </div>
                    } else {
                        <p class="text-secondary mb-0">@I18n[I18nKey.Ui.UserSettings.NoGlobalPermissions]</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.UserSettings.ChapterPermissionsTitle]</h5>
                    @if (Settings.ChapterPermissions.Count > 0) {
                        @foreach (var chapter in Settings.ChapterPermissions) {
                            <div class="mb-2">
                                <strong>@chapter.ChapterName</strong>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var perm in chapter.Permissions) {
                                        <span class="badge bg-primary" title="@perm.Identifier">@perm.DisplayName</span>
                                    }
                                </div>
                            </div>
                        }
                    } else {
                        <p class="text-secondary mb-0">@I18n[I18nKey.Ui.UserSettings.NoChapterPermissions]</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (IsDebug) {
        <div class="card mt-3">
            <div class="card-body">
                <h5>@I18n[I18nKey.Ui.UserSettings.DevelopmentTitle]</h5>
                <p class="text-secondary small mb-2">@I18n[I18nKey.Ui.UserSettings.DevelopmentNotice]</p>
                <button class="btn btn-sm btn-outline-secondary" @onclick="SeedTestData" disabled="@Seeding">
                    @if (Seeding) {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    <i class="bi bi-database-add"></i> @I18n[I18nKey.Ui.UserSettings.CreateTestData]
                </button>
            </div>
        </div>
    }
}
