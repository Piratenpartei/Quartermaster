@page "/Settings"
@using Quartermaster.Api
@using Quartermaster.Api.I18n
@using Quartermaster.Api.Users

<PageTitle>@I18n[I18nKey.Ui.UserSettings.PageTitle]</PageTitle>

@if (Loading) {
    <LoadingSpinner />
} else if (Settings == null) {
    <div class="alert alert-warning">@I18n[I18nKey.Ui.UserSettings.NotLoggedIn]</div>
} else {
    <PageHeader Title="@I18n[I18nKey.Ui.UserSettings.MyAccount]" />

    <div class="row mb-4">
        <div class="@(Settings.Member != null ? "col-12 col-lg-6 mb-4 mb-lg-0" : "col-12")">
            <div class="card h-100">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.UserSettings.UserDataTitle]</h5>
                    <dl class="row mb-0">
                                <dt class="col-sm-4">@I18n[I18nKey.Ui.UserSettings.DisplayName]</dt>
                                <dd class="col-sm-8">
                                    <div class="mb-1">@Settings.User.DisplayName</div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="displayNameMode" id="displayNameRealName"
                                               checked="@(Settings.DisplayNameMode == DisplayNameMode.RealName)" disabled="@SavingDisplayName"
                                               @onchange="() => ChooseDisplayName(DisplayNameMode.RealName)" />
                                        <label class="form-check-label" for="displayNameRealName">@I18n[I18nKey.Ui.UserSettings.DisplayNameRealName]</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="displayNameMode" id="displayNameUsername"
                                               checked="@(Settings.DisplayNameMode == DisplayNameMode.Username)" disabled="@(SavingDisplayName || !Settings.CanUseUsername)"
                                               @onchange="() => ChooseDisplayName(DisplayNameMode.Username)" />
                                        <label class="form-check-label" for="displayNameUsername">@I18n[I18nKey.Ui.UserSettings.DisplayNameUsername]</label>
                                    </div>
                                    @if (!Settings.CanUseUsername) {
                                        <div class="form-text">@I18n[I18nKey.Ui.UserSettings.DisplayNameUsernamePending]</div>
                                    }
                                    <div class="form-text">@I18n[I18nKey.Ui.UserSettings.DisplayNameHint]</div>
                                </dd>
                            <dt class="col-sm-4">@I18n[I18nKey.Ui.UserSettings.Username]</dt>
                            <dd class="col-sm-8">@(string.IsNullOrEmpty(Settings.User.Username) ? "---" : Settings.User.Username)</dd>
                            <dt class="col-sm-4">@I18n[I18nKey.Ui.Common.Email]</dt>
                            <dd class="col-sm-8">@(string.IsNullOrEmpty(Settings.User.Email) ? "---" : Settings.User.Email)</dd>
                                <dt class="col-sm-4">@I18n[I18nKey.Ui.UserSettings.LoginMethod]</dt>
                                <dd class="col-sm-8">
                                    @if (Settings.IsSsoAccount) {
                                        <span class="badge rounded-pill border bg-info-subtle text-info-emphasis border-info-subtle"><i class="bi bi-shield-lock me-1"></i>@I18n[I18nKey.Ui.UserSettings.LoginMethodSso]</span>
                                    } else {
                                        <span class="badge rounded-pill border bg-secondary-subtle text-secondary-emphasis border-secondary-subtle"><i class="bi bi-person-fill me-1"></i>@I18n[I18nKey.Ui.UserSettings.LoginMethodManual]</span>
                                    }
                                </dd>
                    </dl>
                </div>
            </div>
        </div>
        @if (Settings.Member != null) {
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>@I18n[I18nKey.Ui.UserSettings.MembershipTitle]</h5>
                        <dl class="row mb-0">
                                <dt class="col-sm-4">@I18n[I18nKey.Ui.UserSettings.MemberNumber]</dt>
                                <dd class="col-sm-8">@Settings.Member.MemberNumber</dd>
                                <dt class="col-sm-4">@I18n[I18nKey.Ui.Common.Chapter]</dt>
                                <dd class="col-sm-8">@(string.IsNullOrEmpty(Settings.Member.ChapterName) ? "---" : Settings.Member.ChapterName)</dd>
                                @if (Settings.Member.EntryDate.HasValue) {
                                    <dt class="col-sm-4">@I18n[I18nKey.Ui.UserSettings.EntryDate]</dt>
                                    <dd class="col-sm-8"><LocalTime DateValue="Settings.Member.EntryDate" /></dd>
                                }
                                @if (Settings.Member.MembershipFee > 0) {
                                    <dt class="col-sm-4">@I18n[I18nKey.Ui.UserSettings.MembershipFee]</dt>
                                    <dd class="col-sm-8">@Settings.Member.MembershipFee.ToString("0.00") @I18n[I18nKey.Ui.UserSettings.FeeSuffix]</dd>
                                }
                                @if (Settings.Member.ReducedFee > 0) {
                                    <dt class="col-sm-4">@I18n[I18nKey.Ui.UserSettings.ReducedFee]</dt>
                                    <dd class="col-sm-8">@Settings.Member.ReducedFee.ToString("0.00") @I18n[I18nKey.Ui.UserSettings.FeeSuffix]</dd>
                                }
                                    <dt class="col-sm-4">@I18n[I18nKey.Ui.UserSettings.VotingRights]</dt>
                                    <dd class="col-sm-8">
                                        @if (Settings.Member.HasVotingRights) {
                                            <StatusBadge Tone="StatusTone.Success" Text="@I18n[I18nKey.Ui.Common.Yes]" />
                                        } else if (Settings.Member.OpenFeeTotal.HasValue && Settings.Member.OpenFeeTotal.Value > 0) {
                                            <StatusBadge Tone="StatusTone.Danger" Text="@I18n[$"{I18nKey.Ui.UserSettings.VotingRightsNoOpenFee}?amount={Settings.Member.OpenFeeTotal.Value.ToString("0.00")}"]" />
                                        } else {
                                            <StatusBadge Tone="StatusTone.Neutral" Text="@I18n[I18nKey.Ui.Common.No]" />
                                        }
                                    </dd>
                                @if (Settings.Member.IsPending) {
                                        <dt class="col-sm-4">@I18n[I18nKey.Ui.Common.Status]</dt>
                                        <dd class="col-sm-8"><StatusBadge Tone="StatusTone.Warning" Text="@I18n[I18nKey.Ui.UserSettings.PendingBadge]" /></dd>
                                }
                        </dl>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row mb-4">
        <div class="col-12 col-lg-6 mb-4 mb-lg-0">
            <div class="card h-100">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.UserSettings.GlobalPermissionsTitle]</h5>
                    @if (Settings.GlobalPermissions.Count > 0) {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var perm in Settings.GlobalPermissions) {
                                <span class="badge rounded-pill border bg-success-subtle text-success-emphasis border-success-subtle" title="@perm.Identifier">@perm.DisplayName</span>
                            }
                        </div>
                    } else {
                        <p class="text-secondary mb-0">@I18n[I18nKey.Ui.UserSettings.NoGlobalPermissions]</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5>@I18n[I18nKey.Ui.UserSettings.ChapterPermissionsTitle]</h5>
                    @if (Settings.ChapterPermissions.Count > 0) {
                        @foreach (var chapter in Settings.ChapterPermissions) {
                            <div class="mb-2">
                                <strong>@chapter.ChapterName</strong>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var perm in chapter.Permissions) {
                                        <span class="badge rounded-pill border bg-info-subtle text-info-emphasis border-info-subtle" title="@perm.Identifier">@perm.DisplayName</span>
                                    }
                                </div>
                            </div>
                        }
                    } else {
                        <p class="text-secondary mb-0">@I18n[I18nKey.Ui.UserSettings.NoChapterPermissions]</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (IsDebug) {
        <div class="card mb-4">
            <div class="card-body">
                <h5>@I18n[I18nKey.Ui.UserSettings.DevelopmentTitle]</h5>
                <p class="text-secondary small mb-2">@I18n[I18nKey.Ui.UserSettings.DevelopmentNotice]</p>
                <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary" @onclick="SeedTestData" disabled="@Seeding">
                    @if (Seeding) {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    <i class="bi bi-database-add"></i> @I18n[I18nKey.Ui.UserSettings.CreateTestData]
                </button>
                <button class="btn btn-outline-secondary" @onclick="LinkTestMember" disabled="@Seeding">
                    <i class="bi bi-person-badge"></i> @I18n[I18nKey.Ui.UserSettings.LinkTestMember]
                </button>
                </div>
            </div>
        </div>
    }
}
