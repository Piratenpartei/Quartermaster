@page "/Changelog"
@using Quartermaster.Api.I18n

<PageTitle>@I18n[I18nKey.Ui.VersionHistory.PageTitle]</PageTitle>

<PageHeader Title="@I18n[I18nKey.Ui.VersionHistory.PageTitle]" />

@if (Loading) {
    <LoadingSpinner />
} else if (Entries == null || Entries.Count == 0) {
    <EmptyState Message="@I18n[I18nKey.Ui.VersionHistory.Empty]" />
} else {
    @foreach (var entry in Entries) {
        <section class="version-history-entry mb-5">
            <h2 class="h3 border-bottom pb-2 mb-3">@I18n[$"{I18nKey.Ui.VersionHistory.Version}?version={entry.Version}"]</h2>
            @((MarkupString)entry.Html)
        </section>
    }
}
